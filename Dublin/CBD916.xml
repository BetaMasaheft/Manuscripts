                  <handDesc>
                     <handNote xml:id="h1" script="Ethiopic">
                        <seg type="script" cert="medium">Late eighteenth-century script.</seg>
                        <seg type="ink">Black, red.</seg>
                        <list type="abbreviations">
                           <item>
                              <abbr>ሰ፤ ለ፤ ቅ፤</abbr> for <expan>ሰአሊ፡ ለነ፡ ቅድስት፡</expan></item>
                        </list>
                        <seg type="rubrication">Divine names, chapter numbers, incipits, some
                           punctuation marks, some Ethiopic numerals as well as supplicants’
                           names.</seg>
                        <desc>Regular, neat, careful.</desc>
                     </handNote>
                  </handDesc>
                  <decoDesc>
                     <decoNote xml:id="d1" type="miniature">
                        <locus target="#1r"/>
                        <desc>A miniature depicting the Lord appearing to <persName
                              ref="PRS7181MosesM"/>.</desc></decoNote>
                     <decoNote xml:id="d2" type="miniature">
                        <locus target="#2v"/>
                        <desc>A miniature depicting the <term key="angel">angel</term> expeling Adam
                           and Eve from Eden.</desc></decoNote>
                     <decoNote xml:id="d3" type="miniature">
                        <locus target="#3va"/>
                        <desc>A miniature depicting the Magi adoring <persName ref="PRS5684JesusCh"
                              >Infant Jesus</persName>.</desc></decoNote>

                     <decoNote xml:id="d4" type="miniature">
                        <locus target="#4v"/>
                        <desc>A miniature in two parts. The top one depicts, according to <bibl><ptr
                                 target="bm:Cerulli1965ChesterBeatty"/><citedRange unit="page"
                                 >291–292</citedRange></bibl>, the Lord revealing the Nativity of
                              <persName ref="PRS6819Mary"/> to <persName ref="PRS3417David"/>. The
                           one at the bottom depicts the <ref type="authFile"
                              corresp="AT1031VirginAndChild"/> and <ref type="authFile"
                              corresp="AT1020Massacre"/>. Traces of a <term key="protectiveCurtain"
                           />.</desc></decoNote>

                     <decoNote xml:id="d5" type="miniature">
                        <locus target="#5r"/>
                        <desc>A miniature depicting <persName ref="PRS6819Mary"/> and two <term
                              key="angel">angels</term>. Traces of a <term key="protectiveCurtain"
                           />.</desc></decoNote>
                     <decoNote xml:id="d6" type="miniature">
                        <locus target="#7r"/>
                        <desc>A miniature depicting the <ref type="authFile"
                              corresp="AT1031VirginAndChild"/>, adored by people.</desc></decoNote>
                     <decoNote xml:id="d7" type="miniature">
                        <locus target="#7v"/>
                        <desc>A miniature depicting the <ref type="authFile"
                              corresp="AT1002Annunciation"/>.</desc></decoNote>
                     <decoNote xml:id="d8" type="miniature">
                        <locus target="#8r"/>
                        <desc>A miniature depicting the <ref type="authFile"
                              corresp="AT1031VirginAndChild"/> and an <term key="angel"
                        />.</desc></decoNote>
                     <decoNote xml:id="d9" type="miniature">
                        <locus target="#8va"/>
                        <desc>A miniature depicting the <ref type="authFile"
                              corresp="AT1031VirginAndChild"/>. Infant Jesus is portrayed as a <term
                              key="animal">lamb</term>.</desc></decoNote>
                     <decoNote xml:id="d10" type="miniature">
                        <locus target="#8vb"/>
                        <desc>A miniature depicting the Holy Family.</desc></decoNote>
                     <decoNote xml:id="d11" type="miniature">
                        <locus target="#9r"/>
                        <desc>A miniature depicting Jacob’s ladder.</desc></decoNote>
                     <decoNote xml:id="d12" type="miniature">
                        <locus target="#9r"/>
                        <desc>A miniature of <persName ref="PRS6819Mary"/>.</desc></decoNote>
                     <decoNote xml:id="d13" type="miniature">
                        <locus target="#9vb"/>
                        <desc>A miniature depicting the <ref type="authFile"
                              corresp="AT1031VirginAndChild"/>.</desc></decoNote>
                     <decoNote xml:id="d14" type="miniature">
                        <locus target="#9va"/>
                        <desc>A miniature depicting a Tabernacle.</desc></decoNote>
                     <decoNote xml:id="d15" type="miniature">
                        <locus target="#10r"/>
                        <desc>A miniature depicting <persName ref="PRS6819Mary"/> and the Syrian
                           potter.</desc></decoNote>
                     <decoNote xml:id="d16" type="miniature">
                        <locus target="#10v"/>
                        <desc>A miniature depicting the Syrian potter singing to <persName
                              ref="PRS6819Mary"/>.</desc></decoNote>
                     <decoNote xml:id="d17" type="miniature">
                        <locus target="#11r"/>
                        <desc>A miniature depicting the Syrian potter, the <ref type="authFile"
                              corresp="AT1030Trinity"/> and <persName ref="PRS6819Mary"/>.
                        </desc></decoNote>
                     <decoNote xml:id="d18" type="miniature">
                        <locus target="#11v"/>
                        <desc>A miniature depicting the <ref type="authFile"
                              corresp="AT1031VirginAndChild"/>, adored by people.</desc></decoNote>
                     <decoNote xml:id="d19" type="miniature">
                        <locus target="#12r"/>
                        <desc>A miniature depicting the <ref type="authFile"
                              corresp="AT1031VirginAndChild"/> and the Temple
                        Lampstand.</desc></decoNote>
                     <decoNote xml:id="d20" type="miniature">
                        <locus target="#12vb"/>
                        <desc>A miniature depicting the <ref type="authFile"
                              corresp="AT1031VirginAndChild"/>.</desc></decoNote>
                     <decoNote xml:id="d21" type="miniature">
                        <locus target="#12va"/>
                        <desc>A miniature depicting the <ref type="authFile"
                              corresp="AT1031VirginAndChild"/> and <persName ref="PRS3417David"/>
                           burning incense. Traces of a <term key="protectiveCurtain"
                        />.</desc></decoNote>
                     <decoNote xml:id="d22" type="miniature">
                        <locus target="#14r"/>
                        <desc>A miniature depicting the  <ref type="authFile" corresp="AT1031VirginAndChild"/>,
                           adored by <term key="angel">angels</term>. </desc></decoNote>
                     <decoNote xml:id="d23" type="miniature">
                        <locus target="#13v"/>
                        <desc>A miniature depicting <persName ref="PRS1002Aaron"/> and his
                        rod.</desc></decoNote>
                     <decoNote xml:id="d24" type="miniature">
                        <locus target="#13ra"/>
                        <desc>A miniature depicting a blooming tree and two men, one of whom is
                           probably <persName ref="PRS3417David"/>. The second man is not identified
                           yet.</desc></decoNote>
                     <decoNote xml:id="d25" type="miniature">
                        <locus target="#13rb"/>
                        <desc>A miniature depicting the <ref type="authFile"
                              corresp="AT1031VirginAndChild"/>.</desc></decoNote>
                     <decoNote xml:id="d26" type="miniature">
                        <locus target="#15r"/>
                        <desc>A miniature depicting the Syrian potter dying and <persName ref="PRS6819Mary"/> carrying his
                           soul to Paradise.</desc></decoNote>
                     <decoNote xml:id="d27" type="miniature">
                        <locus target="#15v"/>
                        <desc>A miniature depicting three <term key="bird">birds</term> announcing to <persName
                              ref="PRS3417David">young David</persName> that he will become king. An
                              <term key="angel"/> appears to the King <persName ref="PRS3417David">David</persName>
                              on the throne. <term key="animal">Horses</term> stand in front of the
                           king.</desc></decoNote>
                     <decoNote xml:id="d28" type="miniature">
                        <locus target="#16v"/>
                        <desc>A miniature depicting the Syrian potter singing to <persName ref="PRS6819Mary"/>. Traces of a
                              <term key="protectiveCurtain"/>. </desc></decoNote>
                     <decoNote xml:id="d29" type="miniature">
                        <locus target="#18r"/>
                        <desc>A miniature depicting the <ref type="authFile" corresp="AT1025NativityJesus"
                           />.</desc></decoNote>
                     <decoNote xml:id="d30" type="miniature">
                        <locus target="#18r"/>
                        <desc>A miniature depicting an <term key="angel"/> announcing the birth of Jesus to
                           the shepherds and their <term key="animal"
                        >cattle</term>.</desc></decoNote>
                     <decoNote xml:id="d31" type="miniature">
                        <locus target="#19r"/>
                        <desc>A miniature depicting <persName ref="PRS6819Mary"/> and two <term key="angel"
                              >angels</term>.</desc></decoNote>
                     <decoNote xml:id="d32" type="miniature">
                        <locus target="#19r"/>
                        <desc>A miniature depicting the <ref type="authFile" corresp="AT1066DavidHarp"
                           />.</desc></decoNote>
                     <decoNote xml:id="d33" type="miniature">
                        <locus target="#19v"/>
                        <desc>A miniature in two parts depicting the <ref type="authFile" corresp="AT1031VirginAndChild"/>
                           and an <term key="angel"/> at the top as well as <persName
                              ref="PRS3417David"/> at the bottom. A white cotton <term
                              key="protectiveCurtain"/>, covering both miniatures, is sewn on the top with green and blue
                           threads.</desc></decoNote>
                     <decoNote xml:id="d34" type="miniature">
                        <locus target="#21v"/>
                        <desc>A miniature depicting the <ref type="authFile" corresp="AT1025NativityJesus"
                           /> and the defeat of the Devil.</desc></decoNote>
                  </decoDesc>
