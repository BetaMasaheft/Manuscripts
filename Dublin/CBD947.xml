                  <additions>
                     <list>
                        <item xml:id="a1">
                           <locus from="4v"/>
                           <desc>A monophysite creed.</desc>
                           <q xml:lang="gez">በስሙ፡ አብ፡ ወወልድ፡ ወመንፈስ፡ ቅዱስ፡ አምላክ። ይቤ፡ ምእመን፡ ያዕቆባዊ፡ በዘባቲ፡
                              አሐዩ፡ ወበዘባቲ፡ እመዉት፡ ወበዘባቲ፡ እትነሣእ፡</q>
                        </item>
                        <item xml:id="a2">
                           <locus target="#4r"/>
                           <desc type="MagicText">A magic prayer, almost illegible.</desc>
                        </item>
                        <item xml:id="a3">
                           <locus from="4v"/>
                           <desc>A pamphlet in Amharic written in a hand dating to the <date
                                 notBefore="1800" notAfter="1850">first half of the 19th
                                 century</date>, belonging to an Ethiopian cleric refuting the
                              teaching of Protestant missionaries. The first page is
                              illegible.</desc>
                           <q xml:lang="am">መጀመርያ፡ ክህደቱ፡ መንፈስ፡ ቅዱስ፡ ከአብና፡ ከወልድ፡ ሠረጸ፡ የላል። እኛማ፡ መንፈስ፡
                              ቅዱስ፡ እምእግዚአብሔር፡ አብ፡ <supplied reason="omitted" resp="Cerulli"
                                 >ሠረጸ፡</supplied> እምቅድመ፡ ኩሉ፡ ዓለም፡ እንዳለ፡ ቅዱስ፡ አትናቴዎስ፡ <gap
                                 reason="ellipsis"/> ንስሐ፡ የለም፡ ይላል። ምንም፡ ኃጢአት፡ ሠርቶ፡ ሕማማተ፡ ኢየሱስ፡
                              ክርስቶስ፡ በሐሰቡ፡ እንበለ፡ ቄስ፡ ይሰረይለታል። ዘዓሠርክሙ፡ በምድር፡ ይኩን፡ እሡረ፡ በሰማያት፡
                              ወዘፈታሕክሙ፡ በምድር፡ ይኩን፡ ፍቱሐ፡ <choice>
                                 <sic>በሰማይት፡</sic>
                                 <corr> በሰማያት፡</corr>
                              </choice> የተባሀሉ፡ ቄሳዉስት፡ አትንገሩአቸው፡ ይላል፡ መግባርም፡ አያጸድቅም፡ ይላል። በሃይማኖት፡ በቻ፡
                              መንግሥተ፡ ሰማያት፡ ይገባል፡ ይላል።</q>
                        </item>
