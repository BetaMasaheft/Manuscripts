                        <handDesc>
                            <handNote xml:id="h1" script="Ethiopic">
                                <seg type="ink">Black, red.</seg>
                                <seg type="rubrication">Divine names, incipits, elements of
                                    punctuation marks, Ethiopic numerals and the first owner’s
                                    name.</seg>
                                <desc>Regular, neat, careful, semi-square letters.</desc>
                                <note>The script contains <term key="MagicSymbols"
                                        >charaktêres</term>.</note>
                            </handNote>
                        </handDesc>
                        <decoDesc>
                            <decoNote xml:id="d1" type="miniature">
                                <desc>A picture of a <term key="cross">cross-shaped</term> figure
                                    with a face and four wings, probably a <term key="angel"
                                        >cherub</term>. The image is framed with two ornamental
                                    bands.</desc>
                            </decoNote>
                            <decoNote xml:id="d2" type="miniature">
                                <desc>A picture of a protective <term key="angel">angel</term> with
                                    a <term key="sword"/>. The image is framed with two ornamental
                                    bands.</desc>
                            </decoNote>
                            <decoNote xml:id="d3" type="miniature">
                                <desc>A picture of a <term key="cross">cross-shaped</term> figure
                                    with a face and four wings, probably a <term key="angel"
                                        >cherub</term>.</desc>
                            </decoNote>
                        </decoDesc>
