                        <decoDesc>
                            <decoNote xml:id="d1" type="miniature">
                                <desc>A <term key="MagicDrawing">magic drawing</term> of a <term
                                        key="angel">guardian angel</term> with a <term key="sword"
                                        >sword</term>.</desc>
                            </decoNote>
                            <decoNote xml:id="d2" type="miniature">
                                <desc>A <term key="MagicDrawing">magic drawing</term> of the Net of
                                    Solomon with a <term key="angel">cherub</term> inside it.</desc>
                            </decoNote>
                            <decoNote xml:id="d3" type="miniature">
                                <desc>A <term key="MagicDrawing">magic drawing</term> of a talisman
                                    with a face inside, probably another Net of Solomon.</desc>
                            </decoNote>
                            <decoNote xml:id="d4" type="diagram">
                                <desc>A chart with the same sign, which looks similar to the Arabic
                                    number <foreign xml:lang="ar">٩</foreign>, but with a vertical
                                    serif at the top, written 42 times in black and red.</desc>
                            </decoNote>
                            <decoNote xml:id="d5" type="frame">
                                <desc>The margins of the scroll are painted yellow.</desc>
                            </decoNote>
