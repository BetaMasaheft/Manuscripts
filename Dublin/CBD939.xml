                        <handDesc>
                            <handNote xml:id="h1" script="Ethiopic">
                                <seg type="ink">Black, red.</seg>
                                <seg type="rubrication">Some divine names, incipits, and the name of
                                    owner.</seg>
                                <desc>Regular handwriting, semi-square letters.</desc>
                                <note>The script contains <term key="MagicSymbols"
                                        >charaktêres</term> and the ligature in the word <foreign
                                        xml:lang="gez">እ<hi rend="ligature"
                                    >ግዚ</hi>አብሔር፡</foreign>.</note>
                            </handNote>
