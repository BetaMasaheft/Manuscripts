                  <handDesc>
                     <handNote xml:id="h1" script="Ethiopic">
                        <desc>Neat handwriting; big, angular letters; copied by <persName
                              role="scribe" ref="PRS15520WaldaKidan">Walda Kidān</persName>.</desc>
                     </handNote>
                  </handDesc>
                  <decoDesc>
                     <decoNote xml:id="d1" type="Headband">
                        <locus target="#5r"/>
                        <desc>An ornamental band (ḥarag) with three crosses.</desc>
                     </decoNote>
                     <decoNote xml:id="d2"><locus target="#4v"/>
                        <desc>A miniature of the <ref type="authFile" corresp="AT1031VirginAndChild"
                           /> and two <term key="angel">angels</term>, <persName
                              ref="PRS7049Michael"/> and <persName ref="PRS4377Gabriel"/>. <q
                              xml:lang="gez">ሚካኤል፡ ወጋብርኤል፡ ምስለ፡ ፍቁር፡ ወልድ፡</q></desc></decoNote>
                     <decoNote xml:id="d3"><locus target="#26v"/>
                        <desc>A miniature of a wedding, portraying a bride, a groom, four guests and
                           a musician playing drum. <q xml:lang="gez">ሠርግ፡</q></desc></decoNote>
                     <decoNote xml:id="d4"><locus target="#78r"/>
                        <desc>A miniature of <persName ref="PRS4585Georgeo"/> slaying the dragon. A
                           young girl is staying in the background. <q xml:lang="gez">ቅዱስ፡ ጊዮርጊስ፣
                              ቢሩት፣ ድራጎን፡ ከይሲ።</q></desc></decoNote>
                  </decoDesc>
