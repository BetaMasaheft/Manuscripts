               <history>
                  <origin>
                     <origDate notBefore="1889" notAfter="1913" evidence="reign">The dating is based
                        on the supplication on <locus target="#77v"/> for the King <persName
                           ref="PRS7006Menilek"> Mǝnilǝk II</persName> who reigned from <date
                           when="1889">1899</date> to <date when="1913">1913</date>. Therefore, the
                        manuscript was produced either in the late 18th or in the early 20th
                        century.</origDate>
                  </origin>
                  <provenance>There are supplications for <persName ref="PRS15518GabraIyasus"
                           ><roleName type="title">ʾabuna</roleName> Gabra ʾIyasus</persName> and
                        <persName ref="PRS15519WaldaAmlak">Walda ʾAmlāk</persName> throughout the
                     whole text (e.g., <locus target="#12v #15v"/>). The King <persName
                        ref="PRS7006Menilek"> Mǝnilǝk II</persName> and the scribe <persName
                        role="scribe" ref="PRS15520WaldaKidan">Walda Kidān</persName> are mentioned
                     in a supplication on <locus target="#77v"/>.</provenance>
               </history>
