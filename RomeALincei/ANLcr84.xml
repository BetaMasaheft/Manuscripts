                        <msIdentifier/>
                        <msContents><summary/>
                            <msItem xml:id="p3_i1">
                                <locus from="40r" to="55v"/>
                                <title ref="LIT1450GadlaG"/>
                                <note>The manuscript was not used in the edition by Enrico Cerulli
                                    (<bibl><ptr target="bm:Cerulli1969AlexisT"/></bibl>).</note>
                                <textLang mainLang="gez"/>
                                <incipit xml:lang="gez" type="inscriptio">ገድለ፡ ቅዱስ፡ ገብረ፡ ክርስቶስ።</incipit>
                                <incipit xml:lang="gez">በስመአብ፡ ወወልድ፡ ወመንፈስ፡ ቅዱስ፡ ፩ አምላክ፡ ዝንቱ፡ ዜና፡ ገድለ፡ ኂሩቱ፡ ለቅዱስ፡ ወብፁዕ፡ ብእሴ፡ እግዚአብሔር፡
                                    ዘውእቱ፡ ገብረ፡ ክርስቶስ፡ ወልደ፡ ቴውዶስዮስ፡ ንጉሰ፡ ቈስጥንጥንያ፡ ጸሎቱ፡ ወበረከቱ፡ የሃሉ፡ ምስለ፡ ገብሩ፡ ዘወልደ፡ ማርያም፡ ለአለም፡ አለም፡ አሜን፡ 
                                    ወቴውዶስዮስ፡ መፍቀሬ፡ እግዚአብሔር፡ ውእቱ፡ ወመፍቀሬ፡ እንግዳ፡ ውእቱ፡ ወይገብር፡ ብዙኃ፡ ምጽዋተ፡ 
