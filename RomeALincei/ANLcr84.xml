                    <msPart xml:id="p2">
                        <msIdentifier/>
                        <msContents><summary/>
                            <msItem xml:id="p2_i1">
                                <title ref="LIT1482GadlaM"/><!-- Issue #3378 -->
                                <msItem xml:id="p2_i1.1">
                                    <locus from="20r" to="29v"/>
                                    <title ref="LIT1482GadlaM#Life"/>
                                    <note>Copied from a manuscript, which was kept at the church of Šǝmāgǝlle in Ḥamāsen, as it is indicated in the
                                        inscribed title. The text is printed as a facsimile in and translated to Italian by Paolo Marrassini in
                                        <bibl><ptr target="bm:Marrassini1983Matyas"/></bibl>.</note>
                                    <textLang mainLang="gez"/>
                                    <incipit type="inscriptio" xml:lang="gez"><locus target="#20r"/>ገድለ፡ አባ፡ ማትያስ፡ ዘዓድቄ፡ ዘጽሑፍ፡ በመጽሐፈ፡ ቤተ፡ ክርስቲያን፡ 
                                        ዘሀገረ፡ ሽማግሌ፡ በሐማሴን።</incipit>
                                    <incipit xml:lang="gez"><locus target="#21r"/>በስመ፡ <gap reason="ellipsis"/> ንወጥን፡ በረድኤተ፡ እግዚአብሔር፡ ጽሒፈ፡ ገድሉ፡
                                        ለአቡነ፡ ማትያስ፡ ዘአድቄ፡ ዘአዕረፈ፡ አመ፡ ፳ወ፩ ለግንቦት። በሥምረተ፡ ሥሉስ፡ ቅዱስ፡ እንዘ፡ ፩፫ ወእንዘ፡ ፫፩ እሙንቱ፡ አበ፡ እቄድስ፡ 
                                        ወእሴ<supplied reason="omitted" resp="PRS8999Strelcyn"></supplied>ብሕ። ወእምቅድመ፡ ዓለም፡ ወእስከ፡ ለዓለም፡ መንግሥቱ። 
                                        <gap reason="ellipsis"/><pb n="21v"/><gap reason="ellipsis"/> በስመ፡ <gap reason="ellipsis"/> ወከመዝ፡ ውእቱ፡ ጥንተ፡
                                        ሙላዱ፡ ለአቡነ፡ ማትያስ፡ ወቀዳሜ፡ ስሙ፡ ጥሪተ፡ እግዚእ።</incipit>
                                </msItem> 
                                <msItem xml:id="p2_i1.2">
                                    <locus from="29v" to="33v"/>
                                    <title ref="LIT1482GadlaM#Miracles"/>
                                    <textLang mainLang="gez"/>
                                    <msItem xml:id="p2_i1.2.1">
                                        <locus from="29v"/>
                                        <title ref="LIT1482GadlaM#Healing"/> 
                                        <incipit xml:lang="gez">ተአምሪሁ፡ ለአቡነ፡ ማትያስ፡ <gap reason="ellipsis"/> ወነበረ፡ ፩ ብእሲ፡ ዘስሙ፡ ከንቲባ፡ ተክለ፡ ጽዮን፡ ኀበ፡ አኃቲ፡ ሀገር፡ ዘትሰመይ፡
                                            ፃዕዳ፡ ዘጋ፡ ወነበሩ፡ እንዘ፡ የኃዝኑ፡ በእንተ፡ ዘአልቦሙ፡ ውሉድ። ወመጽአ፡ ምስለ፡ ብእሲቱ<supplied reason="omitted">፡</supplied> አመ፡ ፳ሁ፡ ለግንቦት፡
                                            ወሰአሉ፡ ኀበ፡ እግዝእትነ፡ ማርያም፡</incipit>
                                    </msItem>
                                    <msItem xml:id="p2_i1.2.2">
                                        <locus from="30r"/>
                                        <title ref="LIT1482GadlaM#Water"/> 
                                        <incipit xml:lang="gez">ተአምሪሁ፡ <gap reason="ellipsis"/> ወአሐተ፡ ዕለተ፡ እንዘ፡ ሀሎ፡ በፍኖት፡ ወምስሌሁ፡ 
                                            አባ፡ <choice resp="PRS8999Strelcyn"><sic>ጻ</sic><corr>ጳ</corr></choice>ውሎስ፡ ቀሲስ፡ ወሰልሳዮሙ፡ አባ፡ ገብረ፡ 
                                            ሚካኤል፡ ሀሎ፡ ምስሌሆሙ፡ ወበጽሑ፡ ውስተ፡ ምድር፡ ይቡስ፡ ዘአልቦ፡ ማይ<supplied reason="omitted">፡</supplied> ወሀሎ፡ 
                                            ምስሌሆሙ፡ ፩ ወልድ። ወይቤሎሙ፡ ውእቱ፡ ወልድ፡ አስትዩኒ፡ ማየ፡ ወአውስዓ፡ ውእቱ፡ ቀሲስ፡ ወይቤሎ፡</incipit>
                                    </msItem>
                                    <msItem xml:id="p2_i1.2.3">
                                        <locus from="30v"/>
                                        <title ref="LIT1482GadlaM#Yaqob"/> 
                                        <incipit xml:lang="gez">ተአምሪሁ፡ <gap reason="ellipsis"/> ወሀሎ፡ ፩ መነኮስ፡ ሕሙም፡ ዘስሙ፡ አባ፡ ያዕቆብ፡ 
                                            ወሖረ<supplied reason="omitted">፡</supplied> ኀቤሁ፡ አቡነ፡ ማትያስ፡ ወይቤሎ፡ ምሕረተ፡ እግዚአብሔር፡ ሀሎ፡ ምስሌከ፡ ዳኅንኑ፡ 
                                            እምፃዕረ፡ ሕማምከ፡ ኦወልድየ። ወይቤሎ፡ ውእቱ፡ መነኮስ፡ እወ፡ ዳኅን፡ ኦአቡየ፡ መሐረኒ፡</incipit>
                                    </msItem>
                                    <msItem xml:id="p2_i1.2.4">
                                        <locus from="30v"/>
                                        <title ref="LIT1482GadlaM#FereSannay"/> 
                                        <incipit xml:lang="gez">ተአምሪሁ፡ <gap reason="ellipsis"/> ወሀሎ፡ ፩ ብእሲ፡ ዘያፈቅሮ፡ 
                                            ለ<supplied reason="omitted" resp="PRS8999Strelcyn">አ</supplied>ቡነ፡ ማትያስ፡ ወይትአመን፡ በጸሎቱ። ወረከበ፡ መዓረ፡ 
                                            ወሀለየ፡ በልቡ፡ ወይቤ፡ እሁቦ፡ ለአቡነ፡ ማትያስ፡ ከመ፡ ይባርከኒ፡ ወነሢኦ፡ አተወ፡ ውስተ፡ ቤቱ። ወይቤላ፡ ለብእሲቱ፡ ንሥኢ፡ አንብሪ፡ ዝመዓር፡ ውስተ፡ ሠናይ፡ 
                                            ወትቤሎ<supplied reason="omitted">፡</supplied> ኦሆ፡ ወአንበረት፡ ውስተ፡ ሠናይ።  <gap reason="ellipsis"/> ከመ፡ ይሰቲ፡
                                            ወጥዒሞ፡ ምታ፡ ፍሬ፡ ሠናይ፡</incipit>
                                    </msItem>
                                    <msItem xml:id="p2_i1.2.5">
                                        <locus from="31r"/>
                                        <title ref="LIT1482GadlaM#Agade"/>
                                        <incipit xml:lang="gez">ተአምሪሁ፡ <gap reason="ellipsis"/> ወሀሎ፡ ፩ ብእሲ፡ ስዩመ፡ ሐማሴን፡ ዘስሙ፡ ከንቲባ፡ አስገዴ፡ ወኮነ፡ ጋዕዝ፡
                                            ማዕከሌሁ፡ ወማዕከለ፡ ዛውል። ወፈቀደ፡ ከመ፡ ይማርክ፡ ሰብኦሙ፡ ወእንስሳሆሙ፡ ወጐዩ፡ ሐዲጎሙ፡ ሀገሮሙ፡ ወቦኡ፡ ውስተ፡ ደብር፡ ዘአቡነ፡ ማትያስ፡ 
                                            ወይቤልዎሙ፡ ለመነኮሳት፡</incipit>
                                    </msItem>
                                    <msItem xml:id="p2_i1.2.6">
                                        <locus from="31v"/>
                                        <title ref="LIT1482GadlaM#Drink"/> 
                                        <incipit xml:lang="gez">ተአምሪሁ፡ <gap reason="ellipsis"/> ወአዘዘ፡ አቡነ፡ ማትያስ፡ ከመ፡ ይሑሩ፡ መነኮሳት፡ ኀበ፡ መስቆ፡ መዓር፡ ለትካዘ፡
                                            መነኮሳት፡ ወሖሩ፡ ወበጽሑ፡ በረካ፡ ዘስሙ፡ ደንበላስ። ወሀሎ፡ ፩ መነኮስ፡ ዘኢይጥዕም፡ ዘእንበለ፡ በሰርክ፡ ወይቤልዎ፡ አኃዊሁ፡ መነኮሳት፡ በጊዜ፡ ፱ ሰዓት፡
                                                </incipit>
                                    </msItem>
                                    <msItem xml:id="p2_i1.2.7">
                                        <locus from="31v"/>
                                        <title ref="LIT1482GadlaM#Abdalla"/> 
                                        <incipit xml:lang="gez">ተአምሪሁ፡ <gap reason="ellipsis"/> ወመጽአ፡ አብደላ፡ መልአከ፡ ኃይላ፡ ለጋዕዋ፡ ጸሊማን፡ ሠራዊት፡ ወቍጽራነ፡ 
                                            ገጽ፡ ነሢኦ፡ ወማሕረከ፡ ደብረ፡ አቡነ፡ ማትያስ፡ ዘአድቄ። ወኮነ፡ ሰማዕታት፡ ፲ወ፭ መነኮሳት፡ ወፈነወ፡ እሳት፡ በ፬መአዝኒሃ፡ ለቤተ፡ ክርስቲያን፡ ዘእግዝእትነ፡
                                            ማርያም፡</incipit>
                                    </msItem>
                                    <msItem xml:id="p2_i1.2.8">
                                        <locus from="32r"/>
                                        <title ref="LIT1482GadlaM#Afrang"/> 
                                        <incipit xml:lang="gez">ተአምሪሁ፡ <gap reason="ellipsis"/> ወእምድኅረ፡ ኅዳጥ፡ መዋዕል፡ መጽኡ፡ 
                                            ፳ወ፪ አፍረ<add place="below">ን</add>ጅ፡ እምድባርዋ፡ ምስለ፡ አንስቲያሆሙ፡ ወምስለ፡ <sic>አንስትዮ፡</sic> 
                                            አብቅልት<supplied reason="omitted">፡</supplied> ወአዕዱግ፡ ወቦኡ፡ ውስተ፡ ደብር፡ ዘአባ፡ ማቲያስ፡ ወይቤልዎሙ፡ መነኮሳት፡
                                            ኢትግበሩ፡ ዘንተ፡ ግብር።</incipit>
                                    </msItem>
                                    <msItem xml:id="p2_i1.2.9">
                                        <locus from="32v"/>
                                        <title ref="LIT1482GadlaM#Derbeta"/>
                                        <incipit xml:lang="gez">ተአምሪሁ፡ <gap reason="ellipsis"/> ወመጽኡ፡ ድርቤታ፡ ወማሕረኩ፡ ደብረ፡ አቡነ፡ ማትያስ፡ 
                                            <sic>ዘአይድቄ፡</sic> ወነሥኡ፡ ሲሳዮሙ፡ ለመነኮሳት፡ ወኵሎ፡ አዝፋረ፡ ወቈሳቍሰ፡ ደብር፡ ወቀተሉ፡ ፪ መነኮሳተ፡ እምአዕሩግ። ወሊቆሙ፡ ቦአ፡ 
                                            <sic>ቤውስተ፡</sic> ቤተ፡ ክርስቲያን፡ ዘእግዝእትነ፡ ማርያም፡ ወነሥአ፡ ብዙኃተ፡ ወርእዮ፡ ፩ ወሬዛ፡</incipit>
                                    </msItem>
                                    <msItem xml:id="p2_i1.2.10">
                                        <locus from="32v"/>
                                        <title ref="LIT1482GadlaM#Turks"/>
                                        <incipit xml:lang="gez">ተአምሪሁ፡ <gap reason="ellipsis"/> ወመጽአ፡ ትርኵ፡ ዘስሙ፡ ድሙር፡ በመዋዕለ፡ ሢመቱ፡ 
                                            ለአዛዥ፡<!-- old form of ዥ --> ኩሞ፡ ወገብረ፡ ጸብአ፡ በህሩግ፡ አመ፡ ፳ሁ፡ ለግንቦት፡ በቀዳሚት፡ ሰንበት። ወሞዖ፡ ትርኵ፡ 
                                            ለአዛዥ፡<!-- old form of ዥ --> ኩሞ፡ ወሞተ፡ አዝማች፡ አገባ፡ ወከንቲባ፡ ያዕቆብ፡ ወካልዓን፡ ሠራዊት፡ ዘምድረ፡ ሐማሴን፡</incipit>
                                    </msItem>
                                    <msItem xml:id="p2_i1.2.11">
                                        <locus from="33r"/>
                                        <title ref="LIT1482GadlaM#Axe"/> 
                                        <incipit xml:lang="gez">ተአምሪሁ፡ <gap reason="ellipsis"/> ወሀሎ፡ ፩ ብእሲ፡ በዓለ፡ ምሳር፡ ወሠረቆ፡ ፩ ብእሲ፡ ዘሀሎ፡ በጐረ፡ ቤቱ። 
                                            ወይቤሎ፡ በዓለ፡ ምሳር፡ በእንተ፡ ስሙ፡ ለአቡነ፡ ማትያስ፡ አግብዕ፡ ምሳርየ፡ ወሄደ፡ ወዓውገዞ፡ ፫ ጊዜ። ወካዕበ፡ ይቤሎ፡ በእንተ፡ ስማ፡ ለማርያም፡ 
                                            እግዝ<supplied reason="omitted" resp="PRS8999Strelcyn">እ</supplied>ትነ።</incipit>
                                    </msItem>
                                    <msItem xml:id="p2_i1.2.12">
                                        <locus from="33r"/>
                                        <title ref="LIT1482GadlaM#Abasmanor"/>  
                                        <incipit xml:lang="gez">ተአምሪሁ፡ <gap reason="ellipsis"/> ወሀሎ፡ ፩ አረሚ፡ ዘስሙ፡ አበአስማኖር፡ ዘሤሞ፡ ግራኝ፡ ሥልጣነ፡ ባሕር፡
                                            ወመጽአ፡ ከመ፡ ይማሕርክ፡ ደብረ፡ አቡነ፡ ማትያስ፡</incipit>
                                    </msItem>
                                    <msItem xml:id="p2_i1.2.13">
                                        <locus from="33r"/>
                                        <title ref="LIT1482GadlaM#Woman"/>
                                        <incipit xml:lang="gez">ተአምሪሁ፡ <gap reason="ellipsis"/> ወእንዘ፡ ትወርድ፡ አሐቲ፡ ብእሲት፡ ውስተ፡ ደብሩ፡ 
                                            ለአቡ<supplied reason="omitted" resp="PRS8999Strelcyn">ነ</supplied>፡ ማትያስ፡ ከመ፡ ትብጻሕ፡ ኀበ፡ ፩ መነኮስ፡ አረጋዊ፡
                                            ዘሀለወ፡ ውስተ፡ ደብረ፡ ማርያም፡ ዘአድቄ። ወሶበ፡ ቀርበት፡ ጥቃ፡ ደብረ፡ ማርያም፡ ተራከባ፡ ፩ ብእሲ፡</incipit>
                                    </msItem>
                                </msItem>
                                <msItem xml:id="p2_i1.3">
                                    <locus from="33v" to="35v"/>
                                    <title ref="LIT1482GadlaM#Malke"/>
                                    <note>Written in continuo in the manuscript.</note>
                                    <incipit xml:lang="gez">እመ፡ ጠቢባን፡ ጥበብ፡ እምባሕርየ፡ ጥበብ፡ ዘተወልድኪ። እድግተ፡ በለዓም፡ ቅድመ፡ በከመ፡ አንበብኪ። እስመ፡ በትግሕ፡ 
                                        ወጠንኩ፡ ድርሳነ፡ ማትያስ፡ ገብርኪ። እንዘ፡ ትሠውጢ፡ በላዕሌየ፡ መንፈሰ፡ ዚአኪ። አንብብኒ፡ አንብብኒ<supplied reason="omitted">፡</supplied>
                                        ለበሀም፡ ገብርኪ። ሰላም፡ ለጽንሰትከ፡ ለእግዚአብሔር፡ በሥምረቱ። ወለልደትከ፡ ፀሐይ፡ ዘእምሰማየ፡ አዳም፡ ስርቀቱ። አምኃ፡ ማኅሌት፡ አሀብከ፡ እመዝገበ፡ 
                                        ልብየ፡ ዝንቱ። ሀበኒ፡ ልብ፡ ጥበብ፡ ለዘውገ፡ እንስሳ፡ ስርአቱ። ማትያስ፡ ውሂብ፡ እምረኪብ፡ ውእቱ።</incipit>
                                </msItem>
                                <colophon xml:id="coloph1"><locus target="#35v"/>
                                    According to the colophon, the manuscript was written in <placeName ref="LOC1169AddiLa"/> by the prester 
                                    <persName ref="PRS15521FessehaSey">Fǝśśeḥa Ṣǝyon Habta ʾAb</persName>,
                                    <date when="1914-02-04">4 February 1914</date> during the reign of
                                    <persName ref="wd:Q150642"><roleName type="office">King</roleName> Emmanuel III</persName> and 
                                    under the command of <persName ref="PRS15532Teodorani">
                                        <roleName type="rank">Commissario Commendatore</roleName> Teodorani</persName> and 
                                    <persName ref="PRS15533Caderni"><roleName type="rank">Cavaliere</roleName> 
                                        <roleName type="function">avvocato</roleName> Caderni</persName>. The date is wrongly indicated with
                                    ‘1917’ by Paolo Marrassini 1983, p. 247.<!-- oxygen does not allow bibl in this place -->
                                    <q xml:lang="gez">ይትባረክ፡ እግዚአብሔር፡ ዘአፈጸመኒ፡ በኃይሉ፡ አሜን፡ 
                                        ወአሜ<supplied reason="omitted" resp="PRS8999Strelcyn">ን</supplied>፡ ዝመጽሐፍ፡ ተጽሕፈ፡ በአዲ፡ ላምዛ፡ ጸሀፊሁኒ፡
                                        ቀሲስ፡ ፍሥሐ፡ ጽዮን፡ ኀብተ፡ አብ። በዘመነ፡ ማርቆስ፡ ወንጌላዊ፡ በ፲ወ፱፻፲ወ፬ ዓመተ፡ ክርስቶስ። በመንግሥተ፡ ኢጣልያ፡ ሳልሳይ፡ ሬ፡ አማኑኤል፡ በወርሐ፡ ጥር፡
                                        <sic>ብ፳ን፮፡</sic> <sic>መዓልቲ።</sic> <sic>ብኰመሳርዮ፡</sic> ኩማንዶ፡ ቶሬ፡ ቴዎድራኒ፡ ብከዋሌሬ፡ አበካቶ፡ ካዴርኒ።</q>
                                </colophon>
                            </msItem>
