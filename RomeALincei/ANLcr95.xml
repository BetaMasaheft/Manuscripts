                    <physDesc>
                        <objectDesc form="Codex">
                            <supportDesc>
                                <support>
                                    <material key="parchment"/></support>
                                <extent>
                                    <measure unit="leaf" quantity="148">148</measure>
                                    <dimensions type="outer" unit="mm">
                                        <height unit="mm">Ca. 165</height>
                                        <width unit="mm">Ca. 105</width>
                                    </dimensions>
                                </extent>
                                <collation>The manuscript is composed of 18 quires. One paper bifolium in front (<locus from="1" to="2"/>) and one 
                                    paper bifolium at the end (<locus from="147" to="148"/>) are pasted on the front and back board respectively.
                                    <signatures>The first 15 out of 18 quires are marked with quire marks (<foreign xml:lang="gez">፩</foreign> on 
                                       <locus target="#3r"/> to <foreign xml:lang="gez">፲፭</foreign> on <locus target="#113r"/>).</signatures>
                                </collation>
                                <condition key="good">The spine is damaged. The covers are worm-eaten.</condition>
                            </supportDesc>
                            <layoutDesc>
                                <layout columns="1" writtenLines="25"><locus from="3r" to="130v"/></layout>
                                <layout columns="2" writtenLines="25"><locus from="131r" to="136v"/></layout>
                            </layoutDesc>
                        </objectDesc>
                        <handDesc>
                            <handNote xml:id="h1" script="Ethiopic">
                                <desc>Regular handwriting.</desc>
                                <seg type="ink">Black, red</seg>
                            </handNote>                            
                        </handDesc>
                        <decoDesc>
                            <decoNote xml:id="d1" type="drawing">
                                <locus target="#2v"/>
                                <desc>Graffiti</desc>
                            </decoNote>
                            <decoNote xml:id="d2" type="band">
                                <locus target="#3r #52r #70r #75r #106v #130v"/>
                                <desc>Ornamental bands in black and red.</desc>
                            </decoNote>
                        </decoDesc>
                        <additions>
                            <list>
                                <item xml:id="a1">
                                    <desc type="Comment">The biblical texts in <ref target="#ms_i1.1"/>, <ref target="#ms_i1.2"/> and 
                                        <ref target="#ms_i1.3"/>) are accompanied by interlinear and marginal notes, probably by another hand, 
                                        containing possibly allegoric commentaries.</desc>
                                </item>
                                <item xml:id="a2">
                                    <locus target="#1r"/>
                                    <desc type="GuestText">Five lines of a list of kings, with details of their reigns, at the bottom of the page. The last
                                        name was added by another hand.</desc>
                                    <q xml:lang="gez">አፄ፡ ሶስንዮስ፡ ፳፭፡ <gap reason="ellipsis"/> አፄ፡ ኢዮአስ፡ 
                                        <choice resp="PRS8999Strelcyn"><sic>፳፬፡</sic><corr>፲፬፡</corr></choice></q>
                                </item>
                                <item xml:id="a3">
                                    <locus target="#1v"/>
                                    <desc type="GuestText">Four lines of an illegible text.</desc>
                                </item>
                                <item xml:id="a4">
                                    <locus from="1v" to="2r"/>
                                    <desc type="GuestText">Salām-hymn to Marqilos, patriarch of Antioch.
                                        The ink is partly faded and the writing partly illegible.</desc>
                                    <q xml:lang="gez">ሰላም፡ ለመርቂሎስ፡ ሊቃ፡ ጳጳሳት፡ ዘንጾኪያ፡</q>
                                </item>
                                <item xml:id="a5">
                                    <locus from="146vb"/>
                                    <desc type="MagicText">A magic note at the end of the text in mirror writing.</desc>
                                    <q xml:lang="gez">ዘንተ፡ ዘአንበበ፡ ጠቢብ፡</q>
                                </item>
                                <item xml:id="a6">
                                    <locus target="#147r"/>
                                    <desc type="GuestText">List of the Old and New Testament Books</desc>
                                    <q xml:lang="gez">ዕለታተ፡ ጽሕፈቱኒ፡ ፲ወ፭።</q>
                                </item>
                                <item xml:id="a7">
                                    <locus from="147r"/>
                                    <desc type="MagicText">A magic note in mirror writing at the bottom of the page.</desc>
                                    <q xml:lang="gez">ዘያነብባ፡ ለዛቲ፡ ጠቢብ፡ ውእቱ፡</q>
                                </item>
                                <item xml:id="a8">
                                    <locus from="147r"/>
                                    <desc type="GuestText">Greek text in Ethiopic characters concerning St Michael. On top of the writing, diacritical
                                        signs of the Greek language (e.g. gravis, acut, e.a.) are added. The ink is faded and the text is hardly legible. The note is
                                        written by the same hand as <ref target="#a9"/>.</desc>
                                    <q xml:lang="gez">ሚካኤል፡ አርሀጌሌ፡ ጢክርስቱ፡</q>
                                </item>
                                <item xml:id="a9">
                                    <locus from="147r"/>
                                    <desc type="ScribalSignature">Note which mentions <persName ref="PRS15554MikaelH"/> as the person who 
                                        wrote several notes on <locus target="#147r"/>.</desc>
                                    <q xml:lang="gez">ዘንተ፡ ስ፡ ዘሚካኤል፡ ውእቱ፡ ዘጸሐፍኩ፡ ሚ<add place="above">ካ</add>ኤል፡ <unclear>ሀበሽ።</unclear></q>
                                </item>
                                <item xml:id="a10">
                                    <locus from="148r"/>
                                    <desc type="GuestText">Almost complete effaced text, probably written in Greek letters. In the third line on the right
                                        hand side, one can possibly figure out the year <date when="1680">1680</date>.</desc>
                                </item>
                                <item xml:id="a11">
                                    <locus from="148v"/>
                                    <desc type="GuestText">Beginning of the Ethiopic syllabary in the halaḥama-order 
                                        (<foreign xml:lang="gez">ሀ ለ ሐ መ</foreign>) until the letter <foreign xml:lang="gez">ሰ</foreign>.</desc>
                                </item>                    
                                <item xml:id="e1">
                                    <desc>The text is divided into the days of the week: <locus target="#130vb"/> for Monday; <locus target="#131vb"/>
                                        for Tuesday; <locus target="#133va"/> for Wednesday; <locus target="#135va"/> for Thursday;
                                        <locus target="#137vb"/> for Friday; <locus target="#139rb"/> for Saturday; <locus target="#140rb"/> for Sunday.
                                    </desc>
                                </item>   
                                <item xml:id="e2">
                                    <locus target="#1r"/>
                                    <desc type="StampExlibris">Ex libris of <persName ref="PRS3182ContiRo"/>.</desc>
                                </item>
                            </list>
                        </additions>
