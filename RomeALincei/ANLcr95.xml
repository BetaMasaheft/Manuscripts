                                <decoNote xml:id="b2" type="Cover">Blind-tooled leather</decoNote>
                                <decoNote xml:id="b3" type="bindingMaterial"><material key="wood"/><material key="leather"/></decoNote>
                            </binding>
                        </bindingDesc>
