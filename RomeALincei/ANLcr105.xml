                                    <title ref="LIT7931MGNubia"/>
                                    <incipit xml:lang="gez">ተአምሪሁ፡ <gap reason="ellipsis"/> ዘይትነበብ፡ አመ፡ አሠሩ፡ ወሰዱሱ፡ በ<pb n="12ra"/>ወርኃ፡ ነሐሴ። ወኮነ፡
                                        በሀገረ፡ ኖባ፡ አመ፡ ዕለተ፡ በዓሉ፡ ለቅዱስ፡ ማር፡ ጊዮርጊስ፡ ጸሎቱ፡ ወበረከቱ፡ <gap reason="ellipsis"/>
                                        ወሀለወት<supplied reason="omitted" resp="PRS8999Strelcyn">፡</supplied> አሐቲ፡ ብእሲት፡ ተንበላታዊት፡ እንዘ፡ ትትጌበር፡ ውስተ፡
                                        ማሕረጽ፡ ወይቤልዋ፡ ሰብእ፡ አኮነ፡ ዮም፡ በዓሉ፡ ለቅዱስ፡ ማር፡ ጊዮርጊስ፡</incipit>
                                </msItem>
                                <msItem xml:id="p1_i1.14">
                                    <locus from="13va" to="14va"/>
                                    <title ref="LIT7405MGYohannes"/>
                                    <incipit xml:lang="gez">ተአምሪሁ፡ <gap reason="ellipsis"/> ወሀለወት፡ 
                                        አሐቲ<supplied reason="omitted" resp="PRS8999Strelcyn">፡</supplied> ሀገር፡ እምአህጉራተ፡ ግብፅ፡ ዘትሰመይ፡ ብባ፡ ወሀሎ፡ ፩ ብእሲ፡
                                        ዘስሙ፡ ዮሐንስ፡ ዓቃቤ፡ ቤተ፡ ክርስቲያን፡ ዘቅዱስ፡ ማር፡ ጊዮርጊስ፡ ወበ፩ እመዋዕል፡ ተበዓሰ፡ ምስለ፡ አረ<cb n="13vb"/>ሚ፡ ወጸረፈ፡ ላዕሌሆሙ፡ ወሖሩ፡ እሉ፡
                                        ሰብእ፡ እኩያን፡ ኀበ፡ መኰንን፡</incipit>
                                </msItem>
                                <msItem xml:id="p1_i1.15">
                                    <locus from="14va" to="15vb"/><!-- Issue#3421 -->
                                    <title ref="LIT7926Dinars"/>
                                    <incipit xml:lang="gez">ተአምሪሁ፡ <gap reason="ellipsis"/> ወበይእቲ፡ ሀገር፡ ብባ፡ ወሀሎ፡ ፩ ብእሲ፡ ተንበላታዊ፡ ወፈቀደ፡ ይሑር፡ ለነጊድ፡ ነሢኦ፡
                                        ንዋየ። ወእንዘ፡ የሐውር፡ በፅዓ፡ ብፅዓተ፡ ለቅዱስ፡ ማር፡ ጊዮርጊስ፡ እንዘ፡ ይብል፡</incipit>
                                </msItem>
                                <msItem xml:id="p1_i1.16">
                                    <locus from="15vb" to="17vb"/>
                                    <title ref="LIT7932MGPaganMan"/><!-- Issue#3421 -->
                                    <incipit xml:lang="gez">ተአምሪሁ፡ <gap reason="ellipsis"/><pb n="16ra"/><gap reason="ellipsis"/> 
                                        ወሀሎ<supplied reason="omitted" resp="PRS8999Strelcyn">፡</supplied> ፩ ተንበላታዊ፡ <gap reason="lost"/> ያፈቅር፡ ሕገ፡
                                        ክርስቲያን። <supplied reason="omitted" resp="PRS8999Strelcyn">ወይገብር፡</supplied> በዓሎ፡ ለቅዱስ፡ ማር፡ ጊዮርጊስ፡ በውሂብ፡
                                        መብልዕ፡ ወመስቴ፡ ወሶበ፡ ቀርበ፡ በዓሉ፡ ለቅዱስ፡</incipit>
                                </msItem>
                                <msItem xml:id="p1_i1.17">
                                    <locus from="17vb" to="18rb"/>
                                    <title ref="LIT7406MGBarsuma"/>
                                    <incipit xml:lang="gez">ተአምሪሁ፡ <gap reason="ellipsis"/> ወበ፩ እመዋዕል፡ እንዘ፡ ሀለው፡ 
                                        ብዙኃን<supplied reason="omitted" resp="PRS8999Strelcyn">፡</supplied> ሕዝብ፡ ከልሐ፡ አቡነ፡ አባ፡ በርሶማ፡ በዓቢይ፡ ቃል። ወይቤ፡ 
                                        ኦሰማዕቱ፡ ለእግዚአብሔር፡ ቅዱስ፡ ማር፡ ጊዮርጊስ፡ ሑር፡ ኀቤሁ፡ ወአድኅኖ፡ ወዝንተ፡ ይቤ፡ 
                                        ብዙኃ<supplied reason="omitted" resp="PRS8999Strelcyn">፡</supplied> ጊዜ።</incipit>
                                </msItem>
                                <msItem xml:id="p1_i1.18">
                                    <locus from="18rb" to="19vb"/>
                                    <title ref="LIT7407MGSaving"/>
                                    <incipit xml:lang="gez">ተአምሪሁ፡ <gap reason="ellipsis"/> ወኮነ፡ 
                                        በአሐቲ<supplied reason="omitted" resp="PRS8999Strelcyn">፡</supplied> እመዋዕል፡ እንዘ፡ ሀለዉ፡ ጉባዔ፡ ሕዝብ፡ መሢሐውያን፡
                                        ምስለ፡ አባ፡ በርሶማ፡ ዕሩቅ። ወተንሥአ፡ ፍጡነ፡ ይእተ፡ ጊዜ፡ እንዘ፡ ይኬልሕ፡ በልዑል፡ ቃል። ወይቤ፡</incipit>
                                </msItem>
                                <msItem xml:id="p1_i1.19">
                                    <locus from="19vb" to="20ra"/>
                                    <title ref="LIT7408MGWidow"/>
                                    <incipit xml:lang="gez">ተአምሪሁ፡ <gap reason="ellipsis"/> ወሀለወት፡ አሐቲ፡ መበለት፡ ዘትነብር፡ ጎረ፡ ቤተ፡ ክርስቲያኑ፡ ለቅዱስ፡ ማር፡ 
                                        ጊዮርጊስ<supplied reason="omitted" resp="PRS8999Strelcyn">፡</supplied> ወመሠጠ፡ አንቄ፡ ዶርሆሃ፡ ለይእቲ፡ መበለት።</incipit>
                                </msItem>
                                <msItem xml:id="p1_i1.20">
                                    <locus from="20ra" to="20va"/>
                                    <title ref="LIT6268MGChurchDoor2"/>
                                    <incipit xml:lang="gez">ተአምሪሁ፡ <gap reason="ellipsis"/> ወሀሎ፡ ፩ ኤጲስቆጶስ፡ በይእቲ፡ ሀገር፡ ዘኮነ፡ ቤቱ፡ ኀበ፡ ዴዴ፡ ቤተ፡ ክርስቲያነ፡ 
                                        በዛቲ<supplied reason="omitted" resp="PRS8999Strelcyn">፡</supplied> መርጡል። ወበአሐቲ፡ ዕለት፡ ረሥዑ፡ ላዕካኒሁ፡ ከመ፡ 
                                        ይዕፅው<supplied reason="omitted" resp="PRS8999Strelcyn">፡</supplied> ኀዋኅወ፡ ቤተ፡ ክርስቲያኑ፡ 
                                        በጊዜ<supplied reason="omitted" resp="PRS8999Strelcyn">፡</supplied><cb n="20rb"/> ምሴት፡ ወኖሙ፡</incipit>
                                </msItem>
                                <msItem xml:id="p1_i1.21">
                                    <locus from="20va" to="22ra"/>
                                    <title ref="LIT6629MGHealing"/>
                                    <incipit xml:lang="gez">ተአምሪሁ፡ <gap reason="ellipsis"/> ወሀለወት፡ አሐቲ፡ ብእሲት፡ አይሁዳዊት፡ በፍቅሩ፡ ለጊዮርጊስ፡ 
                                        ዘተአመነት<supplied reason="omitted" resp="PRS8999Strelcyn">፡</supplied> ወይእቲሰ፡ እምአዋልደ፡ እስራኤል፡ ወዓቢይ፡ ፍጥረታ፡
                                        በውስተ፡ ሕዝብ፡</incipit>
                                </msItem>
                                <msItem xml:id="p1_i1.22">
