                        <msContents>
                            <summary>Miracles of St George</summary>
                            <msItem xml:id="p1_i1">
                                <locus from="1ra" to="24ra"/>
                                <title ref="LIT4006Taamme"/>
                                <note>22 miracles are attested in this witness. The beginning is missing.</note>
                                <textLang xml:lang="gez"/>
                                <msItem xml:id="p1_i1.1">
                                    <locus from="1ra" to="3ra"/>
                                    <title>Fragment of an unidentified miracle</title><!-- Issue#3421 -->
                                    <note>The text starts ex abrupto.</note>
                                    <incipit xml:lang="gez"><gap reason="lost"/>ብር፡ ወበፍርሃት፡ ብዙኅ፡ ወእምኑ፡ ኵሎሙ፡ እለ፡ ርእዩ፡ ኃይሎ፡ ወጽንዖ፡ ለቅዱስ፡ ማር፡ ጊዮርጊስ፡
                                    </incipit>
                                    <explicit xml:lang="gez">ኦዘአግባዕኮ፡ መንገለ፡ ብሔሩ፡ ፍጡነ። ለዘተፄወወ፡ ዲያቆን፡ እስመ፡ ኪያ<pb n="3ra"/>ከ፡ ተአመነ። ጊዮርጊስ፡ ወይን፡
                                        ዘተረሥዕ፡ ኀዘነ። ሚጠነ፡ በረድኤትከ፡ እምተፄውዎ፡ ነፍስ፡ ለነ። ወአቁመነ፡ ምስሌከ፡ የማነ።</explicit>
                                </msItem>
                                <msItem xml:id="p1_i1.2">
                                    <locus from="3ra" to="3va"/>
                                    <title ref="LIT7373MGRooster"/>
                                    <incipit xml:lang="gez">ተአምሪሁ፡ ለቅዱስ፡ ማር፡ ጊዮርጊስ<supplied reason="omitted">፡</supplied> <gap reason="ellipsis"/>
                                        ወሀለወት፡ አሐቲ፡ ብእሲት፡ ነዳዪት፡ ወበፅዓት<supplied reason="omitted">፡</supplied> ለቤተ፡ ክርስቲያኑ፡ ለቅዱስ፡ ማር፡ ጊዮርጊስ፡ ከመ፡ ተሀብ፡
                                        ዶርሆ<supplied reason="omitted">፡</supplied> ወወሀበት፡ ልዑለ፡ ዶርሆሃ፡ ወሶበ፡ አፍቀረት፡ ለውእቱ፡ 
                                        ዶርሆ<supplied reason="omitted">፡</supplied></incipit>
                                </msItem>
                                <msItem xml:id="p1_i1.3">
                                    <locus from="3va" to="4va"/>
                                    <title ref="LIT7391MGEquestrian"/>
                                    <incipit xml:lang="gez">ተአምሪሁ፡ <gap reason="ellipsis"/> ተብህለ፡ በ፩ እመዋዕል፡ ተአደሙ፡ ምስሌሁ፡ ለቅዱስ፡ ማር፡ ጊዮርጊስ፡ ቅዱስ፡ 
                                        ቴዎድሮስ፡ ቅዱስ፡ ቢስዶራ፡ <surplus>ቅዱስ፡</surplus> ዲላዲስ፡ <add place="below">ቅዱስ፡ አክሎግ፡</add> ቅዱስ፡ መርምህናም፡ ቅዱስ፡
                                        ፊለታዎስ፡ ቅዱስ፡ ፊቅጦር፡ ቅዱስ፡ ገላውዴዎስ፡ ቅዱስ፡ ሚናስ፡ ቅዱስ፡ ፋሲለደስ፡ ቅዱስ፡ ኖብ፡ ቅዱስ፡ ቆዝሞስ፡ ቅዱስ፡ ቂርቆስ። ወካልዓንሂ፡ ክቡራን፡ ሰማዕታት፡
                                    </incipit>
                                </msItem>
                                <msItem xml:id="p1_i1.4">
                                    <locus from="4va" to="5ra"/>
                                    <title ref="LIT7392MGLamb"/>
                                    <incipit xml:lang="gez">ተአምሪሁ፡ <gap reason="ellipsis"/><cb n="4vb"/><gap reason="ellipsis"/> 
                                        ወሀለወት<supplied reason="omitted">፡</supplied> አሐቲ፡ ቤተ፡ ክርስቲያን፡ ሕንጽት፡ በስሙ፡ ለቅዱስ፡ ማር፡ ጊዮርጊስ፡ 
                                        <supplied reason="omitted">ወ</supplied>ውስተ፡ ይእቲ፡ ቤተ፡ ክርስቲያን፡ ሀሎ፡ ፩ በግዕ፡ መባዓ፡ ቤተ፡ ክርስቲያን። ወበአሐቲ፡
                                        እምለያልይ፡ መጽአ፡ ዝዕብ፡ ወመሠጦ፡ ለውእቱ፡ በግዕ፡</incipit>
                                </msItem>
                                <msItem xml:id="p1_i1.5">
                                    <locus from="5ra" to="6ra"/>
                                    <title ref="LIT7397MGMuslim"/>
                                    <incipit xml:lang="gez">ተአምሪሁ፡ <gap reason="ellipsis"/><cb n="5rb"/><gap reason="ellipsis"/>
                                        ዝንቱ፡ <gap reason="lost"/> ዘይትነበብ፡ በወርኃ፡ መር<gap reason="lost"/> ዘውእቱ፡ ሚያዝያ፡ አመ፡ ፳ወ<gap reason="lost"/>ሉሱ፡
                                        ዕለት። ወኮነ፡ በሀገረ፡ ልዳ፡ <gap reason="lost"/>መ፡ ዕለተ፡ በዓሉ፡ ለቅዱስ፡ ማር፡ ጊዮርጊስ፡ ወሀለወት፡ አሐቲ፡ ሀገር፡ በደወለ፡ ሰንደፋ፡ ዘትሰመይ፡ ዝምያና፡
                                        ወህየ፡ <supplied reason="omitted">ሀለወት፡</supplied> ቤተ፡ ክርስቲያኑ፡ ለቅዱስ፡ ማር፡ ጊዮርጊስ፡</incipit>
                                </msItem>
                                <msItem xml:id="p1_i1.6">
                                    <locus from="6ra" to="7ra"/>
                                    <title ref="LIT7398MGGovernor"/>
                                    <incipit xml:lang="gez">ተአምሪሁ፡ <gap reason="ellipsis"/> ወሀለወት፡ አሐቲ፡ ሀገር፡ 
                                        እምአህጉረ<supplied reason="omitted">፡</supplied> ምሥር፡ እንተ፡ ትሰመይ፡ ንስሕና፡ ወሕንጽት፡ ውስቴታ፡ ቤተ፡ ክርስቲያኑ፡ ለቅዱስ፡ ማር፡ ጊዮርጊስ፡
                                        በማዕከለ፡ ገራህት፡ ወበልየ፡ ሕንጸታ፡ ወመኰንና፡ ለይእቲ፡ ሀገር፡ <supplied reason="omitted" resp="PRS8999Strelcyn">ተንባላ</supplied>ታይ፡ 
                                        ውእቱ፡</incipit>
                                </msItem>
                                <msItem xml:id="p1_i1.7">
                                    <locus from="6ra" to="7ra"/>
                                    <title ref="LIT7399MGResuscitation"/>
                                    <incipit xml:lang="gez">ተአምሪሁ፡ <gap reason="ellipsis"/><cb n="6rb"/><gap reason="ellipsis"/> ወበ፩ 
                                        እመ<supplied reason="omitted" resp="PRS8999Strelcyn">ዋዕል፡</supplied> ቀተልዎ፡ መሠርያን፡ 
                                        ለወል<supplied reason="omitted" resp="PRS8999Strelcyn">ደ፡ አ</supplied>ሐቲ፡ ብእሲት፡ መሃይምንት።</incipit>
                                </msItem>
                                <msItem xml:id="p1_i1.8">
                                    <locus from="7vb" to="8vb"/>
                                    <title ref="LIT7400MGHealing"/>
                                    <incipit xml:lang="gez">ተአምሪሁ፡ <gap reason="ellipsis"/> ወሀሎ፡ ፩ መፃጕዕ፡ 
                                        ዘደወየ<supplied reason="omitted" resp="PRS8999Strelcyn">፡</supplied> እምንዕሱ፡ ወኢይክል፡ ሐዊረ፡ በእገሪሁ፡ 
                                        <sic>ወፀዓኑ፡</sic> አዝማዲሁ፡ ዲበ፡ አድግ።</incipit>
                                </msItem>
                                <msItem xml:id="p1_i1.9">
                                    <locus from="8vb" to="9va"/>
                                    <title ref="LIT7401MGHouse"/>
                                    <incipit xml:lang="gez">ተአምሪሁ፡ <gap reason="ellipsis"/> ወሀሎ፡ ፩ ብእሲ፡ ዘስሙ፡ ጊዮርጊስ፡ ወይገብር፡ በዓሎ፡ ለቅዱስ፡ ማር፡ 
                                        ጊዮርጊስ<supplied reason="omitted" resp="PRS8999Strelcyn">፡</supplied><pb n="9ra"/> ወበ፩ እመዋዕል፡ 
                                        ተሣ<add place="below">የ</add>ጠ፡ ቤተ<supplied reason="omitted" resp="PRS8999Strelcyn">፡</supplied>
                                        እም፩ ብእሲ። ወውእቱሰ፡ ብእሲ፡ ሠያጤ፡ ቤት፡ ዐበዮ፡ ውሂበ፡ ቤት፡ ተመጢዎ፡ ንዋየ፡ ሤጠ፡ ቤት። ወሶበ፡ ይቤሎ፡ ሀበኒ፡ ቤተ፡ ዘተሣየጥኪከ፡ መከረ፡ ላዕሌሁ፡
                                        ነገረ፡ ሐሰት፡</incipit>
                                </msItem>
                                <msItem xml:id="p1_i1.10">
                                    <locus from="9va" to="10ra"/>
                                    <title ref="LIT7402MGDemon"/>
                                    <incipit xml:lang="gez">ተአምሪሁ፡ <gap reason="ellipsis"/> ወኮነ፡ በ፩ እመ<cb n="9vb"/>ዋዕል፡ ተሠርቀ፡ ንዋየ፡ ፩ ብእሲ፡ ወአኀዞ፡
                                        ለሠራቂሁ፡ ወይቤሎ፡ አንተ፡ ሠራቀ፡ ንዋይየ፡ ወክህደ፡ ወይቤ፡ ኢሠረቁ።</incipit>
                                </msItem>
                                <msItem xml:id="p1_i1.11">
