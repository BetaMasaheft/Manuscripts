                        <msIdentifier/>
                        <msContents>
                            <summary>Commemorations to St John the Baptist; Homilies by St John Chrysostom; Malkǝʾa Yoḥannǝs</summary>
                            <msItem xml:id="p2_i1">
                                <locus from="26ra" to="37ra"/>
                                <title>Commemorations related to St John the Baptist</title><!-- Issue #3424 -->
                                <note>According to <bibl><ptr target="bm:Strelcyn1976Catalogue"/><citedRange unit="item">105</citedRange>
                                    <citedRange unit="page">268</citedRange></bibl>, the texts, which are related to
                                    <persName ref="PRS5741Johnthe"/>, are taken from the <ref type="work" corresp="LIT2375Synaxa"/>. Since each 
                                    commemorative note is followed by a salām-hymn, it is likely that they are taken from the
                                    <ref type="work" corresp="LIT4035SenkessarDL">Dabra Libānos recension</ref>.</note>
                                <textLang xml:lang="gez"/>
                                <msItem xml:id="p2_i1.1">
                                    <locus from="26ra" to="28v"/>
                                    <title>Reading for the eighth of Maskaram</title>
                                    <msItem xml:id="p2_i1.1.1">
                                        <locus from="26ra" to="28"/><!-- = LIT4035SenkessarDL in ESdd017, fol. 9vc -->
                                        <title>Commemorative note on Zechariah, the father of John the Baptist</title><!-- Not in Bm as indiviual record; issue needed -->
                                        <incipit xml:lang="gez">በስመ፡ <gap reason="ellipsis"/> ኣመ፡ ሰሙኑ፡ ለመስከረም፡ በዛቲ፡ ዕለት፡ ካነ፡ ቅዱስ፡ 
                                            <persName ref="PRS10509Zachary">ዘካርያስ፡</persName> ካህን፡ ወልደ፡ በራክዩ፡ ሰማዕተ፡ 
                                            በእዴሁ<supplied reason="omitted" resp="PRS8999Strelcyn">፡</supplied> ለሄሮድስ፡ ንጉሥ።</incipit>
                                    </msItem>
                                    <msItem xml:id="p2_i1.1.2">
                                        <locus target="#28va"/>
                                        <title>Salām-hymn to Zechariah</title><!-- Not in Bm; issue needed -->
                                        <incipit xml:lang="gez">ሰላም፡ እብል፡ ለ<persName ref="PRS10509Zachary">ዘካርያስ፡</persName> ካህን፡</incipit>
                                    </msItem>
                                </msItem>
                                <msItem xml:id="p2_i1.2">
                                    <locus from="29va" to="30ra"/>
                                    <title>Reading for the third of Ṭǝrr</title><!-- Not in ESdd017 on fols. 122rc-124r -->
                                    <msItem xml:id="p2_i1.2.1">
                                        <locus from="29va" to="29vb"/>
                                        <title>Commemorative note on the conception of John the Baptist by Elisabeth</title><!-- Not in Bm; issue needed -->
                                        <incipit xml:lang="gez">በስመ፡ <gap reason="ellipsis"/> ኣመ፡ ሠሉሱ፡ ለጥር፡ በዛቲ፡ ዕለት፡ ኮነ፡ ፅንሰታ፡ 
                                            ለኤልሣቤጥ<supplied reason="omitted" resp="PRS8999Strelcyn">፡</supplied> እመ፡ ዮሐንስ፡ 
                                            መጥምቅ<supplied reason="omitted" resp="PRS8999Strelcyn">፡</supplied> ወልደታኒ፡ አመ፡ እስራ፡ ወሰቡዑ፡ ለመስከረም፡
                                            እምሶፍያ።</incipit>
                                    </msItem>
                                    <msItem xml:id="p2_i1.2.2">
                                        <locus from="29vb" to="30ra"/>
                                        <title>Salām-hymn to the mother of John</title><!-- Not in Bm; not in ESdd017 on fol. 4-5 issue needed -->
                                        <incipit xml:lang="gez">ሰላም፡ ለእመ፡ ዮሐንስ፡ ከመ፡ ይፈጽም፡ ሥምረታ።</incipit>
                                    </msItem>
                                </msItem>
                                <msItem xml:id="p2_i1.3">
                                    <locus from="30ra" to="32ra"/>
                                    <title>Reading for the 16th of Yakkātit</title>
                                    <msItem xml:id="p2_i1.3.1">
                                        <locus from="30ra" to="31vb"/>
                                        <title>Commemorative note on the death of Elisabeth</title><!-- Not in Bm; issue needed -->
                                        <incipit xml:lang="gez">በስመ፡ <gap reason="ellipsis"/> ኣመ፡ ኣሡሩ፡ ወሰዱሱ፡ ለየካቲት፡ በዛቲ፡ ዕለት፡ አዕረፈት፡ ቅድስት፡ ወጸድቅት፡ 
                                            <cb n="32rb"/> ኤልሣቤጥ፡ እሙ፡ ለዮ<supplied reason="omitted" resp="PRS8999Strelcyn">ሐን</supplied>ስ፡ መጥምቅ።
                                        </incipit><!-- Same text in ESdd017 on fol. 174vb -->
                                    </msItem>
                                    <msItem xml:id="p2_i1.3.2">
                                        <locus from="31vb" to="32ra"/>
                                        <title>Salām-hymn to Elisabeth</title><!-- Not in Bm; issue needed -->
                                        <incipit xml:lang="gez">ሰላም፡ ለኤልሣቤጥ፡ እንተ፡ ወደሳ፡ ወአልዓላ።</incipit>
                                    </msItem><!-- Same text in ESdd017 on fol. 175vb -->
                                </msItem>
                                <msItem xml:id="p2_i1.4">
                                    <locus from="32rb" to="34rb"/>
                                    <title>Reading for the 26th of Maskaram</title>
                                    <msItem xml:id="p2_i1.4.1">
                                        <locus from="32rb" to="34ra"/><!-- = LIT1284Dersan#AppearanceZechariah in BAVet149#p1_i1.10.3 -->
                                        <title>Commemorative note on St Gabriel’s appearance to Zechariah</title><!-- ESdd017 fol. 27rc -->
                                        <incipit xml:lang="gez">በስመ፡ <gap reason="ellipsis"/> ኣመ፡ እስራ፡ ወሰዱሱ፡ ለመስከረም፡ በዛቲ፡ ዕለት፡ ፈንዎ፡ 
                                            እግዚኣብሔር<supplied reason="omitted" resp="PRS8999Strelcyn">፡</supplied> ለገብርኤል፡ መልኣክ፡ ኀበ፡ ዘካርያስ፡ ወልደ፡
                                            በራክዩ፡ ወዜነዎ፡ በእንተ፡ ዮሐንስ፡ መጥምቅ፡</incipit>
                                    </msItem>
                                    <msItem xml:id="p2_i1.4.2">
                                        <locus from="34ra" to="34rb"/>
                                        <title ref="LIT7735SalamJohn"/>
                                        <incipit xml:lang="gez">ሰላም፡ ለፅንሰትከ፡ በሰሌዳ፡ ከርሣ፡ ዘተገልፈ።</incipit>
                                    </msItem>
                                </msItem>
                                <msItem xml:id="p2_i1.5">
                                    <locus from="34rb" to="34vb"/>
                                    <title>Reading for the first of Ṗagʷǝmen</title>
                                    <msItem xml:id="p2_i1.5.1">
                                        <locus from="34rb" to="34va"/>
                                        <title>Commemorative note on the arrest of St John the Baptist</title><!-- Not in Bm; issue needed -->
                                        <incipit xml:lang="gez">በስመ፡ <gap reason="ellipsis"/> ኣመ፡ ኣሚሩ፡ ለጳጕሜ፡ በዛቲ፡ ዕለት፡ ኮነ፡ ሙቃሔሁ፡ ለዮሐንስ፡ መጥምቅ፡ በትእዛዘ፡ 
                                            ሄሮድስ፡ ንጉሥ።</incipit>
                                    </msItem>
                                    <msItem xml:id="p2_i1.5.2">
                                        <locus from="34va" to="34vb"/>
                                        <title>Salām la-muqāḥeka</title><!-- Not in Bm; issue needed -->
                                        <incipit xml:lang="gez">ሰላም፡ ለሙቃሔከ፡ በዕለት፡ ዝንቱ፡</incipit>
                                    </msItem>
                                </msItem>
                                <msItem xml:id="p2_i1.6">
                                    <locus from="34vb" to="37ra"/>
                                    <title>Reading for the second of Maskaram</title>
                                    <msItem xml:id="p2_i1.6.1">
                                        <locus from="34vb" to="36rb"/><!-- Same text in ESdd017 on fol. 4ra -->
                                        <title>Commemorative note on the beheading of St John the Baptist</title><!-- Not found in Bm, but incipit is fairly short; issue needed -->
                                        <incipit xml:lang="gez">በስመ፡ <gap reason="ellipsis"/> ኣመ፡ ሰኑዩ፡ ለመስከረም፡ በዛቲ፡ ዕለት፡ ኮነ፡ ቅዱስ፡ ዮሐንስ፡ 
                                            መጥምቅ<supplied reason="omitted" resp="PRS8999Strelcyn">፡</supplied> ወሰማዕት፡ ወልደ፡ ዘካርያስ፡ ካህን፡</incipit>
                                    </msItem>
                                    <msItem xml:id="p2_i1.6.2">
                                        <locus from="36rb" to="37ra"/>
                                        <title>Salām ʾǝbl ba-qāla sǝbḥat wa-zǝmāre</title>
                                        <incipit xml:lang="gez">ሰላም፡ እብል፡ በቃለ፡ ስብሐት፡ ወዝማሬ።</incipit>
                                    </msItem>    
                                </msItem>
                                <msItem xml:id="p2_i1.7">
                                    <locus from="37vb" to="41ra"/>
                                    <title>Reading for the thirtieth of Yakkātit</title>
                                    <note>Indicated as homilies in <bibl><ptr target="bm:Strelcyn1976Catalogue"/>
                                        <citedRange unit="item">105, III</citedRange><citedRange unit="page">268–269</citedRange></bibl>,
                                        but according to information from Augustine Dickinson, a commemorative note on the beheading of St John the Baptist
                                        for the thirtieth of Yakkātit.</note><!-- Issue #3428 -->
                                    <incipit xml:lang="gez">በስመ፡ <gap reason="ellipsis"/> ንወጥን፡ በረድኤተ፡ እግዚኣብሔር፡ ዜና፡ ተኣምሪሁ፡ ወርክበተ፡ ርእሱ፡ ለብፁዕ፡ ውለቅዱስ፡
                                        ዮሐንስ፡ መጥምቅ፡ ነቢይ፡ ወዓቢይ፡ ወንጌላዊ፡ <gap reason="ellipsis"/> ወካዕበ፡ ይቤ፡ ዮሐንስ፡ ኣፈ፡ ወርቅ፡ ካልአ፡ ነገረ፡ እምዝንቱ፡ ወውእቱሰ፡ 
                                        እስመ<supplied reason="omitted">፡</supplied> ሄሮድስ፡ ከሓዲ፡ ሶበ፡ አዘዘ<supplied reason="omitted">፡</supplied> ከመ፡ 
                                        ይምትሩ፡ ርእሶ፡ ለቅዱስ፡ ዮሐንስ፡ መጥምቅ።</incipit>
                                </msItem>
                            </msItem>
                            <msItem xml:id="p2_i2">
                                <locus from="41ra" to="72ra"/>
                                <title>Homilies for St John the Baptist by John Chrysostom</title>
                                <msItem xml:id="p2_i2.1">
                                    <locus from="41ra" to="59ra"/>
                                    <title ref="LIT2085OntheL"/>
                                    <incipit xml:lang="gez">በስመ፡ <gap reason="ellipsis"/> ዝንቱ፡ ነገር፡ ዘከመ፡ ኮነ፡ ሕይወቱ፡ <gap reason="lost"/> ወለቅዱስ፡
                                        <gap reason="lost"/> ክርስትና፡ መትምቅ፡ ወነቢይ፡ ወከመ፡ ም<gap reason="lost"/>፡ ኮነ፡ ምትረተ፡ ርእሱ፡</incipit>
                                </msItem>
                                <msItem xml:id="p2_i2.2">
                                    <locus from="59ra" to="72ra"/>
                                    <title ref="LIT2125OntheG"/>
                                    <incipit xml:lang="gez">በስመ፡ <gap reason="ellipsis"/> ድርሳን፡ ዘደረሰ፡ ዮሐንስ፡ ኣፈ፡ ወርቅ፡ ሊቀ፡ ጳጳሳት፡ ዘሃገረ፡ ቍስጥንጥንያ፡ በእንተ፡ 
                                        ክብሩ፡ ለዮሐንስ፡ መጥምቅ፡</incipit>
                                </msItem>
                            </msItem>
                            <msItem xml:id="p2_i3">
                                <locus from="71rb" to="75rb"/>
                                <title ref="LIT2999RepCh279"/>
                                <note>Referred to <bibl><ptr target="bm:Chaine1913Rep"/><citedRange unit="item">227</citedRange></bibl>
                                    in <bibl><ptr target="bm:Strelcyn1976Catalogue"/><citedRange unit="item">105, IV</citedRange>
                                        <citedRange unit="page">269</citedRange></bibl>, which is identical with 
                                    <bibl><ptr target="bm:Chaine1913Rep"/><citedRange unit="item">279</citedRange></bibl>.</note>
                                <textLang xml:lang="gez"/>
                                <incipit xml:lang="gez"><sic>በስመ፡</sic> ኦእግዚ<supplied reason="undefined" resp="PRS8999Strelcyn">አብሔር፡ እሳት፡
                                    በሐቅል፡ ሕሊና፡ ነዳ</supplied>ዲ።</incipit>
                            </msItem>
                            <msItem xml:id="p2_i4">
                                <locus from="75va" to="75vb"/>
                                <title>Short salām-hymn to St. John the Baptist</title><!-- not in Bm, no circulation attested -->
                                <textLang xml:lang="gez"/>
                                <incipit xml:lang="gez"><gap reason="lost"/>ካህን፡ ካህ<gap reason="lost"/> ኤልሣቤጥ፡ መ<gap reason="lost"/>። ወጣኔ፡ 
                                    ክርስትና<supplied reason="undefined">፡ ዮ</supplied>ሐንስ፡ ከሣቴ፡ ብርሃን።</incipit>
                            </msItem>
