                        <msItem xml:id="ms_i7">
                            <locus from="21vb" to="24ra"/>
                            <title>Magic prayers for loosening charms (maftǝḥe śǝrāy)</title>
                            <note>According to <bibl><ptr target="bm:Strelcyn1976Catalogue"/><citedRange unit="page">270</citedRange></bibl>,
                                containing ‘magic characters’, probably <term key="MagicSymbols">magic glyphs (charaktêres)</term>.</note>
                            <textLang mainLang="gez"/><!-- Check encoding of magic glyphs -->
                            <incipit xml:lang="gez" type="inscriptio"><unclear resp="PRS8999Strelcyn">ግልቤ፡</unclear> ዘድጋም፡ ወዘአጋንንት። 
                                <pb n="22ra"/> ግርጋኽኽ፡ ፯ ጌጤርግኽኽ፡ ፯ ሎብኖን<supplied reason="undefined">፡</supplied> 
                                ፯ ጊ<supplied reason="undefined">ዜ</supplied>፡ በኃይለ፡ ዝንቱ፡ አስማቲከ፡ ፍታሕ፡ ሥራየ፡ ዘገብረ፡ በላዕለ፡ ገብርከ፡ እ፡</incipit><!-- Look up text -->
