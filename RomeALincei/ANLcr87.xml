                            <msItem xml:id="ms_i1.1">               
                                <locus from="2r"/>
                                <title>History of the Kings of ʾAksum</title>
                                <note>The last king mentioned in this part is <persName ref="PRS6229LebnaDe"/></note>
                                <incipit xml:lang="gez">ታሪክ፡ ዘተጽሕፈ፡ እምታሪከ፡ ነገሥት፡ ዘአኵሱም።</incipit>
                            </msItem>
                            <msItem xml:id="ms_i1.2">               
                                <locus from="3r"/>
                                <title>On the Invasion of Grañ</title>
                                <note>On the invasion of <persName ref="PRS1522Ahmadb"/>.</note>
                                <incipit xml:lang="gez">ዓዲ፡ ንጽሕፍ፡ ለክሙ፡ ዳግማቄ፡ ታሪከ፡ ነገሥት፡ በረድኤተ፡ እግዚእነ፡ <sic>የሱስ፡</sic> ክርስቶስ፡ ዜና፡ ስደቶሙ፡ ወሞቶሙ፡
                                    ለሕዝበ፡ ኢትዮጵያ፡ ወድምሳሴ፡ ኵሎሙ፡ አብያተ፡ ክርስቲያናት፡ ዘኮነ፡ በበዘመኑ፡ በ፲ወ፱፡ ዓመተ፡ መንግሥቱ፡ ለልብነ፡ ድንግል።</incipit>
                            </msItem>
                            <msItem xml:id="ms_i1.3">               
                                <locus from="6v"/>
                                <title>On the Reign of ʾAṣnāf Sagad and his Successors</title>
                                <note>Concerning the reign of ʾAṣnāf Sagad (either <persName ref="PRS4428Galawdew"/> or 
                                    <persName ref="PRS10513Zadenge"/>) and his successors up to <persName ref="PRS10375Yohanne"/>.</note>
                                <incipit xml:lang="gez">እምድኅረ፡ ሞተ፡ አባስ፡ በ፮ ዓመት፡ ወ፫፡ አውራኅ፡ ሖረ፡ አጽናፍ፡ ሰገድ፡ ብሔረ፡ 
                                    <placeName ref="LOC1095Adal">አደል፡</placeName> ወእምዝ፡ በ፪፡ ዓመት፡ ጸልመ፡ ፀሐይ፡ ወሞተ፡ አዛዥ፡ ግርማ።</incipit>
                            </msItem>
                            <msItem xml:id="ms_i1.4">               
                                <locus from="8v" to="16v"/>
                                <title ref="LIT2375Synaxa" type="incomplete">Fragments of the Synaxary</title>
                                <note>Ending with a list of 120 Alexandrian-orthodox and Roman-catholic saints.</note>
                                <incipit xml:lang="gez">ዘተረክበ፡ እመጽሐፈ፡ ስንክሳር፡ ፩፡ ወበዛቲ፡ ዕለት፡ ካዕበ፡ ኮነ፡ ዕራፍቶሙ፡ ለነገሥት፡ ጻድቃን፡ አብርሃ፡ ወአጽብሃ፡</incipit>
                                <explicit xml:lang="gez">ኍልቈ፡ ቅዱሳን፡ ዘተጽሕፈ፡ በመጽሐፈ፡ ስንክሳር፡ ዘጽርዕ፡ ወዘሮማይስጥ። ወዘአእለዎ፡ ኤከይልዩ፡ ኀበ፡ ልሳን፡ ፈርንሳዊ፡ ዘውእቱ፡
                                    ህየንቴሁ፡ ለሊቀ፡ ጳጳሳት፡ ዘፓሪስ፡ በይእቲ፡ ትእይንት። <gap reason="ellipsis"/></explicit>
                            </msItem>
