                              <locus from="40ra" to="40rb"/>
                              <title>Prayer to St Mary</title>
                              <textLang mainLang="gez"/> 
                              <incipit>ክርስቶስ፡ ቤዛዊነ፡ ዘረሀዙኪ፡ በረምኅ፡ በመልዕልተ፡ መስቀል፡ ወአውሐዝኪ፡ ለሕፅበተ፡ ኃጢአትነ፡ <hi rend="rubric">ሰላም፡</hi> ለኪ፡ አመለትሕ፡ ልሑያት፡ <gap reason="ellipsis" resp="MK"/></incipit>
                           </msItem>
