                  <handDesc>
                     <handNote xml:id="h1" script="Ethiopic">
                        <seg type="script">A nineteenth-century script.</seg>
                        <seg type="ink">Black, red</seg>
                        <desc>The quality differs throughout the manuscript. Possibly several scribes were involved in the copying process. The writing
                           on <locus from="53v" to="57r"/> is irregular.</desc>
                        
                        <list type="abbreviations">
                           <item>
                              <abbr>ሃ፡ ሃ፡ ሃ፡</abbr> for <expan>ሃሌ፡ ሉያ፡</expan> (e.g., <locus target="#15v #16r"/>)</item>
                        </list>
                        
                        <seg type="rubrication">Divine names; names of the protagonists; a few lines
                           on the incipit page of Texts IV, V and VII, alternating with black lines;
                           elements of punctuation signs and text dividers; elements of Ethiopic
                           numerals; the word <foreign xml:lang="gez">salām</foreign> or some of its letters; the word <foreign xml:lang="gez">hale luyā</foreign> or
                           its abbreviations; a few other words, e.g., <foreign xml:lang="gez">soba</foreign> (<locus target="#4v"/>), 
                           <foreign xml:lang="gez">kama</foreign> (<locus target="#6v"/>).</seg>
                     </handNote>
