               <msContents>
                  <summary/>
                  <msItem xml:id="ms_i0">
                     <locus from="1v" to="9r">1v-9r</locus>
                     <textLang xml:lang="ar">Arabic</textLang>
                     <title ref="LIT0103IHA"/>
                     <incipit xml:lang="ar">
                        <locus target="#1v">-1v</locus>بسم الله الرحمن الرحيم وبه نستعين الحمد لله  رب العالمين والصلاة والسلام على سيدنا محمد وآله وصحبه اجمعين . البحث الاول في بيان العلم العلم اي التصور المطلق وهو حصول صورة الشيء في العقل</incipit>
                     <explicit xml:lang="ar">
                        <locus target="#9r">-9r</locus>قضايا تطلب نسبة محمولاتها الى موضوعاتها في ذلك العلم كما مرأن غير المنصرف لايد خله الجرو التنوين والله سبحانه وتعالى اعلم
</explicit>
                     <note>Some of the words are divided into two different lines</note>
                     <note/>
                  </msItem>
                  <msItem xml:id="ms_i1">
                     <locus from="10v" to="19r">10v-19r</locus>
                     <textLang xml:lang="ar">Arabic</textLang>
                     <title ref="LIT0104IHA"/>
                     <incipit xml:lang="ar">
                        <locus target="#10v">-10v</locus>بِسْمِ اللّهِ الرَّحْمنِ الرَّحِيمِ قال الشيخ سديد الدين ابو القاسم عبد الوهاب بن حسن بن بركات الوراق البهيئي رحمه الله نظمت مثلث قطرب على حروف المعجم</incipit>
                     <explicit xml:lang="ar">
                        <locus target="#19r">-19r</locus>اما الامة بالضم فا الجماعة من الناس لما رءيت دله وهجره ومطله نظمت في وصفى له مثلثا لقطرب صلاة ربى سرمد اتهدى النبي احمد اما دام عدرا عدا او لماح برق</explicit>
                     <note>Some of the words are divided into two different lines. The hand is different from the previous text</note>
                     <note/>
                  </msItem>
               </msContents>
