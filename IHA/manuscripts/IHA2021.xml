               <msContents>
                  <summary/>
                  <msItem xml:id="ms_i0">
                     <locus from="1v" to="2r">1v-2r</locus>
                     <textLang xml:lang="ar">Arabic</textLang>
                     <title ref="LIT1108IHA"/>
                     <incipit xml:lang="ar">
                        <locus target="#1v">-1v</locus>بسم الله الرحمن الرحيم هذ وصية رسول الله صلى الله عليه وسلم \ قال الشيخ احمد خادم الروضة الشريفة انه راى ليلة الجمعة سبعة وعشرين  فى شهر العقيدة عند المحراب فى الروضة وانا أتلوا القران العظيم اذا انا بين النوم واليقظة اذر رءيت جمال رسول الله صلى الله عليه وسلم 
</incipit>
                     <explicit xml:lang="ar">
                        <locus target="#2r">-2r</locus>ومن سمع هذه الوصية ولم ينقلها من مكان الى مكان ولا يسمعوها الناس سود الله [وجهه] يوم القيمة وكان محروما من رحمة الله فى الدنيا والاخرة قال شيخ احمد فولله ثم والله ثم الله وبالله ما كذبت فيها شئ فان كذبت حرمت من رحمة الله فى الدنيا والاخرة تمت \ بحمد الله وباالله الىوفيق صلى الله عليه وسلم  
</explicit>
                     <note/>
                     <note/>
                  </msItem>
                  <msItem xml:id="ms_i1">
                     <locus from="2v" to="206r">2v-206r</locus>
                     <textLang xml:lang="ar">Arabic</textLang>
                     <title ref="LIT0049IHA#s38IHA"/>
                     <incipit xml:lang="ar">
                        <locus target="#2v">-2v</locus>بسم الله الرحمن الرحيم الحمد لله رب العلمين الرحمن الرحيم ملك اليوم الدين<note>Verses 1:1-4</note>
                     </incipit>
                     <explicit xml:lang="ar">
                        <locus target="#206r">-206r</locus>قل انما انا بشر مثلكم يوحي اليّ انما إلهكم إله واحد فمن كان يرجوا لقا ربه فليعمل عملا صالحا ولا يشرك بعبادة احدا<note>Verse 18:110</note>
                     </explicit>
                     <note>Contains a bit more than the first half, as the text ends with the last verse of Sūrat al-kahf (sūra 18).</note>
                     <note/>
                  </msItem>
