               <msContents>
                  <summary/>
                  <msItem xml:id="ms_i0">
                     <locus from="4r" to="4v">4r-4v</locus>
                     <textLang xml:lang="ar">Arabic</textLang>
                     <title ref="LIT1294IHA"/>
                     <incipit xml:lang="ar">
                        <locus target="#4v">-4v</locus>اللهم اجرنا من النار ستا وفى السبعة اجرنا ويحروا لدينا وجميع المسلمين من النار بجاه نبيك المختار صلى الله عليه وسلم</incipit>
                     <explicit xml:lang="ar">
                        <locus target="#4r">-4r</locus> يا حفيظ يا كريم يا وهاب هب لى من نفسى فرقانا اهتدى به فى الظلمات الكونيه وارزقنى الاطمئنان الا بذكر الله تطمئن القلوب يا من لا تاخذه سنة لا نوم وهو علام الغيوب</explicit>
                     <note/>
                     <note/>
                  </msItem>
                  <msItem xml:id="ms_i10">
                     <locus from="25v" to="25v">25v-25v</locus>
                     <textLang xml:lang="ar">Arabic</textLang>
                     <title ref="LIT2242IHA"/>
                     <incipit xml:lang="ar">
                        <locus target="#25v">-25v</locus>ملام جاهك عزيزا غالبا ما دامت فى الدنيا تضيئ الايام| ما راق صفك وقت بن كرك وتوالت بك نعم اجسام</incipit>
                     <explicit xml:lang="ar">
                        <locus target="#25v">-25v</locus>ما قال حريق بنيران الحب يا طبيب قلبى عليك السلام قال مشتاق الى حما الحب يا صبون ذنبى [...] ابناء الازل</explicit>
                     <note/>
                     <note/>
                  </msItem>
                  <msItem xml:id="ms_i11">
                     <locus from="27r" to="27v">27r-27v</locus>
                     <textLang xml:lang="ar">Arabic</textLang>
                     <title ref="LIT1308IHA" type="acephalous"/>
                     <incipit xml:lang="ar">
                        <locus target="#27r">-27r</locus>خيال بدر من جار قبا| هيج الارواح حرك القلبا| صبى قد صبا مشتاق دار الاحبا جيرة العالم</incipit>
                     <explicit xml:lang="ar">
                        <locus target="#27v">-27v</locus>افضل من تلامن المرقوم| بافصح المطروق والمعهوم |النبى المبعوث بالمعموم</explicit>
                     <note/>
                     <note/>
                  </msItem>
                  <msItem xml:id="ms_i12">
                     <locus from="28r" to="28v">28r-28v</locus>
                     <textLang xml:lang="ar">Arabic</textLang>
                     <title ref="LIT2256IHA"/>
                     <incipit xml:lang="ar">
                        <locus target="#28v">-28v</locus>المنقبه السادسة والستون في اسمائه الشريفة رضي الله تعلى  عله ذكر واذلة تسعة وتسعون أسما ا بسم الله الرحمن الرحيم هو قطب الذى لا قطب الا هو</incipit>
                     <explicit xml:lang="ar">
                        <locus target="#28r">-28r</locus>اللهم على خير خلقه محمد وآله وصحبه اجمعين ت م ت</explicit>
                     <note/>
                     <note/>
                  </msItem>
                  <msItem xml:id="ms_i13">
                     <locus from="29r" to="29v">29r-29v</locus>
                     <textLang xml:lang="ar">Arabic</textLang>
                     <title ref="LIT1294IHA"/>
                     <incipit xml:lang="ar">
                        <locus target="#29r">-29r</locus>بسم الله الرحمن الرحيم اللهم اجرنا من النار ستا وفى السابعة اجرنا واجر والدينا وجميع المسلمين من النار بجاه نبيك المختار صلى عليه وسلم وءاله الاطهار وادخلنا الجنة مع البرار</incipit>
                     <explicit xml:lang="ar">
                        <locus target="#29v">-29v</locus>يا رب اسئلك تجليا يذهب عنى حجب النفس الظلمانيه</explicit>
                     <note/>
                     <note/>
                  </msItem>
                  <msItem xml:id="ms_i14">
                     <locus from="33r" to="33r">33r-33r</locus>
                     <textLang xml:lang="ar">Arabic</textLang>
                     <title ref="LIT2257IHA"/>
                     <incipit xml:lang="ar">
                        <locus target="#33r">-33r</locus>فصل محمد |
الذي جعل لله حبه اصلح المصالح| اللهم محمد الذي جعل لله حبه</incipit>
                     <explicit xml:lang="ar">
                        <locus target="#33r">-33r</locus>اللهم محمد الذي جعل لله حبه| اجمل ما تحمل به متجمل</explicit>
                     <note/>
                     <note/>
                  </msItem>
                  <msItem xml:id="ms_i15">
                     <locus from="36r" to="36v">36r-36v</locus>
                     <textLang xml:lang="ar">Arabic</textLang>
                     <title ref="LIT2262IHA"/>
                     <incipit xml:lang="ar">
                        <locus target="#36r">-36r</locus>بيننا وبينه في دار القرار انك أنت العزيز الغفار الله إنا نسألك بجاه محمد هذا النبي المصطفي وأله أهل الصدق والوفآ لن لنا معينا ومسعفا</incipit>
                     <explicit xml:lang="ar">
                        <locus target="#36v">-36v</locus>سترته ولا هما الافرجته ولا دينا الا قضيته ولا محتاجا الا كفيته ولا مريضا الا شفيته</explicit>
                     <note/>
                     <note/>
                  </msItem>
                  <msItem xml:id="ms_i16">
                     <locus from="37r" to="37r">37r-37r</locus>
                     <textLang xml:lang="ar">Arabic</textLang>
                     <title ref="LIT2263IHA"/>
                     <incipit xml:lang="ar">
                        <locus target="#37r">-37r</locus>من قرء هذا دعاء اربعين يوم [...] خمس مؤات اعطاه الله علما بغير التعليم وهو هذا يا من هو في علوه كائن </incipit>
                     <explicit xml:lang="ar">
                        <locus target="#37r">-37r</locus>اللهم اكرمنى بنور الفهم واخرجنى من ظلمات الوهم [...] وفهما برحمتك يا ارحم الراحمين ت م ت</explicit>
                     <note/>
                     <note/>
                  </msItem>
                  <msItem xml:id="ms_i17">
                     <locus from="39r" to="39v">39r-39v</locus>
                     <textLang xml:lang="ar">Arabic</textLang>
                     <title ref="LIT2267IHA" type="apodous"/>
                     <incipit xml:lang="ar">
                        <locus target="#39r">-39r</locus>بسم الله الرحمان الرحيم وبه نستعين بسم الله وبالله ومن الله والى الله والحمد لله ولا اله الا الله والله اكبر واعز واجل بما اخاف واحذر الله اكبر كبير ا والحمد لله كثيرا وسبحان الله بكرة </incipit>
                     <explicit xml:lang="ar">
                        <locus target="#39v">-39v</locus>يا قيوم يا قائما على كل نفس بما كسبت يا سيد اه 
يا مولاه يا حي يا قيوم ويا ما  [...] يا غاية</explicit>
                     <note/>
                     <note/>
                  </msItem>
                  <msItem xml:id="ms_i18">
                     <locus from="40r" to="40v">40r-40v</locus>
                     <textLang xml:lang="ar">Arabic</textLang>
                     <title ref="LIT2268IHA" type="apodous"/>
                     <incipit xml:lang="ar">
                        <locus target="#40r">-40r</locus>كتاب جامع وبرق لامع| ونور ساطع فى سر الشرفا| ترياق الاسقام وكاس الكرام| به القلب هام يرجو منه شفا</incipit>
                     <explicit xml:lang="ar">
                        <locus target="#40v">-40v</locus>لاهل الاهتدا ولاهل الوفا| علي الموجود قمر السعود| كوكب الوجود </explicit>
                     <note/>
                     <note/>
                  </msItem>
                  <msItem xml:id="ms_i19">
                     <locus from="41r" to="41v">41r-41v</locus>
                     <textLang xml:lang="ar">Arabic</textLang>
                     <title ref="LIT2269IHA" type="apodous"/>
                     <incipit xml:lang="ar">
                        <locus target="#41r">-41r</locus>بسم الله الرحمن الرحيم اللهم انى أسألك يا رب بعزيز تعزيز عزتك وبطول شديد قوتك وبقدرة مقدارا</incipit>
                     <explicit xml:lang="ar">
                        <locus target="#41v">-41v</locus>اللهم ما لك الملك تؤتى الملك من تشاء وتنزع الملك ممن تشاء وتعز [...] تشاء وتذل من تشاء بيدك الخير انك على كل</explicit>
                     <note/>
                     <note/>
                  </msItem>
                  <msItem xml:id="ms_i2">
                     <locus from="8v" to="9v">8v-9v</locus>
                     <textLang xml:lang="ar">Arabic</textLang>
                     <title ref="LIT2231IHA"/>
                     <incipit xml:lang="ar">
                        <locus target="#8v">-8v</locus>بسم الله الرحمن الرحيم
 وصل الله على سيدنا محمد وعلى ءاله وصحبه وسلم ألاءيمان ستة أن تؤمن بالله أي بأنه وحد فى ذاته وصفاته وأفعاله وأسمائه فالاسم ألله لاإله إلا هو الحي القوم ولذاة</incipit>
                     <explicit xml:lang="ar">
                        <locus target="#9v">-9v</locus>الصلاة الفاتحة والركو ثلاثه عسر نية ولكسره الاءحرام والقيام للقادر فى فرضى ففى اءة الفاتحة والركو [...] وصلى الله على نبي سيدنا وءله وصحبه وسلم</explicit>
                     <note/>
                     <note/>
                  </msItem>
                  <msItem xml:id="ms_i21">
                     <locus from="43r" to="43v">43r-43v</locus>
                     <textLang xml:lang="om-Arab">Oromo</textLang>
                     <title ref="LIT2271IHA" type="acephalous"/>
                     <incipit xml:lang="ar">
                        <locus target="#43r">-43r</locus>لكي يا بليسو هدر اهبد | هجى اخرات لكي مرطفد| ات غل كنكي ش تلقد ؤسول نجلتا موتش اس  طيبه</incipit>
                     <explicit xml:lang="ar">
                        <locus target="#43v">-43v</locus>مال يف دق  يتساك نم رات| اتوسنيف جرت ما باد كنوفت يواش أسنتي ديبئ سدبا
الحمد الذي هدا ه ع</explicit>
                     <note/>
                     <note/>
                  </msItem>
                  <msItem xml:id="ms_i22">
                     <locus from="45r" to="45v">45r-45v</locus>
                     <textLang xml:lang="ar">Arabic</textLang>
                     <title ref="LIT1308IHA" type="apodous"/>
                     <incipit xml:lang="ar">
                        <locus target="#45r">-45r</locus>جمال العالم صلى الله عليه وسلم مرتين جمال العالم صلى الله عليه وسلم جمال العالم |
خيال بدا من جار قبا هيج الارواح حرك القلبا لم | صب قد صبا مشتاقا دار الاحبا جيرة العا| يقول الكئيب قد ابدىى الغناهم مقصودى لفظا ومعنا| متمكنا قائمين زمنا فى ذاك الحرم</incipit>
                     <explicit xml:lang="ar">
                        <locus target="#45v">-45v</locus>يهيجه سماع الخبر من مسك طيبة والعود والخبر| يقوم ليلا راقبا لنور القمر به مهيم كيف</explicit>
                     <note/>
                     <note/>
                  </msItem>
                  <msItem xml:id="ms_i23">
                     <locus from="46r" to="56v">46r-56v</locus>
                     <textLang xml:lang="ar">Arabic</textLang>
                     <title ref="LIT2272IHA"/>
                     <incipit xml:lang="ar">
                        <locus target="#46r">-46r</locus>سلام دينا وبسيدنا محمد صلى الله عليه وسلم نبيا ورسولا يا مقلب القلوب ثبت قلب </incipit>
                     <explicit xml:lang="ar">
                        <locus target="#56v">-56v</locus>للون مشربا المرة للعين معتدل لقام ة فالنفرد ولم</explicit>
                     <note/>
                     <note/>
                  </msItem>
                  <msItem xml:id="ms_i24">
                     <locus from="58r" to="58v">58r-58v</locus>
                     <textLang xml:lang="ar">Arabic</textLang>
                     <title ref="LIT2273IHA"/>
                     <incipit xml:lang="ar">
                        <locus target="#58r">-58r</locus>مربا [السود]  نسيم الوداد| ونور الحاد بنغمات الصاد| فقامت الروح بالشوق تصيح| تناد الفها فى ذاك الابجادد</incipit>
                     <explicit xml:lang="ar">
                        <locus target="#58v">-58v</locus>رياح الحبوب تهب فى القلب| تأتى الطرب وشرب الوداد</explicit>
                     <note/>
                     <note/>
                  </msItem>
                  <msItem xml:id="ms_i25">
                     <locus from="59r" to="60v">59r-60v</locus>
                     <textLang xml:lang="ar">Arabic</textLang>
                     <title ref="LIT0753IHA" type="acephalous apodous"/>
                     <incipit xml:lang="ar">
                        <locus target="#59r">-59r</locus>قالت [...] انت قطب على جميع الانام قلت كفو اثم السمعو انص قولى انما القطب خادمى وغلامى</incipit>
                     <explicit xml:lang="ar">
                        <locus target="#60v">-60v</locus>رفعه اعلى المقام ونال عطا أجسام [...] به الكرام محمد ابن العرب</explicit>
                     <note/>
                     <note/>
                  </msItem>
                  <msItem xml:id="ms_i26">
                     <locus from="65r" to="65r">65r-65r</locus>
                     <textLang xml:lang="ar">Arabic</textLang>
                     <title ref="LIT2274IHA"/>
                     <incipit xml:lang="ar">
                        <locus target="#65r">-65r</locus>هذا كتاب قصة مولد النبي صلى الله عليه وسلم
بسم الله الرحمن الرحيم
شبهك بدر الليل بل انت انور| فيا [لميت] من نور الملا [...] ايا زينة الدنيا ويا غية المنا</incipit>
                     <explicit xml:lang="ar">
                        <locus target="#65r">-65r</locus>امامي رسول الله والبيت قبلتى [...] الصلاة على النبي محمد</explicit>
                     <note/>
                     <note/>
                  </msItem>
                  <msItem xml:id="ms_i27">
                     <locus from="65v" to="65v">65v-65v</locus>
                     <textLang xml:lang="ar">Arabic</textLang>
                     <title ref="LIT1195IHA"/>
                     <incipit xml:lang="ar">
                        <locus target="#65v">-65v</locus>بسم الله الرحمن الرحيم الحمد لله القوي الغالب الولي الطالب الباعث الوارث المانح السالب عالم الكائن</incipit>
                     <explicit xml:lang="ar">
                        <locus target="#65v">-65v</locus>الناطق والصامت والجامد والذاهب [يضرب] بعدله الساكن  ويسكن بفضله الضارب</explicit>
                     <note/>
                     <note/>
                  </msItem>
                  <msItem xml:id="ms_i28">
                     <locus from="66r" to="66v">66r-66v</locus>
                     <textLang xml:lang="ar">Arabic</textLang>
                     <title ref="LIT2275IHA"/>
                     <incipit xml:lang="ar">
                        <locus target="#66r">-66r</locus>سبحان الله ولحمد لله ولا الله ألله والله اكبر ولا حول ولا قوة الا بالله العلي العظيم [...] اللهم صل على محمد وعلى ال محمد وعلى أهل بيته مئة مرة </incipit>
                     <explicit xml:lang="ar">
                        <locus target="#66v">-66v</locus>وهو على كل شيئ قديس عشر مرات</explicit>
                     <note/>
                     <note/>
                  </msItem>
                  <msItem xml:id="ms_i3">
                     <locus from="14r" to="14v">14r-14v</locus>
                     <textLang xml:lang="ar">Arabic</textLang>
                     <title ref="LIT1294IHA"/>
                     <incipit xml:lang="ar">
                        <locus target="#14r">-14r</locus>بسم الله الرحمن الرحيم [...] ما بين المغرب وبعد
اللهم ءجرنا من النار سبعا وفى سابعة [...] بجميع لمسلمين من</incipit>
                     <explicit xml:lang="ar">
                        <locus target="#14v">-14v</locus>اللهم ءنى ءسئلك [...] الذى ملاءك كان عرش [...] لم لله لعظيم <note>Disrupted</note>
                     </explicit>
                     <note/>
                     <note/>
                  </msItem>
                  <msItem xml:id="ms_i4">
                     <locus from="16r" to="16v">16r-16v</locus>
                     <textLang xml:lang="ar">Arabic</textLang>
                     <title ref="LIT2233IHA"/>
                     <incipit xml:lang="ar">
                        <locus target="#16r">-16r</locus>يا الله يا وارث يا الله يا رشيد يا الله يا صبور يا الله يا سيد الساديت يا الله يا مجيب</incipit>
                     <explicit xml:lang="ar">
                        <locus target="#16v">-16v</locus>يا الله [...] احفظنا من أفات الدينيا والأخرة واقصى حاجاتنا يا سبحانك  لا اله الا</explicit>
                     <note/>
                     <note/>
                  </msItem>
                  <msItem xml:id="ms_i5">
                     <locus from="17v" to="17v">17v-17v</locus>
                     <textLang xml:lang="om-Arab">Oromo</textLang>
                     <title ref="LIT2234IHA" type="acephalous lacunous"/>
                     <incipit xml:lang="ar">
                        <locus target="#17v">-17v</locus>شاهدن ملئكه هدم نبرا |يوايىلنقن نما وجن جرا| نم يود كنسى هند كن جرا هدرا ان جبن أمر رغو فتاجى</incipit>
                     <explicit xml:lang="ar">
                        <locus target="#17v">-17v</locus>غوفننا غد اجد نملد اهد لا غاف نت ثمت شنقنين</explicit>
                     <note/>
                     <note/>
                  </msItem>
                  <msItem xml:id="ms_i6">
                     <locus from="18r" to="19v">18r-19v</locus>
                     <textLang xml:lang="ar">Arabic</textLang>
                     <title ref="LIT2235IHA" type="acephalous lacunous"/>
                     <incipit xml:lang="ar">
                        <locus target="#18r">-18r</locus>اقسمت بذات قد سكم| وقالب [ربكم]| وفضلكم كل جنسكم| طبى طوبى لمن خضر فى مجلسكم لطرتكم أعتقد</incipit>
                     <explicit xml:lang="ar">
                        <locus target="#19r-19v">-19r-19v</locus>إدارئية ببصر | في مجلس الوعظ وذكر| وبين المشائخ الغرر</explicit>
                     <note/>
                     <note/>
                  </msItem>
                  <msItem xml:id="ms_i7">
                     <locus from="20r" to="21r">20r-21r</locus>
                     <textLang xml:lang="ar">Arabic</textLang>
                     <title ref="LIT2237IHA"/>
                     <incipit xml:lang="ar">
                        <locus target="#20r">-20r</locus>لوعة كل متقبل فى كف زوار ليلا| شوق كل متمرغ فى ترب ملموس ليلا</incipit>
                     <explicit xml:lang="ar">
                        <locus target="#21r">-21r</locus>ما دمت تخطف العقول برقات ذاك الجلالا| ما سبى الباب الأحباب رونق ذاك الجلالا تمت</explicit>
                     <note/>
                     <note/>
                  </msItem>
                  <msItem xml:id="ms_i8">
                     <locus from="22r" to="23v">22r-23v</locus>
                     <textLang xml:lang="ar">Arabic</textLang>
                     <title ref="LIT2240IHA" type="acephalous lacunous"/>
                     <incipit xml:lang="ar">
