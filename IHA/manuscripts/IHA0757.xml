               <msContents>
                  <summary/>
                  <msItem xml:id="ms_i0">
                     <locus from="1r" to="1v">1r-1v</locus>
                     <textLang xml:lang="ar">Arabic</textLang>
                     <title ref="LIT1989IHA" type="acephalous apodous"/>
                     <incipit xml:lang="ar">
                        <locus target="#1r">-1r</locus>ميزاب بحر الكمال من وجه لمتراكم| مداد احروف الاشيا| نظلم سلك الانبيا| ميدان وصل الاوليا</incipit>
                     <explicit xml:lang="ar">
                        <locus target="#1v">-1v</locus>زينة ابرو البحار محلى نجاة الاثام| ادذ نحوكم زين| عبد مذنب حزين| أقول مال يا زين</explicit>
                     <note/>
                     <note/>
                  </msItem>
                  <msItem xml:id="ms_i1">
                     <locus from="2r" to="2v">2r-2v</locus>
                     <textLang xml:lang="ar">Arabic</textLang>
                     <title ref="LIT1990IHA" type="acephalous"/>
                     <incipit xml:lang="ar">
                        <locus target="#2r">-2r</locus>شمس العنايا بحر المدد| براق الوجه مسك الجسد| يسماه الله طه أحمد| خاتم المرسل الكنز المأبد محزن الأسرار منبع الحكم</incipit>
                     <explicit xml:lang="ar">
                        <locus target="#2v">-2v</locus>شرابا احلى لزو الوداد| منتهى الامال غية المراد| مراة للسر حياة الفؤد| مقيم الدين صاحب الجهاد محل الرجا ميزاب النعم</explicit>
                     <note/>
                     <note/>
                  </msItem>
                  <msItem xml:id="ms_i10">
                     <locus from="16r" to="17v">16r-17v</locus>
                     <textLang xml:lang="ar">Arabic</textLang>
                     <title ref="LIT1994IHA" type="acephalous"/>
                     <incipit xml:lang="ar">
                        <locus target="#16r">-16r</locus>المنتهىا؟ الا كمال؟ ورغبه خير من ارسل ونبينا | وخير مذلقا الى الحضرا</incipit>
                     <explicit xml:lang="ar">
                        <locus target="#17v">-17v</locus>يا ارحم الراحمين الله اكبر اللهم [لأتحر] من ابعده ولا تفتن بعده وغفر لنا وله وسلم لربع تمت.
بسم الله الرحمن الرحيم اللهم صل على محمد وعلي ال سيدنا محمد</explicit>
                     <note/>
                     <note/>
                  </msItem>
                  <msItem xml:id="ms_i2">
                     <locus from="3r" to="3r">3r-3r</locus>
                     <textLang xml:lang="ar">Arabic</textLang>
                     <title ref="LIT1993IHA" type="acephalous apodous"/>
                     <incipit xml:lang="ar">
                        <locus target="#3r">-3r</locus>محمد سلام عليكم | محمد سلام عليكم| محمد سلام عليكم| محمد سلام عليكم سيدي سلام عليكم صلاة الله خير الانام</incipit>
                     <explicit xml:lang="ar">
                        <locus target="#3r">-3r</locus>سيد مسك الختام| عروس دار سلم| منبع علم الاحكام| هو غية المرام سيد ولد ءادم</explicit>
                     <note/>
                     <note/>
                  </msItem>
                  <msItem xml:id="ms_i3">
                     <locus from="3v" to="4v">3v-4v</locus>
                     <textLang xml:lang="ar">Arabic</textLang>
                     <title ref="LIT1366IHA"/>
                     <incipit xml:lang="ar">
                        <locus target="#3v">-3v</locus>حمد لله وشكر الله شكرا دائما جزيلا| لأكرمنا حسا ومعنا بصله مزين المرسلا| كتاب مسطور بقلم النور قد قبل قبل الكلا</incipit>
                     <explicit xml:lang="ar">
                        <locus target="#4v">-4v</locus>وصلونا لمو ما نالوا رباب للمجد والعلا | تحت ابواب [الهبات] وبه تلباه الكلا</explicit>
                     <note/>
                     <note/>
                  </msItem>
                  <msItem xml:id="ms_i4">
                     <locus from="5r" to="5v">5r-5v</locus>
                     <textLang xml:lang="ar">Arabic</textLang>
                     <title ref="LIT1984IHA" type="apodous"/>
                     <incipit xml:lang="ar">
                        <locus target="#5r">-5r</locus>بسم الله الرحمن الرحيم اللهم غفر الحينا ومتنا وبشاهدنا وغائبنا وصغيرنا وكبيرنا وذكرنا وأنشنا</incipit>
                     <explicit xml:lang="ar">
                        <locus target="#5v">-5v</locus>اللهم لقه يصالحه سلفا مؤمنين فى كفالت ابراهيم ابد له دارا اخيرا من دره فأهل خير أهله وعافيه من عذاب [...] غفر لأفراطنا</explicit>
                     <note/>
                     <note/>
                  </msItem>
                  <msItem xml:id="ms_i5">
                     <locus from="6r" to="7r">6r-7r</locus>
                     <textLang xml:lang="ar">Arabic</textLang>
                     <title ref="LIT1992IHA" type="acephalous"/>
                     <incipit xml:lang="ar">
                        <locus target="#6r">-6r</locus>دوا أمرضى مرض الجهل يسر أسبا بى أجب سو .٢
هذا وان عنا بالجهل| والكفر أيضا بدل يا والي| تحت أمرك كل الاحوال| عزا ودكا بلا محال</incipit>
                     <explicit xml:lang="ar">
                        <locus target="#7r">-7r</locus>فابياتها عد الجمل| ميقات الكليم رمن تهالى ||أمين يا أمين اجب سؤال| بعبد القادر فحل الفحول|| الحمد لله العلي العالي| والصلاة على بحر الكمال| والسلام على خاتم الأرسال| وأهل بيته والصحب والال| شدد الله يا سيدة [...] يا سيدة ينا فطمة ظهرء</explicit>
                     <note/>
                     <note/>
                  </msItem>
                  <msItem xml:id="ms_i6">
                     <locus from="8r" to="8r">8r-8r</locus>
                     <textLang xml:lang="ar">Arabic</textLang>
                     <title ref="LIT1991IHA" type="acephalous"/>
                     <incipit xml:lang="ar">
                        <locus target="#8r">-8r</locus>قم على باب احباب النبي الكريم| بقلب خال عن كبره وصف ذمي| لا لك الوصول الابا يا دا الفخول| بمحبة اخوان الصفا والرحيم</incipit>
                     <explicit xml:lang="ar">
                        <locus target="#8r">-8r</locus>وفي ايديهم كؤس الندا والأنعام| اثبتو القلوب على السنن والوجو [...] ارسح الخيام لحضرة</explicit>
                     <note/>
                     <note/>
                  </msItem>
                  <msItem xml:id="ms_i7">
                     <locus from="9r" to="9v">9r-9v</locus>
                     <textLang xml:lang="ar">Arabic</textLang>
                     <title ref="LIT1986IHA" type="acephalous"/>
                     <incipit xml:lang="ar">
                        <locus target="#9r">-9r</locus> محامده كلها ما علمت منها [...] علم علي جميع نعمه كلها ما منها ولم أعلم عدد خلقه</incipit>
                     <explicit xml:lang="ar">
                        <locus target="#9r">-9r</locus>بسم الله الرحمن الرحيم ة لا حول ولاقوت إلا ب الله العلي العظيم</explicit>
                     <note/>
                     <note/>
                  </msItem>
                  <msItem xml:id="ms_i8">
                     <locus from="10r" to="10r">10r-10r</locus>
                     <textLang xml:lang="ar">Arabic</textLang>
                     <title ref="LIT1987IHA"/>
                     <incipit xml:lang="ar">
                        <locus target="#10r">-10r</locus>بسم الله الرحمن الرحيم 
اللهم خالص يا الله من كل مصيبة بني أدم وبناة حوى يا رب اللهم خلص يا الله من كل مصيبة السموات والأرض يا رب</incipit>
                     <explicit xml:lang="ar">
                        <locus target="#10r">-10r</locus>كل مصيبة البر والبحر يا رب لله فلصلى يا الله كل مصيبة الجن و</explicit>
                     <note/>
                     <note/>
                  </msItem>
                  <msItem xml:id="ms_i9">
                     <locus from="12r" to="15v">12r-15v</locus>
                     <textLang xml:lang="ar">Arabic</textLang>
                     <title ref="LIT1988IHA" type="acephalous apodous"/>
                     <incipit xml:lang="ar">
                        <locus target="#12r">-12r</locus>صلاة أئمة بدوام إنعامك | صلاة من باقية بقاء ملكك واعظامك | صلاة دائمة بداوام  قدرتك | صلاة باقية ببقاء مشيئك | صلاة دائمة بدوام عرشك </incipit>
                     <explicit xml:lang="ar">
                        <locus target="#15v">-15v</locus>قدر احسانه لحلقك| قدر حظوته لديك ومكاته</explicit>
                     <note/>
                     <note/>
                  </msItem>
