               <msContents>
                  <summary/>
                  <msItem xml:id="ms_i0">
                     <locus from="1r" to="4r">1r-4r</locus>
                     <textLang xml:lang="ar">Arabic</textLang>
                     <title ref="LIT0107IHA" type="acephalous"/>
                     <incipit xml:lang="ar">
                        <locus target="#1r">-1r</locus>ما شرب الصب مداما
وقام المحب هائم
مشتاق الشمس الكرما
كذا الأل الكرما
 وصحب من كانوا انجما بهم قد طلعت كواكب السعود</incipit>
                     <explicit xml:lang="ar">
                        <locus target="#4r">-4r</locus>النور الأكمل الممدد لأرباب السير تجدد حتى غاب لهم في ذالك الشهد
</explicit>
                     <note/>
                     <note/>
                  </msItem>
                  <msItem xml:id="ms_i1">
                     <locus from="4r" to="10r">4r-10r</locus>
                     <textLang xml:lang="ar">Arabic</textLang>
                     <title ref="LIT0138IHA"/>
                     <incipit xml:lang="ar">
                        <locus target="#4r">-4r</locus>صلى الله على محمد صلى الله عليه وسلم
فاطربوا أيا سعدا
واضربوا الدف واليدا
طلع هلال الهدى
قمر عز قد بدا حائز اسابغ النعم</incipit>
                     <explicit xml:lang="ar">
                        <locus target="#10r">-10r</locus>وإن كثر إثمه للتبرك يا فهيم</explicit>
                     <note/>
                     <note/>
                  </msItem>
                  <msItem xml:id="ms_i10">
                     <locus from="34v" to="37v">34v-37v</locus>
                     <textLang xml:lang="ar">Arabic</textLang>
                     <title ref="LIT0182IHA"/>
                     <incipit xml:lang="ar">
                        <locus target="#34v">-34v</locus>صلاة الله سلام الله على من محمد هاشمي عرب
تجلى من أحبه كرما
فأبدا لى من سناه عجيب</incipit>
                     <explicit xml:lang="ar">
                        <locus target="#37v">-37v</locus>وعلى الأل والأصحاب ترا
ما قال الحب هاشمي عرب</explicit>
                     <note/>
                     <note/>
                  </msItem>
                  <msItem xml:id="ms_i11">
                     <locus from="37v" to="39v">37v-39v</locus>
                     <textLang xml:lang="ar">Arabic</textLang>
                     <title ref="LIT0193IHA"/>
                     <incipit xml:lang="ar">
                        <locus target="#37v">-37v</locus>الصلاة والسلام ٢ على النبى خير الأنام
هبت نسيمات الأسرار / ليلة الخميس في الأسحار</incipit>
                     <explicit xml:lang="ar">
                        <locus target="#39v">-39v</locus>وعلى الأل والأصحاب / ما دام الكون بربه</explicit>
                     <note/>
                     <note/>
                  </msItem>
                  <msItem xml:id="ms_i12">
                     <locus from="39v" to="42v">39v-42v</locus>
                     <textLang xml:lang="ar">Arabic</textLang>
                     <title ref="LIT1425IHA"/>
                     <incipit xml:lang="ar">
                        <locus target="#39v">-39v</locus>رب صل وسلم على النور المبجل
رب صل وسلم على النور المبجل
طاف بنا ظبي كامل
بين تلك المنازل
فلا زالنا نتمايل كالأغصان الممايل</incipit>
                     <explicit xml:lang="ar">
                        <locus target="#42v">-42v</locus>فصلاتى وسلامى
على البي لمكرم
المخصوص بالمقام المحمود المبجل</explicit>
                     <note/>
                     <note/>
                  </msItem>
                  <msItem xml:id="ms_i13">
                     <locus from="42v" to="43v">42v-43v</locus>
                     <textLang xml:lang="ar">Arabic</textLang>
                     <title ref="LIT0146IHA"/>
                     <incipit xml:lang="ar">
                        <locus target="#42v">-42v</locus>زين نبى زين نبى ٢ يا حبيب سلام عليكم
انتم زين سر الوجود
فيض الرحمه اصل الوجود</incipit>
                     <explicit xml:lang="ar">
                        <locus target="#43v">-43v</locus>فأظلنى ظل الولايه / انظر إلي نظر العنايه</explicit>
                     <note/>
                     <note/>
                  </msItem>
                  <msItem xml:id="ms_i14">
                     <locus from="43v" to="46r">43v-46r</locus>
                     <textLang xml:lang="ar">Arabic</textLang>
                     <title ref="LIT1426IHA"/>
                     <incipit xml:lang="ar">
                        <locus target="#43v">-43v</locus>اللهم صل علي محمد وسلم عليه ٢
نبدء نظما بمدح الأمين / افضل الخلق السيد المكين</incipit>
                     <explicit xml:lang="ar">
                        <locus target="#46r">-46r</locus>ادم الصلاة عليه دوما / ءال وصحب دهرا وعاما</explicit>
                     <note/>
                     <note/>
                  </msItem>
                  <msItem xml:id="ms_i15">
                     <locus from="46r" to="50v">46r-50v</locus>
                     <textLang xml:lang="ar">Arabic</textLang>
                     <title ref="LIT0148IHA"/>
                     <incipit xml:lang="ar">
                        <locus target="#46r">-46r</locus>اللهم صل على محمد ٢
نظام الوجود  وسلم عليه
بدءت قولى بحمد الكريم / ان وفقنا لدين الإسلام</incipit>
                     <explicit xml:lang="ar">
                        <locus target="#50v">-50v</locus>مع ءالك وصحب كرام
ما هام صب وجدا بالهيام</explicit>
                     <note/>
                     <note/>
                  </msItem>
                  <msItem xml:id="ms_i16">
                     <locus from="50v" to="52v">50v-52v</locus>
                     <textLang xml:lang="ar">Arabic</textLang>
                     <title ref="LIT0195IHA"/>
                     <incipit xml:lang="ar">
                        <locus target="#50v">-50v</locus>اللهم صل علي محمد ٢
نظام الوجود وسلم عليه
شمس طلعت افق الكرام
اسكر لقوم ذا ك المدام</incipit>
                     <explicit xml:lang="ar">
                        <locus target="#52v">-52v</locus>ازكى صلاة مع السلام / على محمد طب الفؤاد</explicit>
                     <note/>
                     <note/>
                  </msItem>
                  <msItem xml:id="ms_i17">
                     <locus from="52v" to="56r">52v-56r</locus>
                     <textLang xml:lang="ar">Arabic</textLang>
                     <title ref="LIT0196IHA"/>
                     <incipit xml:lang="ar">
                        <locus target="#52v">-52v</locus>اللهم صل وسلم علي مهمد ٢
افتتح مدحى بمدح الأمين / سر نور الله ألنور المبين</incipit>
                     <explicit xml:lang="ar">
                        <locus target="#56r">-56r</locus>وعلى ءاله ومن تبعه / ومن دينه حقا جمعه</explicit>
                     <note/>
                     <note/>
                  </msItem>
                  <msItem xml:id="ms_i18">
                     <locus from="56r" to="58v">56r-58v</locus>
                     <textLang xml:lang="ar">Arabic</textLang>
                     <title ref="LIT0199IHA"/>
                     <incipit xml:lang="ar">
                        <locus target="#56r">-56r</locus>صلاة الله سلام الله على جمال العالم
محمد وءاله وصحبه الأكرام
صبت سحائب الصبا والصب لبه صبا</incipit>
                     <explicit xml:lang="ar">
                        <locus target="#58v">-58v</locus>صلاة ربنا المجيد وسلام من المزيد / على محمد عابد وآله الدعائم </explicit>
                     <note/>
                     <note/>
                  </msItem>
                  <msItem xml:id="ms_i19">
                     <locus from="58v" to="61r">58v-61r</locus>
                     <textLang xml:lang="ar">Arabic</textLang>
                     <title ref="LIT1427IHA"/>
                     <incipit xml:lang="ar">
                        <locus target="#58v">-58v</locus>محمد زين نبي محمد زين نبيمحمد زين نبي محمد سلام عليكم
دارت علينا كؤس وطابت له النفوس
</incipit>
                     <explicit xml:lang="ar">
                        <locus target="#61r">-61r</locus>وعلى الآل والصحب هم عند الله أهل القرب
ما مال المحب طربا بشرابه الكمال</explicit>
                     <note/>
                     <note/>
                  </msItem>
                  <msItem xml:id="ms_i2">
                     <locus from="10v" to="12r">10v-12r</locus>
                     <textLang xml:lang="ar">Arabic</textLang>
                     <title ref="LIT0125IHA"/>
                     <incipit xml:lang="ar">
                        <locus target="#10v">-10v</locus>صلاة وتسليم وأزكى تحية ٣ صلى الله عليه على المصطفى الهادى البرايا محمد يا رسول الله
ابان ما في قلبى ما قد كنت اخفيه
 بنور سرا منه من سر كماله</incipit>
                     <explicit xml:lang="ar">
                        <locus target="#12r">-12r</locus>صلى عليه ربى ما دام الكون به وسلم أبدا ما دام المواهب</explicit>
                     <note/>
                     <note/>
                  </msItem>
                  <msItem xml:id="ms_i20">
                     <locus from="61r" to="62r">61r-62r</locus>
                     <textLang xml:lang="ar">Arabic</textLang>
                     <title ref="LIT0200IHA"/>
                     <incipit xml:lang="ar">
                        <locus target="#61r">-61r</locus>صلوا عليه وسلموا تسليما من أوضح صراطا مستقيما
يا ذا العلا يا ذا البها جمالا
يا ذا السنا رفعة وتكريما</incipit>
                     <explicit xml:lang="ar">
                        <locus target="#62r">-62r</locus>صلى عليه ما سرت ركبان / إلى الحضره مؤانسا نديما</explicit>
                     <note/>
                     <note/>
                  </msItem>
                  <msItem xml:id="ms_i21">
                     <locus from="62r" to="66v">62r-66v</locus>
                     <textLang xml:lang="ar">Arabic</textLang>
                     <title ref="LIT0618IHA"/>
                     <incipit xml:lang="ar">
                        <locus target="#62r">-62r</locus>صلى الله على محمد تاج المرسلا سلى الله على محمد قبة الولا
قد لاح صباح الفتح / افاق قلوب الرجال</incipit>
                     <explicit xml:lang="ar">
                        <locus target="#66v">-66v</locus>ما سبى الباب الأحباب / رونق ذاك الجمال</explicit>
                     <note/>
                     <note/>
                  </msItem>
                  <msItem xml:id="ms_i22">
                     <locus from="66v" to="70r">66 v-70r</locus>
                     <textLang xml:lang="ar">Arabic</textLang>
                     <title ref="LIT0892IHA"/>
                     <incipit xml:lang="ar">
                        <locus target="#66v">-66v</locus>صلى الله على محمد شافع الورى
صلى الله على مهمد جمال الحضرى
بدر الكمال قد ظهر / الكون به تنور</incipit>
                     <explicit xml:lang="ar">
                        <locus target="#70r">-70r</locus>ما طار السالك شوقا لواد القرب واللقا  ما طاف أهل الوصال ؟ حول كعبة الكمال</explicit>
                     <note/>
                     <note/>
                  </msItem>
                  <msItem xml:id="ms_i23">
                     <locus from="70r" to="77v">70r-77v</locus>
                     <textLang xml:lang="ar">Arabic</textLang>
                     <title ref="LIT1088IHA"/>
                     <incipit xml:lang="ar">
                        <locus target="#70r">-70r</locus>صلى الله على محمد محبوب الأول
صلى الله على محمد النور الأول
تبدت شموس القرب ؟ أفاق سماء القلب</incipit>
                     <explicit xml:lang="ar">
                        <locus target="#77v">-77v</locus>سرنا في ميدان الصفا / طالبا جيش المعرفا</explicit>
                     <note/>
                     <note/>
                  </msItem>
                  <msItem xml:id="ms_i24">
                     <locus from="77v" to="82r">77v-82r</locus>
                     <textLang xml:lang="ar">Arabic</textLang>
                     <title ref="LIT0795IHA"/>
                     <incipit xml:lang="ar">
                        <locus target="#77v">-77v</locus>اللهم صل على محمد احمد خير الورا عروس الكمال
لما اسرتنى جيوش الأغيار / عن السير الى ذاك الحمى الغال</incipit>
                     <explicit xml:lang="ar">
                        <locus target="#82r">-82r</locus>ما سار ارباب برزخ الفناء / الى ارض البقا سرير الكمال</explicit>
                     <note/>
                     <note/>
                  </msItem>
                  <msItem xml:id="ms_i25">
                     <locus from="82r" to="85v">82r-85v</locus>
                     <textLang xml:lang="ar">Arabic</textLang>
                     <title ref="LIT0613IHA"/>
                     <incipit xml:lang="ar">
                        <locus target="#82r">-82r</locus>اللهم صل على محمد نور تنؤر [كذا] خلقوا [كذا] جليل
قد فاح ولاح في طيي الفؤاد / نور ذاك الوادى وسر يذهل</incipit>
                     <explicit xml:lang="ar">
                        <locus target="#85v">-85v</locus>به التمرغ به التذلل / في روضة الأنس به التبتل</explicit>
                     <note/>
                     <note/>
                  </msItem>
                  <msItem xml:id="ms_i26">
                     <locus from="85v" to="89v">85v-89v</locus>
                     <textLang xml:lang="ar">Arabic</textLang>
                     <title ref="LIT1279IHA" type="apodous"/>
                     <incipit xml:lang="ar">
                        <locus target="#85v">-85v</locus>اللهم صل على محمد مهبوب الأول نور مقدم
ولما تلع النور المعظم / معشر الوشاق به ترمرم</incipit>
                     <explicit xml:lang="ar">
                        <locus target="#89v">-89v</locus>حبى وأربى ملجائ مهربى
دوائ وطبى ؤرابى طعاب
الى كم أحرق</explicit>
                     <note/>
                     <note/>
                  </msItem>
                  <msItem xml:id="ms_i3">
                     <locus from="12v" to="14v">12v-14v</locus>
                     <textLang xml:lang="ar">Arabic</textLang>
                     <title ref="LIT0126IHA"/>
                     <incipit xml:lang="ar">
                        <locus target="#12v">-12v</locus>أواي سلام عليك اواي سلام عليك
أواي سلام عليك اواي سلام عليك
نحمد الله ربى على جل نعمه
ببعث رسول الله صفوة الحضرة</incipit>
                     <explicit xml:lang="ar">
                        <locus target="#14v">-14v</locus>امتنا عند الأجل بحسن الخاتمة</explicit>
                     <note/>
                     <note/>
                  </msItem>
                  <msItem xml:id="ms_i4">
                     <locus from="15r" to="16r">15r-16r</locus>
                     <textLang xml:lang="ar">Arabic</textLang>
                     <title ref="LIT1722IHA"/>
                     <incipit xml:lang="ar">
                        <locus target="#15r">-15r</locus>يا مصطفى الأنام ٣ عليك السلام
حمدا لك ربنا خالق الأشياء
أوجدت لنا سرا من درة البهاء</incipit>
                     <explicit xml:lang="ar">
                        <locus target="#16r">-16r</locus>ومحل الأنوار ومقام الكمال</explicit>
                     <note/>
                     <note/>
                  </msItem>
                  <msItem xml:id="ms_i5">
                     <locus from="16r" to="24v">16r-24v</locus>
                     <textLang xml:lang="ar">Arabic</textLang>
                     <title ref="LIT1723IHA"/>
                     <incipit xml:lang="ar">
                        <locus target="#16v">-16v</locus>اللهم صل على محمد ٢ يا امام الحرم كبر ؟ مطلسم
نحمد مولانا ونشكر رب
ثم صلاته على خير العرب
وعلى ءاله أيضا على الصحب
قام ببابنا سر من الحب فأسكر قلبا شراب منهم</incipit>
                     <explicit xml:lang="ar">
                        <locus target="#24v">-24v</locus>بحسن الخاتمه ان يختم له
ما دام السيار ينفتح له اسرار غيوب كان مكتم</explicit>
                     <note/>
                     <note/>
                  </msItem>
                  <msItem xml:id="ms_i6">
                     <locus from="24v" to="28v">24v-28v</locus>
                     <textLang xml:lang="ar">Arabic</textLang>
                     <title ref="LIT1725IHA"/>
                     <incipit xml:lang="ar">
                        <locus target="#24v">-24v</locus>محمد سلام عليكم سيدى سلام عليكم صلاة الله على خير البريا
أحمد معطى الولايه
صلاة بلا نهايه
على صاحب الدرايه
محمد بحر الهدايه محمد برق العنايه</incipit>
                     <explicit xml:lang="ar">
                        <locus target="#28v">-28v</locus>ما ذاق اهل المحبه شرابا يقلع اللبا</explicit>
                     <note/>
                     <note/>
                  </msItem>
                  <msItem xml:id="ms_i7">
                     <locus from="29r" to="31r">29r-31r</locus>
                     <textLang xml:lang="ar">Arabic</textLang>
                     <title ref="LIT1111IHA"/>
                     <incipit xml:lang="ar">
                        <locus target="#29r">-29r</locus>محمد سلام عليكم سيدى سلام عليكم
صلاة الله على خير البرايا
محمد ذخر الهدايه / محمد برق العنايه</incipit>
                     <explicit xml:lang="ar">
                        <locus target="#31r">-31r</locus>ومع الأل الولات / قدوة ذوى الخيرات</explicit>
                     <note/>
                     <note/>
                  </msItem>
                  <msItem xml:id="ms_i8">
                     <locus from="31r" to="33v">31r-33v</locus>
                     <textLang xml:lang="ar">Arabic</textLang>
                     <title ref="LIT0129IHA"/>
                     <incipit xml:lang="ar">
                        <locus target="#31r">-31r</locus>جمال بدا من فوق العز
ذل محتجا فقال هز</incipit>
                     <explicit xml:lang="ar">
                        <locus target="#33v">-33v</locus>من أولى الكرام وكذ الأحباب</explicit>
                     <note/>
                     <note/>
                  </msItem>
                  <msItem xml:id="ms_i9">
                     <locus from="33v" to="34v">33v-34v</locus>
                     <textLang xml:lang="ar">Arabic</textLang>
                     <title ref="LIT0130IHA"/>
                     <incipit xml:lang="ar">
                        <locus target="#33v">-33v</locus>صلى الله على محمد ٢ محمد علم العدا محمد
اول نشاء الوجود / وسر الله الودود</incipit>
                     <explicit xml:lang="ar">
                        <locus target="#34v">-34v</locus>مع صحبه والأل / ولمن له موال</explicit>
                     <note/>
                     <note/>
                  </msItem>
               </msContents>
