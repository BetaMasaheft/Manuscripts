                     <t:list xmlns:t="http://www.tei-c.org/ns/1.0">
                        <item xml:id="a0_4960">
                           <locus target="#3v">-3v</locus>
                           <q xml:lang="ar">هذه الصلوت لسيدنا خضر عليه السلام من قرأها مرة لا يسئله الله من قليل ذنبه ولا كثير ومن قراها ه</q>
                           <desc>Colophon</desc>
                           <note>Short identification of text 2r - 3v as a group of prayers ascribed to al-Ḫadir which will absolve the reader of his sins.
Written in black script at the bottom center of the page.</note>
                           <note>
                              <p>
            See also <persName ref="PRS1115IHA"/>
                              </p>
                           </note>
                        </item>
                        <item xml:id="a1_4996">
                           <locus target="#27v">-27v</locus>
                           <q xml:lang="ar">Devotional text written in the margins, unclear and partially faded</q>
                           <note>
                              <term key="Devotional"/>
                           </note>
                        </item>
                        <item xml:id="a0_4996">
                           <locus target="#23v">-23v</locus>
                           <q xml:lang="ar">هذه تلقين الميت</q>
                           <desc>Title</desc>
                           <note/>
                        </item>
                        <item xml:id="a1_5008">
                           <locus target="#57v">-57v</locus>
