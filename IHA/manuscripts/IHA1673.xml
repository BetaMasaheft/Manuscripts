                  <msItem xml:id="ms_i0">
                     <locus from="1r" to="3r">1r-3r</locus>
                     <textLang xml:lang="ar">Arabic</textLang>
                     <title ref="LIT1957IHA" type="acephalous"/>
                     <incipit xml:lang="ar">
                        <locus target="#1r">-1r</locus>وذنوبنا عظمت لله شكوتنا \ وحسرتي إن يكن فيها محاسبنا \ 
 يا رب فمنن بتوبة النصوح لنا \ ومنّ عليها باخلاص ونيل منا وجنّب النفس من بخل ومن زحرى</incipit>
                     <explicit xml:lang="ar">
                        <locus target="#3r">-3r</locus>وارحم مؤلفها بسورة البقرى كاالشمس للحبشا المسمى باالبشرى \ فاعطنا مولانا زاد الارض البيضا \ واحشرنا يا رب مع الوجوه البيضا \ ولا تطرحن صخرة الىىد البيضا \ واجعل لنا معهم يوم الحشر فى البيضا لتضحك الفقرى وبتكي الكفرى</explicit>
                     <note/>
                     <note/>
                  </msItem>
               </msContents>
