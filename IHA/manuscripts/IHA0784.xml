                  <msItem xml:id="ms_i0">
                     <locus from="1v" to="7v">1v-7v</locus>
                     <textLang xml:lang="ar">Arabic</textLang>
                     <title ref="LIT1294IHA"/>
                     <incipit xml:lang="ar">
                        <locus target="#1v">-1v</locus>بسم الله ارحمن الرحيم اللهم اجرنا من النار ستا وفى السابعة اجرنا واجر والدين وجميع المسلمين من النار بجاه نبيك والمختار صلى الله عليه وسلم وءاله الاطهار وادخلنا الجنة مع الابرار بفضلك وكرمك يا غزيز [...] ثم ءاية الكرسي الخ ثم يا رب يا رحمن يا عظيم اسئلك تجليا يذهب عنى حجب النفس</incipit>
                     <explicit xml:lang="ar">
                        <locus target="#7v">-7v</locus>فان كان ليلة الجمعة فيزيد فيها اللهم يا دائم الفضل الخ الى هذه العشية عشر مراة اللهم جعلنا من اهل الجنة التى حشوها بركة وعمارها ملائكة مع حبيبنا محمد وابينا ابراهيم</explicit>
                     <note/>
                     <note/>
                  </msItem>
