                           </note>
                        </item>
                        <item xml:id="a4_2928">
                           <locus target="#176r">-176r</locus>
                           <q xml:lang="ar">اللهم رب زدني علما وحلما وايمانا ويقينا وصدقا ليس بعده كفوا</q>
