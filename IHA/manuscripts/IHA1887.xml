               <msContents>
                  <summary/>
                  <msItem xml:id="ms_i0">
                     <locus from="1r" to="2r">1r-2r</locus>
                     <textLang xml:lang="ar">Arabic</textLang>
                     <title ref="LIT1282IHA" type="acephalous"/>
                     <incipit xml:lang="ar">
                        <locus target="#1r">-1r</locus>به زال عنا به انجلى عنا , ظلام الحسىّ كذ المعنوى \ به تكرم به انتظم , الكون السفلى كذ العلوي</incipit>
                     <explicit xml:lang="ar">
                        <locus target="#2r">-2r</locus>وعلى ءاله شموس الوجود , ما جال فى القلب وارد قدسى \ ما دام يقول أسير المحبة , مصطفى مجتبى رسول مكى

</explicit>
                     <note>The vowel marks are added in blue.</note>
                     <note/>
                  </msItem>
                  <msItem xml:id="ms_i1">
                     <locus from="2r" to="3v">2r-3v</locus>
                     <textLang xml:lang="ar">Arabic</textLang>
                     <title ref="LIT0613IHA"/>
                     <incipit xml:lang="ar">
                        <locus target="#2r">-2r</locus>اللهم صل على محمد نور تنور خلقه جليل \ قد فاح ولاح فى طي فؤادى , نور ذاك الوادى وسر يذهل \ نبي امي نور عربي , هاشمي مضر مختار مرسل

</incipit>
                     <explicit xml:lang="ar">
                        <locus target="#3v">-3v</locus>به التقرب به التملق , على عتبات كريم وكيل \ به التمرغ به التذلل , فى روضة الانس به التبتل

</explicit>
                     <note/>
                     <note/>
                  </msItem>
                  <msItem xml:id="ms_i2">
                     <locus from="3v" to="4v">3v-4v</locus>
                     <textLang xml:lang="ar">Arabic</textLang>
                     <title ref="LIT1288IHA"/>
                     <incipit xml:lang="ar">
                        <locus target="#3v">-3v</locus>اه اه اللهم صل على محمد وسلم عليه اه اه \ غزال سبانى طرفه كحيل , ليس له فى الكون شبه ومثيل \ صفوة الكرام طبيب الاسقام , غاية المرام مثير الغرام

</incipit>
                     <explicit xml:lang="ar">
                        <locus target="#4v">-4v</locus>سر أهل الله الحب المقرب , الهاد المصطفى المختار المنتخب \ المورد الانيق شراب مثمل , به يتغنى عاشق نحيل

</explicit>
                     <note/>
                     <note/>
                  </msItem>
                  <msItem xml:id="ms_i3">
                     <locus from="4v" to="6v">4v-6v</locus>
                     <textLang xml:lang="ar">Arabic</textLang>
                     <title ref="LIT1088IHA" type="apodous"/>
                     <incipit xml:lang="ar">
                        <locus target="#4v">-4v</locus>صلى الله على محمد محبوب الاول صلى الله على محمد النور الاول \ تبدت شموس القرب , افاق سما القلب \ فحن الحب شوقا , لوادى القرب واللقا
</incipit>
                     <explicit xml:lang="ar">
                        <locus target="#6v">-6v</locus>مهبط وحى الربانى , جوهر ما له ثانى \ دليل كل حيرانى , وبشرى اهل اليمن || مخرج<note>The last word is the catchword.</note>
                     </explicit>
                     <note/>
                     <note/>
                  </msItem>
