               <msContents>
                  <summary/>
                  <msItem xml:id="ms_i0">
                     <locus from="41" to="48">p. 41-48</locus>
                     <textLang xml:lang="ar">Arabic</textLang>
                     <title ref="LIT1170IHA" type="acephalous apodous"/>
                     <incipit xml:lang="ar">
                        <locus target="#p. 41">-p. 41</locus>أبو طالب وأبو لهب وحمزة وللعباس ولم يسلم الا حمزة والعباس قال صلى الله عليه وسلم سيج الشهداء يوم القيامة حمزة</incipit>
                     <explicit xml:lang="ar">
                        <locus target="#p. 48">-p. 48</locus>وبلال بن رباح وامه حمامة وهو مولى ابى بكر الصديق رضى الله تعالى عنهما وهو اول</explicit>
                     <note>No printing information remains.</note>
                     <note/>
                  </msItem>
                  <msItem xml:id="ms_i1">
                     <locus from="41" to="48">*p. 41-48</locus>
                     <textLang xml:lang="ar">Arabic</textLang>
                     <title ref="LIT2962IHA" type="acephalous apodous"/>
                     <incipit xml:lang="ar">
                        <locus target="#*p. 41">-*p. 41</locus>والسواد وفى بعض آخر بحمل النفى على غالب الاوقات لعدم احتياج شيبه الى الخضب لقلته وحمل الاثبات على بعض الاوقات وكانت مدة شكواه ثلثة عشر يوما </incipit>
                     <explicit xml:lang="ar">
                        <locus target="#*p. 48">-*p. 48</locus>قيل المراد منه الخالص وقيل ذو الخطوط الخضر ولبسه الاحمر الخالص والمزعفر مع نهيه عنهما لبيان الجواز والاشارة الى ان النهى للتنزيه ومن حرم المصبوغ بكثير الزعفران حمل</explicit>
                     <note>Printed in the margins.
No printing information remains.</note>
                     <note/>
                  </msItem>
