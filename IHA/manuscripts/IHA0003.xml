               <msContents>
                  <summary/>
                  <msItem xml:id="ms_i0">
                     <locus from="1r" to="4v">1r-4v</locus>
                     <textLang xml:lang="x-oh">Old Harari</textLang>
                     <title ref="LIT0001IHA"/>
                     <incipit xml:lang="ar">
                        <locus target="#1v">-1v</locus>صَومَنْ يبُؤْ جِرْ تِمِسْتِينْ [حَالْ] يِبُؤْا تَعسِّرَانْ حَالْ يُبوَاءْ اَوَّلْ جِرْ إِبْليسْ مَلَدَوْمَا \ زَعَجَدَلُوا سُوت جَنَّتْ بَرْعِوْ زِكَفَتُلُوْا سَعْتِ عَذِاب بَرْعِوْ زِقُوْفَللوْا زُ \ زُلْعِيْوِام</incipit>
                     <explicit xml:lang="ar">
                        <locus target="#4r">-4r</locus>أَلله بَايَ أَحَتَّ نُجْدَ يِجَبْعِ بَجُ جِرْ إدُوْشَا أَبُوْش مِنْ نَاشَ تِلُمَ تِتْحِيرَ جَاجُوَا جَمِّيع \ مَخْلُوْقإِوْ إِمَلْ حِرْجِ إِرَزْقِبَازَاجْ قُدْرَ إِيبِ أَطْمَمْتُنْ أَللهُ بَايَ تَمَّتْ \ تمت كتاب الفرايض بكلام الحبش أخرجه أو عبد الْرَحمن العراشيّ نفعنا الله بهم آمين
<note>cfr. the text edition by Cerulli in which it is ascribed to Faqīh Ṭayyib al-Wanāǧī al-Ṣadrī</note>
                     </explicit>
                     <note>Cp. <ref type="mss" corresp="IHA0002"/>
                     </note>
                     <note>Same hand of ff. 4r-7r and 7r-10v
</note>
                     <note/>
                  </msItem>
                  <msItem xml:id="ms_i1">
                     <locus from="4r" to="7r">4r-7r</locus>
                     <textLang xml:lang="x-oh">Old Harari</textLang>
                     <title ref="LIT0669IHA"/>
                     <incipit xml:lang="ar">
                        <locus target="#4r">-4r</locus>وأيضا هذا كتاب الفرايض بكلام هرر أخرجه فقيه طيّب ألونَاجيّ الصَّدْرِيّ رحمه الله \ بِسْمِ الله الرّحْمن الرّحيْمِ \ جَنَّتْمَا يِرَجِبُّوا إِمْ إِسَاتُخْ يِسَلْطُبُوا الله خَاذوْا أَجْدِ روْتْمَ زالله لال أَنَاخ بلاوْت</incipit>
                     <explicit xml:lang="ar">
                        <locus target="#7r">-7r</locus>زِنَبِ هَدِيَتْ هَرْعَةٍ نَبِ ازِّيْ بِيْ تَمَسَّكُوت أَصْحَابَ زِيُّوا وِدَادُوت \ سُنَّ زِيُوْا أَتْحِيْوُوْت اللهمَّ صَلِّ عَليْ أبْزَارجُوت زِجرءِ هَدِيتْ هَزْعَة سَق \ سَأنْ بَالُوْت وِرْشْ بِيْ تَخَتّرْ بَالُوْت فِيْ سَبِيْل الله جِهادْ أنوْت جَمِّعْ مَخْلُوق \ لِيْ خَيْرِ خِشُوْت تمتْ
</explicit>
                     <note>Same hand of ff. 1r-4r and 7r-10v
</note>
                     <note/>
                  </msItem>
                  <msItem xml:id="ms_i2">
                     <locus from="7r" to="10v">7r-10v</locus>
                     <textLang xml:lang="x-oh">Old Harari</textLang>
                     <textLang xml:lang="ar">Arabic</textLang>
                     <title ref="LIT0670IHA"/>
                     <incipit xml:lang="ar">
                        <locus target="#7r">-7r</locus>هذا كتاب الفرايض بكلام هرر أخرجه عبد الله عمر بن جبريل \ بسم الله الرَّحْمنِ الرَّحِيْمِ \ أَوَّلْ جِرْ إِسْلام بِيْ زَارَدُوْا فَرْضِ أَخْ مُوْستِنْ حَمِّسْتِن اَوَّل جِرْ شَهادَة صلـ \ صَلَوْة صُوْمَن زَكَّ بِلَحَزِ خَاد حَجِّ حُرُوْت يَع وُسْطِبِي زَال فَرْضِ أَخ كُيْءَ</incipit>
                     <explicit xml:lang="ar">
                        <locus target="#10v">-10v</locus>خُنُوت بَالِغ خُنُوت نيت أرْتُليب نيت أُوْشوْت زنيْت حُكْمِ شِيشْتِن \ سُنَّ أَرْتَاي فَرْض أَرْتَاي زنيْت  أَرْتَاي بِيْ صِفَتْ زُوْا أُشوْت زنيْت \ أَرْتَاي كُعُوتِنْ مِيَا إِج كَفِّ كَلْتِدَا بَلَ بِيْ نِيْت اُوْشُوْت تمت الحمد \ لله تعَلَي وَفَضلَه وَكَرَمَه والحَمْد لله رَبّ العَلَمين وامين \ وصلي علي سيدنا محمد واله وصَحْبِهِ وسَلم تَسلِيمَا كَثِيْرَا كَبِيرَا دايما \ هذا كتاب الفرائض بكلام هرر اخرجه بن عبد الله عمر بن جبرايل \ الاوسام الساختي رضي الله عنه</explicit>
                     <note>Same hand of ff. 1r-4r and 4r-7r</note>
                     <note/>
                  </msItem>
