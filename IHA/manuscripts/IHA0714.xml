                  <msItem xml:id="ms_i0">
                     <locus from="1r" to="6v">1r-6v</locus>
                     <textLang xml:lang="ar">Arabic</textLang>
                     <title ref="LIT1619IHA" type="acephalous apodous"/>
                     <incipit xml:lang="ar">
                        <locus target="#1r">-1r</locus>زخ كما فى عالم الملك وشمسه غير آفد وشموس غيره  آفد وطريقته غير منسوخ كشريعة جده صلى الله عليه وسلم</incipit>
                     <explicit xml:lang="ar">
                        <locus target="#6v">-6v</locus>وخليفتى وزير فى الدنيا والاخرة بلا تفاخر ولا مباهات وهو مرب ومتصرف فى عالم البر</explicit>
                     <note/>
                     <note/>
                  </msItem>
                  <msItem xml:id="ms_i1">
                     <locus from="7r" to="12v">7r-12v</locus>
                     <textLang xml:lang="ar">Arabic</textLang>
                     <title ref="LIT1621IHA" type="acephalous apodous"/>
                     <incipit xml:lang="ar">
                        <locus target="#7r">-7r</locus>شيا ومن اصدق من الله حديثا فاذا كان الأمر كذلك وهو تحكم بد هو حكم باكرءي وهو ممنوع غير جائز وسائر الشعرانى شيخه على الخواص</incipit>
                     <explicit xml:lang="ar">
                        <locus target="#12v">-12v</locus>افضل مخلوقاتك سيدنا محمد وعلى ءاله وصحبه وسلم عدد معلوماتك ومداد كلماتك كلما تكرى</explicit>
                     <note/>
                     <note/>
                  </msItem>
