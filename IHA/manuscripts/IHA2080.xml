               <msContents>
                  <summary/>
                  <msItem xml:id="ms_i0">
                     <locus from="1r" to="2r">1r-2r</locus>
                     <textLang xml:lang="ar">Arabic</textLang>
                     <title ref="LIT2005IHA" type="acephalous"/>
                     <incipit xml:lang="ar">
                        <locus target="#1r">-1r</locus>سيد السادات من مضر | غوث اهل البدو والحضر | صاحب الأيات والسور | منبع الأحكام والحكم | قمر طابت سر بر... | وسجاياه وسيرته </incipit>
                     <explicit xml:lang="ar">
                        <locus target="#2r">-2r</locus>المصفي منصب الشرفا | ذو الوفا الأغلا الوري شرفا | احمد المختار والخلفا شهدأ الله في الامم | تمت</explicit>
                     <note/>
                     <note/>
                  </msItem>
                  <msItem xml:id="ms_i1">
                     <locus from="2v" to="4v">2v-4v</locus>
                     <textLang xml:lang="x-oh">Old Harari</textLang>
                     <title ref="LIT4042IHA"/>
                     <incipit xml:lang="ar">
                        <locus target="#2v">-2v</locus>سق حميلا وبسم الله يبور دو اصل بسم الله ورش حميلاوا بسم الله يبرسا أواي بني ورش كرس ذال نخلفليو ملايكة سلام يل جرا </incipit>
                     <explicit xml:lang="ar">
                        <locus target="#4v">-4v</locus>وددينا يود نبيو سطينا الله حمدا وددينا | ملحينا ملح نبيو سطينا الله حمدا ملحينا | أواي محمدوا صل علي دووا نبيوا أمين | تمت</explicit>
                     <note>Vocalization in blue ballpoint only in the first part of the poem.</note>
                     <note/>
                  </msItem>
                  <msItem xml:id="ms_i2">
                     <locus from="4v" to="5v">4v-5v</locus>
                     <textLang xml:lang="ar">Arabic</textLang>
                     <title ref="LIT4043IHA" type="apodous"/>
                     <incipit xml:lang="ar">
                        <locus target="#4v">-4v</locus>شي لله عمر زياد شي عمر زياد | مدحكم نعم المرادي المدد عمر زياد | ابتدي ببسم الله ثانيا بحمد الله | مادحا ولي الله المدد عمر زياد</incipit>
                     <explicit xml:lang="ar">
                        <locus target="#5v">-5v</locus>وعليك اتكا لي المدد عمر زياد | سيدي فقل لبيك ابن عمر زياد يدعوك كن مغيثا لداعيك المدد عمر زياد</explicit>
                     <note/>
                     <note/>
                  </msItem>
                  <msItem xml:id="ms_i3">
                     <locus from="6r" to="8v">6r-8v</locus>
                     <textLang xml:lang="ar">Arabic</textLang>
                     <textLang xml:lang="x-oh">Old Harari</textLang>
                     <title ref="LIT4046IHA"/>
                     <incipit xml:lang="ar">
                        <locus target="#6r">-6r</locus>عرش الرحما نب أ اجييوا | سبع سما نب او اجيوا | جمع مخلوقب أو احيوا | محمد بايت حرأت حرفا | جمع حروفب ترفانا </incipit>
                     <explicit xml:lang="ar">
                        <locus target="#8v">-8v</locus>نبو سطينا اللو حمدي | إيمان سطين ال؛لو حمدي المرسببن؟ اللو حمدي</explicit>
                     <note/>
                     <note/>
                  </msItem>
                  <msItem xml:id="ms_i4">
                     <locus from="9r" to="9v">9r-9v</locus>
                     <textLang xml:lang="x-oh">Old Harari</textLang>
                     <title ref="LIT4045IHA" type="acephalous apodous"/>
                     <incipit xml:lang="ar">
                        <locus target="#9r">-9r</locus>نبو معجزاتخ برد بر... لو إماموا | نبو معجزاتخ وراق مسر لو إماموا | درق نبو ... تمرم بس أطتلا اماوا | نبو حطر ذيمن نقن باتلا اماوا</incipit>
                     <explicit xml:lang="ar">
                        <locus target="#9v">-9v</locus>نبو راج حالب ذحبعخل اماوا | نبو مت منعيتا ذحل كخل اماوا</explicit>
                     <note/>
                     <note/>
                  </msItem>
                  <msItem xml:id="ms_i5">
                     <locus from="10r" to="10v">10r-10v</locus>
                     <textLang xml:lang="ar">Arabic</textLang>
                     <textLang xml:lang="x-oh">Old Harari</textLang>
                     <title ref="LIT4044IHA"/>
                     <incipit xml:lang="ar">
                        <locus target="#10r">-10r</locus>ما حيو سلام عليك عربوا سلام عليك | أولو ببسم الله ثانيا بحمد الله | ثالثا ثلاة الله لنبي رسول الله | قهوة إذ شربا بدنا بها استرحنا | شوشنا بها يزول وكذا وجع وكسل</incipit>
                     <explicit xml:lang="ar">
                        <locus target="#10v">-10v</locus>أكثروا في القهوات ذكر إسم بسم الله  أكثروا في القهوات للنبي صلوات | وادعوا للمسلمين وجميع المؤمنين إحذروا في القهوات لفظة من لفواتي </explicit>
                     <note/>
                     <note/>
                  </msItem>
                  <msItem xml:id="ms_i6">
                     <locus from="11r" to="16v">11r-16v</locus>
                     <textLang xml:lang="x-oh">Old Harari</textLang>
                     <title ref="LIT4045IHA" type="acephalous"/>
                     <incipit xml:lang="ar">
                        <locus target="#11r">-11r</locus>نبو نطف چوچا وذح... خچل؟ اماموا | نبو چار أباتم ذخل كخل إماموا | نبو أوا أيم ذحل كخل إماموا</incipit>
                     <explicit xml:lang="ar">
                        <locus target="#16v">-16v</locus>نبو شكر جيب أخع نالخو إماموا | نبو جيزجي ب اخع نالخو إماموا | نبو أول حمد أخر شكر بيو إماموا</explicit>
                     <note/>
                     <note/>
                  </msItem>
                  <msItem xml:id="ms_i7">
                     <locus from="16v" to="17v">16v-17v</locus>
                     <textLang xml:lang="ar">Arabic</textLang>
                     <title ref="LIT3052IHA" type="apodous"/>
                     <incipit xml:lang="ar">
                        <locus target="#16v">-16v</locus>بسم الله الرحمن الرحيم | نبي لله يا جيلاني شي لله يا جيلاني | عبد القادر كيلاني ولي الرحمن | ولي الأوليأ ألقيت سري وبرهاني</incipit>
                     <explicit xml:lang="ar">
                        <locus target="#17v">-17v</locus>قرانا زبورا كاملا ثم فرقاني | وخصت بحار العلم من قبل نشاتي | أخي ورفيقا كان موسى ابن عمر...</explicit>
                     <note/>
                     <note/>
                  </msItem>
                  <msItem xml:id="ms_i8">
                     <locus from="18r" to="20v">18r-20v</locus>
                     <textLang xml:lang="x-oh">Old Harari</textLang>
                     <title ref="LIT4045IHA" type="apodous"/>
                     <incipit xml:lang="ar">
                        <locus target="#18r">-18r</locus>بسم الله الرحمن الرحيم | نبوا بسم الله زعزيز سموا إماموا | نبوا الرحمانوا زعزيز سموا إماموا | نبوا الرحيم زعزيز سموا إماموا | نبوا بسم الله داو خونني إماموا</incipit>
                     <explicit xml:lang="ar">
                        <locus target="#19v">-19v</locus>نبو معجراتخ داكر ذيكرو اماموا | نبو معجراتخ عالم فيسرو اماموا</explicit>
                     <note/>
                     <note/>
                  </msItem>
