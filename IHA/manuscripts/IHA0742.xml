               <msContents>
                  <summary/>
                  <msItem xml:id="ms_i0">
                     <locus from="1v" to="10v">1v-10v</locus>
                     <textLang xml:lang="ar">Arabic</textLang>
                     <title ref="LIT0655IHA"/>
                     <incipit xml:lang="ar">
                        <locus target="#1v">-1v</locus>ابر قلع من بان والعلم| ام تشتاق ارضا فيها ماء زمزم| ما قلبك يوما لا يخلو عن سقو| ابدر طلع بين ارض الحرم يخجل نوره شمسا فى الضحاء</incipit>
                     <explicit xml:lang="ar">
                        <locus target="#10v">-10v</locus>وصل يا رب وسلم عليه| بعد مصلى يصلى عليه| ما فى قلب المشتاق يشتاق اليه| وأل وضحبي والتابعين به وأمة المرحوم وأهل الهدأ بعد زبد
</explicit>
                     <note/>
                     <note/>
                  </msItem>
                  <msItem xml:id="ms_i1">
                     <locus from="11v" to="13r">11v-13r</locus>
                     <textLang xml:lang="ar">Arabic</textLang>
                     <title ref="LIT0107IHA"/>
                     <incipit xml:lang="ar">
                        <locus target="#11v">-11v</locus>بسم الحي الباقى نبتدى  وبثنائه نهتدى من نحبش العمى الى نور الشهود| ومن الائه نطمع وباب جوده نقرع عسى يذيقنا من قطرة المدد</incipit>
                     <explicit xml:lang="ar">
                        <locus target="#13r">-13r</locus>النور الأكمل الممدد الأرباب السير تجدد| حتى غاب بهم فى ذالك المشهد تمت</explicit>
                     <note/>
                     <note/>
                  </msItem>
                  <msItem xml:id="ms_i2">
                     <locus from="13r" to="14v">13r-14v</locus>
                     <textLang xml:lang="ar">Arabic</textLang>
                     <title ref="LIT0124IHA" type="apodous"/>
                     <incipit xml:lang="ar">
                        <locus target="#13r-13v">-13r-13v</locus>قمر عز قد بدى خائزا سابغ النعم| تباشر الكون به من عرب ايضا والعجم| اصل الموجودات البارك سبب فطرة العالم</incipit>
                     <explicit xml:lang="ar">
                        <locus target="#14v">-14v</locus>ما لاح برق في العناية | ودارت كؤس الكرام</explicit>
                     <note/>
                     <note/>
                  </msItem>
                  <msItem xml:id="ms_i3">
                     <locus from="14v" to="17r">14v-17r</locus>
                     <textLang xml:lang="ar">Arabic</textLang>
                     <title ref="LIT0543IHA" type="apodous"/>
                     <incipit xml:lang="ar">
                        <locus target="#14v">-14v</locus>كيف ترقى رقيك الأنبيأ يا سماء ما طاولتها سماء| لم يساوك فى علاك وقد حال سنا منك دونهم وسناء انما</incipit>
                     <explicit xml:lang="ar">
                        <locus target="#17r">-17r</locus>واذ حلت الهداية قلبا| نشطت للعبادة الأعضاء</explicit>
                     <note/>
                     <note/>
                  </msItem>
                  <msItem xml:id="ms_i4">
                     <locus from="17v" to="21r">17v-21r</locus>
                     <textLang xml:lang="ar">Arabic</textLang>
                     <title ref="LIT0482IHA" type="acephalous"/>
                     <incipit xml:lang="ar">
                        <locus target="#17v">-17v</locus>أ[باء]ه كلهم يعلو بمفخره| وكان منتقلا نور المبصره| حتى بدى للوى أية مظهره | أبان مولده عن طيب عنصره يا طيب مفتتح منه ومختتم</incipit>
                     <explicit xml:lang="ar">
                        <locus target="#21r">-21r</locus>تبارك الله ما وحي بمكتسب ولا نبي على غيب بمتهم  </explicit>
                     <note/>
                     <note/>
                  </msItem>
                  <msItem xml:id="ms_i5">
                     <locus from="21r" to="24v">21r-24v</locus>
                     <textLang xml:lang="ar">Arabic</textLang>
                     <title ref="LIT0002IHA"/>
                     <incipit xml:lang="ar">
                        <locus target="#21r">-21r</locus>باب فى ظهوره وعلامته وولادته ورضاعته دعيم الأركان| الذى ولد من الشهر التاسع من سنة خمس| وسبعين وستمأىة وثلاثة ألاف للطوفان</incipit>
                     <explicit xml:lang="ar">
                        <locus target="#24v">-24v</locus>الذى نادى البشير به فى الخلائق اجمعين| وما ارسلناك إلا رحمة للعالمين</explicit>
                     <note/>
                     <note/>
                  </msItem>
