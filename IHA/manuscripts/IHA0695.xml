                  <msItem xml:id="ms_i0">
                     <locus from="3r" to="10v">3r-10v</locus>
                     <textLang xml:lang="ar">Arabic</textLang>
                     <title ref="LIT0136IHA" type="acephalous apodous lacunous"/>
                     <incipit xml:lang="ar">
                        <locus target="#9v">-9v</locus>أقول من بعد افتتاح القول بحمد ذي الطّول الشديد الحول \ وبعده فأفضل السلامِ على النبيّ سيد الأنام \ وءاله الأطهار خير ءال فاحفظ كلامي واستمع مقالي</incipit>
                     <explicit xml:lang="ar">
                        <locus target="#8v">-8v</locus>هذا إذا ما وردت مخفّفه فافهمه عني فهم صافي المعرفه \ أما إذا ما وردت مشدّدة فاالحركات كلها معدّدة</explicit>
                     <note>Disrupted; non systematic interlinear iʻrāb</note>
                     <note/>
                  </msItem>
                  <msItem xml:id="ms_i1">
                     <locus from="11r" to="27v">11r-27v</locus>
                     <textLang xml:lang="ar">Arabic</textLang>
                     <title ref="LIT1516IHA"/>
                     <incipit xml:lang="ar">
                        <locus target="#11v">-11v</locus>بسملة٬ الحمد لله الذي صفى قلوب \ الاولياء من المريدين والمراد بكير الرياضةوالأذكار والاوراد وأمد \ هم بالاعتزال عن الناس في جميع الاماكن والواد وافاض عليهم فيوض</incipit>
                     <explicit xml:lang="ar">
                        <locus target="#24v">-24v</locus>وقالوا ايضا لا يوجد الشيخ الكامل والكبريت الاحمر ءاخر الزمان \ إلا الصلاة على النبي صلى الله عليه وسلم غالبا بل نادرا قلت لا سيما صلاة مجد \ السلام بن مشيش وصلاة محمد البكري الترتسمي بصلاة الفاتح ا هـ</explicit>
                     <note>ff. 25r-27v blank</note>
                     <note/>
                  </msItem>
