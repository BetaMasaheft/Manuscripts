               <msContents>
                  <summary/>
                  <msItem xml:id="ms_i0">
                     <locus from="2r" to="4r">2r-4r</locus>
                     <textLang xml:lang="ar">Arabic</textLang>
                     <title ref="LIT2672IHA"/>
                     <incipit xml:lang="ar">
                        <locus target="#2r">-2r</locus>بسم الله الرحمن الرحيم إن الله وملائكته يصلون على الببي بأيها الذين أمنوا صلوا عليه وسلموا تسليما.
اللهم صل وسلم وبارك على سيدنا ومولانا محمد فتح شهود طهور تكوين موجوداتك محلى</incipit>
                     <explicit xml:lang="ar">
                        <locus target="#4r">-4r</locus>واهدنى بنورك نور اليقين وأيدنى بروح منك يا أرحم الراحمين وأن أعمل صالحا ترصاه وأدخلنى برحمتك فى عبادك الصالحين</explicit>
                     <note/>
                     <note/>
                  </msItem>
                  <msItem xml:id="ms_i1">
                     <locus from="4v" to="7r">4v-7r</locus>
                     <textLang xml:lang="ar">Arabic</textLang>
                     <title ref="LIT2673IHA"/>
                     <incipit xml:lang="ar">
                        <locus target="#4v">-4v</locus>بسم الله الرحمن الرحيم. اللهم صل على سيدنا محمد النور الساطع فى سماء الجلال| والغيث الهامع من كوثر صفاء الجمال| شمس الرحمة الطالعة على كل الأمم</incipit>
                     <explicit xml:lang="ar">
                        <locus target="#7r">-7r</locus>يا واهب النور [؟] نعام| تبارك اسمك يا ذ الحلال والأكرام أنت ولي والدنيا والأخرة توفنى مسلما وألحقنى بالصالحين</explicit>
                     <note/>
                     <note/>
                  </msItem>
                  <msItem xml:id="ms_i2">
                     <locus from="7r" to="8v">7r-8v</locus>
                     <textLang xml:lang="ar">Arabic</textLang>
                     <title ref="LIT2674IHA" type="apodous"/>
                     <incipit xml:lang="ar">
                        <locus target="#7r">-7r</locus>بسم الله الرحمن الرحيم. اللهم صل على وسلم وبارك على سيدنا ومولانا محمد مشكاة الأنوار الرحمانية ونور مصباح الزجاجة المثالية ومعنى الحسان الكامل للمعانى الفرقانية</incipit>
                     <explicit xml:lang="ar">
                        <locus target="#8v">-8v</locus>ومنحنايه رضوانك المقيم| اللهم صل على سيدنا محمد الروح الطاهر الرفيع</explicit>
                     <note/>
                     <note/>
                  </msItem>
