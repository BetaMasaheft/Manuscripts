بدأت قولى بحمد العلى أن وفقنا بمدح نبى</incipit>
                     <explicit xml:lang="ar">
                        <locus target="#37r">-37r</locus>ما هام الصب سكرا بالمدام
وغاب الجذب شدت الغرام</explicit>
                     <note/>
                     <note/>
                  </msItem>
