                  <msItem xml:id="ms_i0">
                     <locus from="1v" to="226v">1v-226v</locus>
                     <textLang xml:lang="ar">Arabic</textLang>
                     <title ref="LIT0049IHA#s39IHA"/>
                     <incipit xml:lang="ar">
                        <locus target="#1v">-1v</locus>بسم الله الرحمن الرحيم

الْحَمْدُ لِلَّهِ الَّذِي أَنزَلَ عَلَى عَبْدِهِ الْكِتَابَ وَلَمْ يَجْعَل لَّهُ عِوَجًا
قَيِّمًا لِّيُنذِرَ بَأْسًا شَدِيدًا مِن لَّدُنْهُ وَيُبَشِّرَ الْمُؤْمِنِينَ الَّذِينَ يَعْمَلُونَ الصَّالِحَاتِ أَنَّ لَهُمْ أَجْرًا حَسَنًا
مَاكِثِينَ فِيهِ أَبَدًا<note>Sūra 18 (al-Kahf), āya 1</note>
                     </incipit>
                     <explicit xml:lang="ar">
                        <locus target="#226v">-226v</locus>بسم الله الرحمن الرحيم قُلْ أَعُوذُ بِرَبِّ النَّاسِ مَلِكِ النَّاسِ إِلَهِ النَّاسِ مِن شَرِّ الْوَسْوَاسِ الْخَنَّاسِ الَّذِي يُوَسْوِسُ فِي صُدُورِ النَّاسِ مِنَ الْجِنَّةِ وَالنَّاسِ
هد الله العظيم وبلغ رسوله الكريم نحن على ذلك من الشاهدين والحمد لله رب العالمين<note>114:6</note>
                     </explicit>
                     <note/>
                     <note/>
                  </msItem>
                  <msItem xml:id="ms_i1">
                     <locus from="227r" to="227r">227r-227r</locus>
                     <textLang xml:lang="ar">Arabic</textLang>
                     <title ref="LIT3953IHA"/>
                     <incipit xml:lang="ar">
                        <locus target="#227r">-227r</locus>اللهم ارحمني بالقرءن العظيم واجعله لي اماما ونورا وهدى ورحمه</incipit>
                     <explicit xml:lang="ar">
                        <locus target="#227r">-227r</locus>وانا النهار واجعله لي حجة يا رب العالمين</explicit>
                     <note/>
                     <note/>
                  </msItem>
                  <msItem xml:id="ms_i2">
                     <locus from="227v" to="228v">227v-228v</locus>
                     <textLang xml:lang="ar">Arabic</textLang>
                     <title ref="LIT4125IHA"/>
                     <incipit xml:lang="ar">
                        <locus target="#227v">-227v</locus>بسم الله الرحمان الرحيم صدق الله العلي العظيم وصدق رسوله النبي الكريم الحي الحليم [...] اللهم انفعنا بالقرأن العظيم واهدنا بالأيات والذكر الحكم وتقبل منا قرءتنا ودعانا ءنك ءنت السمع العليم</incipit>
                     <explicit xml:lang="ar">
                        <locus target="#228v">-228v</locus>وصلى الله تعالى على خير خلقه محمد واله وصحبه اجمعين برحمتك يا ارحم الرحمين. تم دعاء ختم القران</explicit>
                     <note/>
                     <note/>
                  </msItem>
