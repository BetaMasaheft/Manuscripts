               <msContents>
                  <summary/>
                  <msItem xml:id="ms_i0">
                     <locus from="1v" to="2v">1v-2v</locus>
                     <textLang xml:lang="ar">Arabic</textLang>
                     <title ref="LIT1293IHA"/>
                     <incipit xml:lang="ar">
                        <locus target="#1v">-1v</locus>طلع قمر الحب أفاق قلب المحب وسر بلا مثال لمع برق الوداد من غيث ودق الأياد </incipit>
                     <explicit xml:lang="ar">
                        <locus target="#2v">-2v</locus>ميزاب كوثر المدد صباح العرا المؤبد وسر أهل دلال| قررة عين الأحباب كاشف نقاب الحجاب عن وجه ذاك الجمال</explicit>
                     <note/>
                     <note/>
                  </msItem>
                  <msItem xml:id="ms_i1">
                     <locus from="3r" to="5r">3r-5r</locus>
                     <textLang xml:lang="ar">Arabic</textLang>
                     <title ref="LIT1324IHA"/>
                     <incipit xml:lang="ar">
                        <locus target="#3r">-3r</locus>اللهم صل على محمد ٢ سر العالم وسر الوجود اللهم صل على محمد محمد ٢ سر العالم وسر الوجود.
الحمد لله الكريم الجواد| حمدا دائما بغير نفاد| حيث فضلنا بالنبي الهاد| الصلاة والسلام عليه أبد وعلى اله ركع بسجد</incipit>
                     <explicit xml:lang="ar">
                        <locus target="#5r">-5r</locus>وغفر له بعض ضيق سلم نار عن الكين من عند الصرد</explicit>
                     <note/>
                     <note/>
                  </msItem>
                  <msItem xml:id="ms_i2">
                     <locus from="5r" to="12v">5r-12v</locus>
                     <textLang xml:lang="ar">Arabic</textLang>
                     <title ref="LIT1326IHA"/>
                     <incipit xml:lang="ar">
                        <locus target="#5r">-5r</locus>الهم صل على محمد واله وصحبه لسجد.
أصحابه طرا نجوم الاهتدا| أخيار لسعدا أسياد أسياد| أحباء البار اعداء الكفار| تزينت له لهم سبل الرشاد</incipit>
                     <explicit xml:lang="ar">
                        <locus target="#12v">-12v</locus>ما قال المادح بأنواح الأحوال فى مدح سيد مصطفى الوجود. تمت بالخير عمت فى ش م ب ٢ يوما</explicit>
                     <note/>
                     <note/>
                  </msItem>
                  <msItem xml:id="ms_i3">
                     <locus from="16v" to="18v">16v-18v</locus>
                     <textLang xml:lang="ar">Arabic</textLang>
                     <title ref="LIT1449IHA"/>
                     <incipit xml:lang="ar">
                        <locus target="#16v">-16v</locus>اللهم صل على محمد ٢ ميزاب الفيضات | نحمد الله الوهاب ألفاتح للغيوب| أشافي للقلوب سبحان ذا لعزة</incipit>
                     <explicit xml:lang="ar">
                        <locus target="#18v">-18v</locus>وعلى الا الكرام واصحابه الهمام جنود خير الانام نجوم الهداية. ت م ت</explicit>
                     <note/>
                     <note/>
                  </msItem>
                  <msItem xml:id="ms_i4">
                     <locus from="18v " to="22r">18v -22r</locus>
                     <textLang xml:lang="ar">Arabic</textLang>
                     <title ref="LIT0651IHA"/>
                     <incipit xml:lang="ar">
                        <locus target="#18v">-18v</locus>طلع شمس الهدايه| شاملا كل العطايا| تباشر أهل الكون| بكل نور وزين|</incipit>
                     <explicit xml:lang="ar">
                        <locus target="#22r">-22r</locus>ما قال امر البر اليه| طلع شمس الهدايه طفيلكم احمد يبكى| من حواكم يشتكى| يرجو منكم الرضى حبكم عليه فرضى. تمت</explicit>
                     <note/>
                     <note/>
                  </msItem>
