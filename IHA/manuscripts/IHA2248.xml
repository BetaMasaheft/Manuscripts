               <msContents>
                  <summary/>
                  <msItem xml:id="ms_i0">
                     <locus from="1r" to="4v">1r-4v</locus>
                     <textLang xml:lang="ar">Arabic</textLang>
                     <title ref="LIT4439IHA"/>
                     <incipit xml:lang="ar">
                        <locus target="#1r">-1r</locus>بسم الله الرحمن الرحيم | الحمد لله ... وحلاه تحلية النطق والبيان وجعل اللسان ... والصلاة والسلام على من جل من الفصاحة والبلاغة وبعد لما را... تتابع البلا والفتن التي حصلت في بلادنا تحير فيه الحليم وذوي العقول اردت ان اذكر بعض القصص ... فيه أولها ملكها اهل مصر في سنه ١٢٩٢ الي عشر سنين وعمروها واصلحوها</incipit>
                     <explicit xml:lang="ar">
                        <locus target="#4v">-4v</locus>ثم رجع في اليوم ٩ ... للخروج الى زيلع ولا نعرف ما يريد بذلك السفر وخرج يوم السبت من شهر ذي القعد في اليوم ٢١</explicit>
                     <note/>
                     <note/>
                  </msItem>
                  <msItem xml:id="ms_i1">
                     <locus from="5r" to="5r">5r-5r</locus>
                     <textLang xml:lang="ar">Arabic</textLang>
                     <title ref="LIT4441IHA"/>
                     <incipit xml:lang="ar">
                        <locus target="#5r">-5r</locus>تذكرة مبارك إن شاء الله تعالى | نهض جماعة من اكابر الهرر الى نݤس منلك ملك الحبشة وهم الحاج يوسف برخدلي والشيخ على أبو بكر الأمير عبد الشكور</incipit>
                     <explicit xml:lang="ar">
                        <locus target="#5r">-5r</locus>ذلك بواسطة فيت أورار سيد من ذرية سيد بشرى وهذا اما جراى وذلك بتاريخ في جمادي الأولى ٣ سنة ١٣٠٤ هجرة النبوية</explicit>
                     <note/>
                     <note/>
                  </msItem>
               </msContents>
