               <msContents>
                  <summary/>
                  <msItem xml:id="ms_i0">
                     <locus from="1r" to="5v">1r-5v</locus>
                     <textLang xml:lang="ar">Arabic</textLang>
                     <title ref="LIT2299IHA"/>
                     <incipit xml:lang="ar">
                        <locus target="#1r">-1r</locus>ألحمد لله الذي هدانا وختارنا وجتبانا ومن خلقه \ إصطفانا تفضّلا منه وامتنانا وأنزل قرأنا</incipit>
                     <explicit xml:lang="ar">
                        <locus target="#5v">-5v</locus>ربكم أعلم بما فى نفوسكم \ إن تكونوا صالحين فإنّه كان للأوابين غفور \ بارك الله لي ولكم باالقرءن العظيم [...] والبرّ الكريم</explicit>
                     <note/>
                     <note/>
                  </msItem>
                  <msItem xml:id="ms_i1">
                     <locus from="6r" to="9v">6r-9v</locus>
                     <textLang xml:lang="ar">Arabic</textLang>
                     <title ref="LIT1832IHA"/>
                     <incipit xml:lang="ar">
                        <locus target="#6r">-6r</locus>ألحمد لله الواحد الأحد الفرد الصمد الذى لم يلد ولم \ يولد ولم يكون له كفوا أحد نحمد حمدا لا يحدّ \ ونشكره شكرا لايعدّ</incipit>
                     <explicit xml:lang="ar">
                        <locus target="#9v">-9v</locus>وأعطنا بفضلك \ من لدنك رحمة وهي لنا رشدا عباد الله إنّ الله \ يأمر باالعدل والإحسان وإتاء ذالقربى وينهى \ عن الفحشاء والمنكر والبغي يعظكم لعلّكم تذكرون أذكر الله العظيم لي ولكم  [...] والبرّ الكريم</explicit>
                     <note/>
                     <note/>
                  </msItem>
                  <msItem xml:id="ms_i2">
                     <locus from="10r" to="16v">10r-16v</locus>
                     <textLang xml:lang="ar">Arabic</textLang>
                     <title ref="LIT1908IHA"/>
                     <incipit xml:lang="ar">
                        <locus target="#10r">-10r</locus>ألحمد لله الذي جعل الأحال مقادير للأعمار وجعل هذه \ الأعمار مواقين للأعمال وكتب الفلاح لمن شغلها \ باالأعمال الصالحات</incipit>
                     <explicit xml:lang="ar">
                        <locus target="#16v">-16v</locus>أعلم بمن ضلّ عن سبيله وهو أعلم بمن إهتداى ولا تطبع من \ أغفلنا قلبه عن ذكرنا وتبع هواه وكان أمره فرطا بارك الله ولكم [...] من عذابه الأليم</explicit>
                     <note/>
                     <note/>
                  </msItem>
