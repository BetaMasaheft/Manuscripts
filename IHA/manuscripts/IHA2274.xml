               <msContents>
                  <summary/>
                  <msItem xml:id="ms_i0">
                     <locus from="1v" to="2r">1v-2r</locus>
                     <textLang xml:lang="ar">Arabic</textLang>
                     <title ref="LIT4542IHA"/>
                     <incipit xml:lang="ar">
                        <locus target="#1v ">-1v </locus>بسم الله الرحمان الرحيم / بسم الله الفاتح العليم /بسم الله الجواد الكريم</incipit>
                     <explicit xml:lang="ar">
                        <locus target="#2r">-2r</locus>بسم الله المبدأ الباري / بسم الله ذ الجود الجاري</explicit>
                     <note/>
                     <note/>
                  </msItem>
                  <msItem xml:id="ms_i1">
                     <locus from="2r" to="7r">2r-7r</locus>
                     <textLang xml:lang="ar">Arabic</textLang>
                     <title ref="LIT4543IHA"/>
                     <incipit xml:lang="ar">
                        <locus target="#2r">-2r</locus>بسم الله الرحمن الرحيم / اللهم صل على نور الوجود /الحمد لله المنان مفيض مطر الأحسان / معطى النفحات لمعش الشهود</incipit>
                     <explicit xml:lang="ar">
                        <locus target="#7r">-7r</locus>ماصبا محب من غرم وما دار شربي في المقام / على الأحبة بكؤوس الوداد </explicit>
                     <note/>
                     <note/>
                  </msItem>
                  <msItem xml:id="ms_i10">
                     <locus from="20r" to="20v">20r-20v</locus>
                     <textLang xml:lang="ar">Arabic</textLang>
                     <title ref="LIT4553IHA"/>
                     <incipit xml:lang="ar">
                        <locus target="#20r">-20r</locus>اللهم صل على محمد نور الله الهادي الي ذاك الوادي / قد نفتح الباب لما نطوالحجاب فالمنة لله جل [اللد؟] الهادي </incipit>
                     <explicit xml:lang="ar">
                        <locus target="#20v">-20v</locus>صلاة والسلام يا زبدة الأنام عليك والأل بدور العبادي</explicit>
                     <note/>
                     <note/>
                  </msItem>
                  <msItem xml:id="ms_i11">
                     <locus from="20v" to="22r">20v-22r</locus>
                     <textLang xml:lang="ar">Arabic</textLang>
                     <title ref="LIT4554IHA"/>
                     <incipit xml:lang="ar">
                        <locus target="#20v">-20v</locus>اللهم صل على محمد وفتح لنا باب الحضرات / استمطر منك مطر جودك فطلع بنورك يا جوهر الذات</incipit>
                     <explicit xml:lang="ar">
                        <locus target="#22r">-22r</locus>بجاه شيخنا امي محمد البحر الهدى تاج الكرامات / و[بئبنه؟] ايضا محمد ن المذكور الماجد المشهور بين الكائنات</explicit>
                     <note/>
                     <note/>
                  </msItem>
                  <msItem xml:id="ms_i12">
                     <locus from="22r" to="22v">22r-22v</locus>
                     <textLang xml:lang="ar">Arabic</textLang>
                     <title ref="LIT4555IHA"/>
                     <incipit xml:lang="ar">
                        <locus target="#22r">-22r</locus>اللهم صل على محمد خير الوري روضة النزيل / قد فاح في القلب مسك نفحته فراح باالصب لباب الجليل</incipit>
                     <explicit xml:lang="ar">
                        <locus target="#22v">-22v</locus>صلاة تقرأ باب كرمك وترفع شاني في ذاك المجال</explicit>
                     <note/>
                     <note/>
                  </msItem>
                  <msItem xml:id="ms_i13">
                     <locus from="22v" to="23v">22v-23v</locus>
                     <textLang xml:lang="ar">Arabic</textLang>
                     <title ref="LIT4556IHA"/>
                     <incipit xml:lang="ar">
                        <locus target="#22v">-22v</locus>اللهم صل على محمد الهادي الي باب الله الهادي / قد حل في قلب المحب جمال منه هذ الحال في القلوب بادي</incipit>
                     <explicit xml:lang="ar">
                        <locus target="#23v">-23v</locus>ادم يا الهي عليه صلاة وكذا سلاما والأل الأمجادى</explicit>
                     <note/>
                     <note/>
                  </msItem>
                  <msItem xml:id="ms_i14">
                     <locus from="23v" to="24v">23v-24v</locus>
                     <textLang xml:lang="ar">Arabic</textLang>
                     <title ref="LIT4557IHA"/>
                     <incipit xml:lang="ar">
                        <locus target="#23v - 24r">-23v - 24r</locus>اللهم صل على محمد محبوب الجواد نور الله الهادي / لما تجلي ختم الرسالة قد ملأ نورا يا صاح فؤدي</incipit>
                     <explicit xml:lang="ar">
                        <locus target="#24v">-24v</locus>وعلى أله الكرام البررة وصحبه أيضا نجوم الرشادي</explicit>
                     <note/>
                     <note/>
                  </msItem>
                  <msItem xml:id="ms_i15">
                     <locus from="25r" to="25v">25r-25v</locus>
                     <textLang xml:lang="ar">Arabic</textLang>
                     <title ref="LIT4558IHA"/>
                     <incipit xml:lang="ar">
                        <locus target="#25r">-25r</locus>اللهم صل على محمد خير الورى جوهار الأنام / كوثر الكرم جوهر الأمم جمال العالم سلطان الكرام</incipit>
                     <explicit xml:lang="ar">
                        <locus target="#25v">-25v</locus>وكذك على اله الكرما شموش دين الله الصحب الكرام</explicit>
                     <note/>
                     <note/>
                  </msItem>
                  <msItem xml:id="ms_i16">
                     <locus from="25v" to="27r">25v-27r</locus>
                     <textLang xml:lang="ar">Arabic</textLang>
                     <title ref="LIT4559IHA"/>
                     <incipit xml:lang="ar">
                        <locus target="#25v - 26r">-25v - 26r</locus>اللهم صل على محمد شمس العالم باب الله الأعظم / باب الله العظيم عليه نزدحم تاج مكرم وعيد معظم</incipit>
                     <explicit xml:lang="ar">
                        <locus target="#27r">-27r</locus>ما قال قائل وطاب واصل وراح كامل في المغني المعظم</explicit>
                     <note/>
                     <note/>
                  </msItem>
                  <msItem xml:id="ms_i17">
                     <locus from="27r" to="28r">27r-28r</locus>
                     <textLang xml:lang="ar">Arabic</textLang>
                     <title ref="LIT4560IHA"/>
                     <incipit xml:lang="ar">
                        <locus target="#27r">-27r</locus>اللهم صل على محمد سيدنا ذ الجمال [البا؟] / سيدي سيدي يا قبله القلب يا مفتاح الغيب يا نبي الله</incipit>
                     <explicit xml:lang="ar">
                        <locus target="#28r">-28r</locus>ومادار الكؤس من حضرة القدس وسكان ذاك الأنس أحبت الله</explicit>
                     <note/>
                     <note/>
                  </msItem>
                  <msItem xml:id="ms_i18">
                     <locus from="28r" to="29v">28r-29v</locus>
                     <textLang xml:lang="ar">Arabic</textLang>
                     <title ref="LIT4561IHA"/>
                     <incipit xml:lang="ar">
                        <locus target="#28r - 28v">-28r - 28v</locus>اللهم صل على محمد نوربدا ما له مثال / تجلني جمال ما له مثل لما زاح الحجب ولاح الجمال</incipit>
                     <explicit xml:lang="ar">
                        <locus target="#29v">-29v</locus>وماحد حاد باسمك يا هادي وماغن الصادي بشرب الوصال</explicit>
                     <note/>
                     <note/>
                  </msItem>
                  <msItem xml:id="ms_i19">
                     <locus from="29v" to="30v">29v-30v</locus>
                     <textLang xml:lang="ar">Arabic</textLang>
                     <title ref="LIT4562IHA"/>
                     <incipit xml:lang="ar">
                        <locus target="#29v">-29v</locus>اللهم صل على محمد نبيك خيرا لبريات / نعم البحر الحاوى كل الكمالات نعم البدر الساري في برج الوحدة</incipit>
                     <explicit xml:lang="ar">
                        <locus target="#30v">-30v</locus>فلحمد لله هذا مطلبي زد منه يا ربي وادم وصلتي</explicit>
                     <note/>
                     <note/>
                  </msItem>
                  <msItem xml:id="ms_i2">
                     <locus from="7r" to="10v">7r-10v</locus>
                     <textLang xml:lang="ar">Arabic</textLang>
                     <title ref="LIT4545IHA"/>
                     <incipit xml:lang="ar">
                        <locus target="#7r">-7r</locus>صلى الله على محمد والأل والصحب الكرام / تجلى بدر من حرم علينا يا هل الكرم / قد صبا العقل حسنه كيف لا [وحوى؟] الكرم</incipit>
                     <explicit xml:lang="ar">
                        <locus target="#10v">-10v</locus>ما لاح النور من حرم وفاض الجود والكرم / ما دام أروح الكرم بخمر الوصل والمدم</explicit>
                     <note/>
                     <note/>
                  </msItem>
                  <msItem xml:id="ms_i20">
                     <locus from="31r" to="32r">31r-32r</locus>
                     <textLang xml:lang="ar">Arabic</textLang>
                     <title ref="LIT4563IHA"/>
                     <incipit xml:lang="ar">
                        <locus target="#31r">-31r</locus>اللهم صل على محمد نور أضا به كل العالم / بنور أضأ البيت والحرم عند ما تبد بدره في الحرم</incipit>
                     <explicit xml:lang="ar">
                        <locus target="#32r">-32r</locus>كذا لإخوتي ولزيتي والأحبتي في لكل العالم</explicit>
                     <note/>
                     <note/>
                  </msItem>
                  <msItem xml:id="ms_i21">
                     <locus from="32r" to="35v">32r-35v</locus>
                     <textLang xml:lang="ar">Arabic</textLang>
                     <title ref="LIT4564IHA"/>
                     <incipit xml:lang="ar">
                        <locus target="#32r">-32r</locus> اللهم صل على محمد ساقي أهل الحضارة شرابا طهورا / الهمد لله ذ الفيض المدرار ثم صلاته على الجود الجاري</incipit>
                     <explicit xml:lang="ar">
                        <locus target="#35v">-35v</locus>ما لاح في القلب نور برق الغيب وقام الصب في باب تلك الحضرة</explicit>
                     <note/>
                     <note/>
                  </msItem>
                  <msItem xml:id="ms_i22">
                     <locus from="35v" to="37r">35v-37r</locus>
                     <textLang xml:lang="ar">Arabic</textLang>
                     <title ref="LIT4566IHA"/>
                     <incipit xml:lang="ar">
                        <locus target="#35v">-35v</locus> اللهم صل على محمد خير الوراى شمس اهل الحضرة / نبي الرحمة معدن الحكمة جنة الراحة سلسبيل الحضرة</incipit>
                     <explicit xml:lang="ar">
                        <locus target="#37r">-37r</locus>وعلى الأل والأصحاب الكمالا سلاطين الولا وأبواب الحضرة </explicit>
                     <note/>
                     <note/>
                  </msItem>
                  <msItem xml:id="ms_i23">
                     <locus from="37r" to="39r">37r-39r</locus>
                     <textLang xml:lang="ar">Arabic</textLang>
                     <title ref="LIT4567IHA"/>
                     <incipit xml:lang="ar">
                        <locus target="#37r">-37r</locus>اللهم صل على محمد عدد ما جراى للوح والقلم / الحمد لله المولا على [ماأولانا؟] وجاد منه وفضلا علينا</incipit>
                     <explicit xml:lang="ar">
                        <locus target="#39r">-39r</locus>ثم صلاة الله على نبيه محمد الهادي إلي من ضاتهو/ الأل والصحب الهداة النجوم</explicit>
                     <note/>
                     <note/>
                  </msItem>
                  <msItem xml:id="ms_i24">
                     <locus from="39r" to="41v">39r-41v</locus>
                     <textLang xml:lang="ar">Arabic</textLang>
                     <title ref="LIT4568IHA"/>
                     <incipit xml:lang="ar">
                        <locus target="#39r">-39r</locus>اللهم صل على محمد سيدنا غياة المني / سيد الوجود جنة الشهود وباب ورود قوم واصلين</incipit>
                     <explicit xml:lang="ar">
                        <locus target="#41v">-41v</locus>وما طال الوقوف على ذالك السوح وينتظر ذخول مع الداخلين</explicit>
                     <note/>
                     <note/>
                  </msItem>
                  <msItem xml:id="ms_i25">
                     <locus from="41v" to="43r">41v-43r</locus>
                     <textLang xml:lang="ar">Arabic</textLang>
                     <title ref="LIT4569IHA"/>
                     <incipit xml:lang="ar">
                        <locus target="#41v">-41v</locus>اللهم صل على محمد نور ذ الجلال جمال جمال / نور الله المبين شراب المحبين تاج المقربين إلي ذ الجلال</incipit>
                     <explicit xml:lang="ar">
                        <locus target="#43r">-43r</locus>والسلام عليه وعلى أله أيضا وصحبه أنجم الدلال</explicit>
                     <note/>
                     <note/>
                  </msItem>
                  <msItem xml:id="ms_i26">
                     <locus from="43r" to="43v">43r-43v</locus>
                     <textLang xml:lang="ar">Arabic</textLang>
                     <title ref="LIT4570IHA"/>
                     <incipit xml:lang="ar">
                        <locus target="#43r">-43r</locus>اللهم صل على محمد سراج قد أضا به هذ العالم / باب مدخلنا تاج حلتنا كأس خمرتنا راح روح الكرام</incipit>
                     <explicit xml:lang="ar">
                        <locus target="#43v">-43v</locus>في قلب الفضلا سرنيل نجلا ذاك البدر الاتم [.?.] </explicit>
                     <note/>
                     <note/>
                  </msItem>
                  <msItem xml:id="ms_i27">
                     <locus from="43v" to="44v">43v-44v</locus>
                     <textLang xml:lang="ar">Arabic</textLang>
                     <title ref="LIT4571IHA"/>
                     <incipit xml:lang="ar">
                        <locus target="#43v">-43v</locus>اللهم صل على محمد بحر كرمك محل سرك / نقطة إيجاد كل المخلوقات قاسم الهبات في كل خلقك</incipit>
                     <explicit xml:lang="ar">
                        <locus target="#44v">-44v</locus>[ما دام يقول أسير المحبة يا جمال الوراي [وصكرصلك؟</explicit>
                     <note/>
                     <note/>
                  </msItem>
                  <msItem xml:id="ms_i28">
                     <locus from="44v" to="46r">44v-46r</locus>
                     <textLang xml:lang="ar">Arabic</textLang>
                     <title ref="LIT4572IHA"/>
                     <incipit xml:lang="ar">
                        <locus target="#44v">-44v</locus>اللهم صل على محمد وفتح لنا بب الحضارة / أول المخلوقات جوهر بحر الذت باب تلك الهبات مشرب الهداة</incipit>
                     <explicit xml:lang="ar">
                        <locus target="#46r">-46r</locus>ما دام المحب يسبح بحره ورتفع المجب عن أهل الحضرة</explicit>
                     <note/>
                     <note/>
                  </msItem>
                  <msItem xml:id="ms_i29">
                     <locus from="46r" to="48v">46r-48v</locus>
                     <textLang xml:lang="ar">Arabic</textLang>
                     <title ref="LIT4574IHA"/>
                     <incipit xml:lang="ar">
                        <locus target="#46r">-46r</locus>اللهم صل على محمد جمال بهي نور معظم / أشرق في القلب عن وجهه الجمال في ذالك المجال نور معظم</incipit>
                     <explicit xml:lang="ar">
                        <locus target="#48v">-48v</locus>ما قال قائل في ظل جاههم في الدنيا والآخراي إذهان القيام</explicit>
                     <note/>
                     <note/>
                  </msItem>
                  <msItem xml:id="ms_i3">
                     <locus from="11r" to="12v">11r-12v</locus>
                     <textLang xml:lang="ar">Arabic</textLang>
                     <title ref="LIT4546IHA"/>
                     <incipit xml:lang="ar">
                        <locus target="#11r">-11r</locus>اللهم صل على محمد شراب الصفا مصطفى مصطفى / الحمد لله من على العالم بجوهر الكرم سيدي مصطفى / لكن عناية الباري خصت منهم للحضرة قوما تركو صلافا </incipit>
                     <explicit xml:lang="ar">
                        <locus target="#12v">-12v</locus>صل عليه الله ما صبت إلي الله أرواح أهل الله أرباب المعرفا / وعلى أله الكرام البررة(؟) والصحب الخير نجوم أهل الوفا</explicit>
                     <note/>
                     <note/>
                  </msItem>
                  <msItem xml:id="ms_i30">
                     <locus from="48v" to="50r">48v-50r</locus>
                     <textLang xml:lang="ar">Arabic</textLang>
                     <title ref="LIT4578IHA"/>
                     <incipit xml:lang="ar">
                        <locus target="#48v">-48v</locus>الصلاة والسلام على صلاة والسلام على من رقا حضرة العلى / جنة أهل الإتصال لذة شراب الوصال وباب كل معتلي</incipit>
                     <explicit xml:lang="ar">
                        <locus target="#50r">-50r</locus>ما ذاب للب شوقكا وشتاق صب وصلكا سيدي يا تاج الملا
</explicit>
                     <note/>
                     <note/>
                  </msItem>
                  <msItem xml:id="ms_i31">
                     <locus from="50v" to="51v">50v-51v</locus>
                     <textLang xml:lang="ar">Arabic</textLang>
                     <title ref="LIT4579IHA"/>
                     <incipit xml:lang="ar">
                        <locus target="#50v">-50v</locus>اللهم صل على محمد وسلم وبارك عليه وأله أجمعين / الحمد لله فاتح الأبواب رافع الحجاب عن قلوب كل المؤمنين</incipit>
                     <explicit xml:lang="ar">
                        <locus target="#51v">-51v</locus>وهتزت الروح إذ نور يلوح من سمإ الحضرة في سمإ قلب العارفين</explicit>
                     <note/>
                     <note/>
                  </msItem>
                  <msItem xml:id="ms_i32">
                     <locus from="51v" to="53r">51v-53r</locus>
                     <textLang xml:lang="ar">Arabic</textLang>
                     <title ref="LIT4580IHA"/>
                     <incipit xml:lang="ar">
                        <locus target="#51v">-51v</locus>اللهم صل على محمد محمد الهادي سر ذاك الوادي / الحمد لله الطيف الها د ي مرشد العباد دائم الأيا د ي</incipit>
                     <explicit xml:lang="ar">
                        <locus target="#53r">-53r</locus>طراز الأنبيا بستان الأوليا مربح الأصفيا سوق ذاك [لناد؟]</explicit>
                     <note/>
                     <note/>
                  </msItem>
                  <msItem xml:id="ms_i33">
                     <locus from="53r" to="56r">53r-56r</locus>
                     <textLang xml:lang="ar">Arabic</textLang>
                     <title ref="LIT4581IHA"/>
                     <incipit xml:lang="ar">
                        <locus target="#53r">-53r</locus>الصلاة والسلام عليك والأل وصحابة يا شمس في المدينة / يا شمس في المدينة أشرقت كل الظلمة من قلوب الأحبة </incipit>
                     <explicit xml:lang="ar">
                        <locus target="#56r">-56r</locus>صلاة تحسن الختام وتلحقنا بالكرام أهل مجدر الرفعة</explicit>
                     <note/>
                     <note/>
                  </msItem>
                  <msItem xml:id="ms_i4">
                     <locus from="12v" to="14r">12v-14r</locus>
                     <textLang xml:lang="ar">Arabic</textLang>
                     <title ref="LIT4547IHA"/>
                     <incipit xml:lang="ar">
                        <locus target="#12v">-12v</locus>اللهم صل علي محمد شراب أطربا قلوب الأحباب / جواد جلد باالقرب والأمداد وباب مدخل جيوش الأحباب</incipit>
                     <explicit xml:lang="ar">
                        <locus target="#13v - 14r">-13v - 14r</locus>ما فاض علينا شراب من مدد من سيد محمد عابد الوهاب / من سيد محمد عابد الوهاب بحر الهدى [امين] نبي [امين] نبي </explicit>
                     <note/>
                     <note/>
                  </msItem>
                  <msItem xml:id="ms_i5">
                     <locus from="14r" to="15r">14r-15r</locus>
                     <textLang xml:lang="ar">Arabic</textLang>
                     <title ref="LIT4548IHA"/>
                     <incipit xml:lang="ar">
                        <locus target="#14r">-14r</locus>اللهم صل على محمد نور [اضاهل؟] العالمين / ولما تجلي ختم النبين زاح الغي به عن العالمين</incipit>
                     <explicit xml:lang="ar">
                        <locus target="#15r">-15r</locus>ما حن المحب ونفتح الباب وتصل الحب وصلا مستبينا</explicit>
                     <note/>
                     <note/>
                  </msItem>
                  <msItem xml:id="ms_i6">
                     <locus from="15r" to="16r">15r-16r</locus>
                     <textLang xml:lang="ar">Arabic</textLang>
                     <title ref="LIT4549IHA"/>
                     <incipit xml:lang="ar">
                        <locus target="#15r">-15r</locus>اللهم صل على محمد نور تنور خلقه الجليل / قد لاح علينا بارق الكرم من صوب الحرم فضأ المجال</incipit>
                     <explicit xml:lang="ar">
                        <locus target="#16r">-16r</locus>ما جر الدمع من العين والقلب وتولي كربي منك يا جمال </explicit>
                     <note/>
                     <note/>
                  </msItem>
                  <msItem xml:id="ms_i7">
                     <locus from="16r" to="17v">16r-17v</locus>
                     <textLang xml:lang="ar">Arabic</textLang>
                     <title ref="LIT4550IHA"/>
                     <incipit xml:lang="ar">
                        <locus target="#16r">-16r</locus>اللهم صل علي محمد أحمد خير الوري عروس الكمال / برق في قلبي نورك يا نبي من سماء الغيب من مرءة الحال</incipit>
                     <explicit xml:lang="ar">
                        <locus target="#17v">-17v</locus>ما احرم العشاق بصلاة التلاق وهامو من أصول ذاك المجال</explicit>
                     <note/>
                     <note/>
                  </msItem>
                  <msItem xml:id="ms_i8">
                     <locus from="17v" to="18v">17v-18v</locus>
                     <textLang xml:lang="ar">Arabic</textLang>
                     <title ref="LIT4551IHA"/>
                     <incipit xml:lang="ar">
                        <locus target="#17v">-17v</locus>اللهم صل على محمد خير الورى جنة الوصال / قبلة المصلى في مسجد الحضرة مرءة المستجلي جمال الجمال</incipit>
                     <explicit xml:lang="ar">
                        <locus target="#18v">-18v</locus>أنخت ركبي عزمي وهمتي بحمي ساداتي حرم الكمال</explicit>
                     <note/>
                     <note/>
                  </msItem>
                  <msItem xml:id="ms_i9">
                     <locus from="19r" to="20r">19r-20r</locus>
                     <textLang xml:lang="ar">Arabic</textLang>
                     <title ref="LIT4552IHA"/>
                     <incipit xml:lang="ar">
                        <locus target="#19r">-19r</locus>اللهم صل على محمد نور أنوار الله وبحرس الله / نور برز من كنه غيب الله فصار مظهر الظهورات الله </incipit>
                     <explicit xml:lang="ar">
                        <locus target="#20r">-20r</locus>كرم الله ومارح الكامل لزيارة الله وما طاب [المحب؟] بارافاع الحجب / وذاب منه للب بخمر وصل الله</explicit>
                     <note>Second half of the final verse seems to have been left out.</note>
                     <note/>
                  </msItem>
