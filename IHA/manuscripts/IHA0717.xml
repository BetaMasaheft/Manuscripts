               <msContents>
                  <summary/>
                  <msItem xml:id="ms_i0">
                     <locus from="2r" to="4v">2r-4v</locus>
                     <textLang xml:lang="ar">Arabic</textLang>
                     <title ref="LIT1625IHA" type="acephalous lacunous"/>
                     <incipit xml:lang="ar">
                        <locus target="#2r">-2r</locus>وان حمله من مريض شفاه الله وإن حمله محبه نجا| ه الله من [...] وإن حمله راكب البحر من الغرق ومن</incipit>
                     <explicit xml:lang="ar">
                        <locus target="#4v">-4v</locus>وما تأخر وما أن نظهرين من الذنوب وإلى الخيطابا كما يظهر الثوب الأيض من الدنس الالماء انك على عد شي قدير وصلى الله على سيدنا محمد وعلى أله وصحبه وسلم تمت</explicit>
                     <note/>
                     <note/>
                  </msItem>
                  <msItem xml:id="ms_i1">
                     <locus from="5r" to="5v">5r-5v</locus>
                     <textLang xml:lang="ar">Arabic</textLang>
                     <title ref="LIT1629IHA" type="acephalous"/>
                     <incipit xml:lang="ar">
                        <locus target="#5r">-5r</locus>ية من الله تعلى الى محمد صلى عليه وسلم  والد [امته] ومن لم يقرهم الدعاء  وشك فيه فقد كفر ليعاذ باالله ومن قرء هذ الدعاء فى اول شهر رمصان او فى وسطه او فى اخره يخاف الله تعلى</incipit>
                     <explicit xml:lang="ar">
                        <locus target="#5v">-5v</locus>وقد علمه اما تبارك لك وتعلى وهذا هو الدعاء المبارك مسئلة إذ قيل لك قائد كم شهر سنة ءثنا عشر شهر وكم جمعة ثمانية وءربعون وكم يومه ثلثمأة وستين</explicit>
                     <note/>
                     <note/>
                  </msItem>
                  <msItem xml:id="ms_i2">
                     <locus from="6r" to="6r">6r-6r</locus>
                     <textLang xml:lang="ar">Arabic</textLang>
                     <title ref="LIT1627IHA"/>
                     <incipit xml:lang="ar">
                        <locus target="#6r">-6r</locus>بسم الله الرحمن الرحيم قال رسول الله صلى الله عليه وسلم من قرء هذ الدعاء مرة واحدة حرم الله جسده على النار </incipit>
                     <explicit xml:lang="ar">
                        <locus target="#6r">-6r</locus>اللهم صلى على سيدنا محمد صلاة أنت لها اهل ومولها هذ الكروب وعلى اله وصحبه وسلم الف مرة اللهم صلى على سيدنا محمد وكان نور ذاة ي وسرسار له فى ما ار لأسمري رصفاة وصحو محمد محمد</explicit>
                     <note/>
                     <note/>
                  </msItem>
                  <msItem xml:id="ms_i3">
                     <locus from="6v" to="6v">6v-6v</locus>
                     <textLang xml:lang="ar">Arabic</textLang>
                     <title ref="LIT1626IHA" type="apodous"/>
                     <incipit xml:lang="ar">
                        <locus target="#6v">-6v</locus>بسم الله الرحمن الرحيم وصلى الله على سيدنا محمد وعلى اله وصحبه وسلم يا كثير النوال ويا دائمر الوصال وحسن الفعال</incipit>
                     <explicit xml:lang="ar">
                        <locus target="#6v">-6v</locus>لا اله الا الله محمد رسول الله صلى الله عليه وسلم إن دخل النظرات والوسوسة على صدرى ولم أعلم به أعلمت تبت عنه وأقول لا اله الا الله محمد رسول الله عليه وسلم إن دخل ثبيه فى معرفتى بك ولم</explicit>
                     <note/>
                     <note/>
                  </msItem>
