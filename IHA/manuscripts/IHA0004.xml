                  <msItem xml:id="ms_i0">
                     <locus from="1v" to="4v">1v-4v</locus>
                     <textLang xml:lang="ar">Arabic</textLang>
                     <title ref="LIT0005IHA"/>
                     <incipit xml:lang="ar">
                        <locus target="#1v">-1v</locus>بسم الله الرحمن الرحيم وصلى الله على سيدنا محمد واله وصحبه وسلم اللهم اني اسألك بحرمة المصطفى صلى الله عليه وسلم وبحرمة ابي بكر</incipit>
                     <explicit xml:lang="ar">
                        <locus target="#4r">-4r</locus>برخمتك يا ارحم الراحمين وصلى الله على سيدنا محمد واله وصحبه وسلم امين اميت تمت</explicit>
                     <note/>
                     <note/>
                  </msItem>
                  <msItem xml:id="ms_i1">
                     <locus from="6r" to="92r">6r-92r</locus>
                     <textLang xml:lang="ar">Arabic</textLang>
                     <title ref="LIT0086IHA"/>
                     <incipit xml:lang="ar">
                        <locus target="#6r">-6r</locus>بسم الله الرحمن الرحيم اسماء سيدنا ومولانا محمد صلى الله عليه وسلم ماتان وواحدة وهي محمد احمد حامد محمود احيد</incipit>
                     <explicit xml:lang="ar">
                        <locus target="#92r">-92r</locus>وصلى الله على سيدنا محمد خاتم النبيين والمرسلين [...] اللهم اغفر لمؤلف وارحمه واجعله من المحشورين في زمرة النبيين والصدقين يوم القيامة بفضلك يا رحمن</explicit>
                     <note>The text begins from the Asmā' Sayyidinā Muḥammad</note>
                     <note/>
                  </msItem>
