               <msContents>
                  <summary/>
                  <msItem xml:id="ms_i0">
                     <locus from="1r" to="15v">1r-15v</locus>
                     <textLang xml:lang="ar">Arabic</textLang>
                     <title ref="LIT4533IHA" type="apodous"/>
                     <incipit xml:lang="ar">
                        <locus target="#1v">-1v</locus>بسم الله الرحمان الرحيم وبه نستعين \ الحمج لله الحميد المجيد الواحد الصمد المبدي المعيد الفعال \ لما يريد الذى احاط بكل شي علما واحصا بكل شى عددا له \ كل شى مسبحات والشمس والقمر والنجوم بامره مسخرات وما قدره</incipit>
                     <explicit xml:lang="ar">
                        <locus target="#15v">-15v</locus>ولاتقنطوا من رحمة الله واحفظوا بسم الله الرحمان الرحيم \ تحفظوا من الشياطين وتسموا من الذاكرين المقربين \ الذين يعرفونهم ويذكرونهم في الملكوت الأعاى بالرفعو والشرف</explicit>
                     <note/>
                     <note/>
                  </msItem>
                  <msItem xml:id="ms_i1">
                     <locus from="16r" to="42v">16r-42v</locus>
                     <textLang xml:lang="ar">Arabic</textLang>
                     <title ref="LIT4534IHA"/>
                     <incipit xml:lang="ar">
                        <locus target="#16r">-16r</locus>بسم الله الرحمان الرحيم ذكر وفات النبي صلى الله [عليه وسلم] \ [قال] ابن عباس رضي الله تعالى عنه لما حج النبي صلى الله عليه وسلم حجة الود[...] \ ورجع إلى مدينة مطمين القلب مما أعطاه الله تعالى من عز وجلة وكرامـ[...]ا</incipit>
                     <explicit xml:lang="ar">
                        <locus target="#42v">-42v</locus>واكون معك فيها \ مونسا محدثا وانا مع روحك الي يوم القيمة اجيب لك \ جميع اهلك ووالديك ثم خرج عني فطرت روحي \ من جسدي يا اخي يا سلمان جزا الله سيدنا محمد صلى</explicit>
                     <note/>
                     <note/>
                  </msItem>
