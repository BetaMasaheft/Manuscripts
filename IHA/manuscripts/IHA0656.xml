               <msContents>
                  <summary/>
                  <msItem xml:id="ms_i0">
                     <locus from="1r" to="3r">1r-3r</locus>
                     <textLang xml:lang="ar">Arabic</textLang>
                     <title ref="LIT1446IHA"/>
                     <incipit xml:lang="ar">
                        <locus target="#1r">-1r</locus>صل لله عليك يا أحمد طه مجتبا وسلم عليك شمس داريا دبى.
لاح برق عجبا| على اهل المحبا| برق نواح الغيبا| لمعه عجائبا</incipit>
                     <explicit xml:lang="ar">
                        <locus target="#3r">-3r</locus>صلاة وتسليم على كنز الأحبا| محمد مكرام مع الأل ولصحبا</explicit>
                     <note/>
                     <note/>
                  </msItem>
                  <msItem xml:id="ms_i1">
                     <locus from="3v" to="6v">3v-6v</locus>
                     <textLang xml:lang="om-Arab">Oromo</textLang>
                     <title ref="LIT1440IHA"/>
                     <incipit xml:lang="ar">
                        <locus target="#3v">-3v</locus>صلى لله عليك يا طه شمس مدينا وصلى ما عليك يا شراب قلوبنا.
دبى قبرى عجبا| أسمعو أخوننا</incipit>
                     <explicit xml:lang="ar">
                        <locus target="#6v">-6v</locus>وطول عمورنا| وأصلح اخواننا |وأحسن لنا| ختمنا بجاه ه| [أستامدينا] تمت </explicit>
                     <note/>
                     <note/>
                  </msItem>
                  <msItem xml:id="ms_i2">
                     <locus from="7r" to="11r">7r-11r</locus>
                     <textLang xml:lang="ar">Arabic</textLang>
                     <title ref="LIT1444IHA"/>
                     <incipit xml:lang="ar">
                        <locus target="#7r">-7r</locus>هبت صبا الحب من نواح الغيب احمد لأزل من نسل عدنان| قد لاح وفاح مسكي لأطيب هذ بلا ريب فى كل لزمان</incipit>
                     <explicit xml:lang="ar">
                        <locus target="#11r">-11r</locus>أ صلاة وسلام على نور لأعظم طه باب لكرام مسيد؟؟؟ وعلى أله وصحبه لأكرام نجم دين لأسلام| أملم الأمين بعون لله تعلى يوم اربع. تمت</explicit>
                     <note/>
                     <note/>
                  </msItem>
                  <msItem xml:id="ms_i3">
                     <locus from="11r" to="12r">11r-12r</locus>
                     <textLang xml:lang="ar">Arabic</textLang>
                     <title ref="LIT1443IHA"/>
                     <incipit xml:lang="ar">
                        <locus target="#11r">-11r</locus>الحمد لله من لنا رسول| مصطفى حيات العالم | يا سيد الوريا نعمة الكبرر| علين الصلاة وسلام</incipit>
                     <explicit xml:lang="ar">
                        <locus target="#12r">-12r</locus>أحمد بمصطفى معين لضعف| ياله شفاء الأسقام| أحمد يا محتب فكن ى طيبا| فى للمحد ذاك الظلا ...م</explicit>
                     <note/>
                     <note/>
                  </msItem>
                  <msItem xml:id="ms_i4">
                     <locus from="12v" to="15v">12v-15v</locus>
                     <textLang xml:lang="om-Arab">Oromo</textLang>
                     <title ref="LIT1442IHA"/>
                     <incipit xml:lang="ar">
                        <locus target="#12v">-12v</locus>أنصتو اسمعو اخواننا فى لله| يا  ايها [ناسر] رحمكم لله</incipit>
                     <explicit xml:lang="ar">
                        <locus target="#15v">-15v</locus>أى ح كيس جز محمد محبوب| لال محبا ساكن نم جدب بل شراب عذب أصل كنوزه

</explicit>
                     <note/>
                     <note/>
                  </msItem>
