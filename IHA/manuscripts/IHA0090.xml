               <msContents>
                  <summary/>
                  <msItem xml:id="ms_i0">
                     <locus from="1v" to="6r">1v-6r</locus>
                     <textLang xml:lang="ar">Arabic</textLang>
                     <title ref="LIT0132IHA"/>
                     <incipit xml:lang="ar">
                        <locus target="#1v">-1v</locus>بسم الله الرحمن الرحيم الحمد لله الكريم للتعال ذي الجمال والجلال المتصفيا لكمال في الماضى بلا بداية والحال والاستقبال بلا نهاية ولا زوال ونحمده سبحانه وتعلى وجل جلاله وشكره على ما اولانا من نعمه</incipit>
                     <explicit xml:lang="ar">
                        <locus target="#6r">-6r</locus>اذ ارريد  الاصل وهو تقدم العامل على المعول و الا بلغ عكسه وان كان فيه عمل المصدر محذوفا ومؤخرا  لجوازه في الظرف وعديله</explicit>
                     <note>An excerpt. There are references in the notes to other unidentified works </note>
                     <note/>
                  </msItem>
                  <msItem xml:id="ms_i1">
                     <locus from="11v" to="51r">11v-51r</locus>
                     <textLang xml:lang="ar">Arabic</textLang>
                     <title ref="LIT0134IHA" type="lacunous"/>
                     <incipit xml:lang="ar">
                        <locus target="#10v">-10v</locus>بسم الله الرمحان الرحيم الحمد لله الذي بين لنا الحلال والحرام واوجب علينا معرفة ذلك ليجتنب الحرام من الاموال وللاقوال والافعال والاحوال</incipit>
                     <explicit xml:lang="ar">
                        <locus target="#51r">-51r</locus>ولكنها محبوب لكثير من خلق الله مزرعة للماخرة ان ابغضوها واحترز وعنها لخبر اخدمي من خد منى مهلكة في الاخرة ان احبوها واتبعوها لخبر واتعبى من خدمك والسلام على من اتبع الهدى جعلنا الله ممن اهتدى واقتدى يحاه نبينا ومولانا محمد صلى الله عليه وسلم وعلى اله واصحابه واهل بيته وذريته اجمعين وعلى جميع اخوانه من الانبياء والمرسلين وعلى جميع الملئكة ولمقربين والتابعين له باحسان الى يوم الدين ورضى الله عنهم اجمعين سبحان ربك رب العزة عما يصفون وسلام على المرسلين والحمد لله</explicit>
                     <note>Some of the words are divided into two different lines
</note>
                     <note/>
                  </msItem>
