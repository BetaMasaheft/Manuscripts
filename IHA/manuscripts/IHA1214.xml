               <msContents>
                  <summary>ff. 55v-58v blank</summary>
                  <msItem xml:id="ms_i0">
                     <locus from="1r" to="7v">1r-7v</locus>
                     <textLang xml:lang="ar">Arabic</textLang>
                     <title ref="LIT2688IHA"/>
                     <incipit xml:lang="ar">
                        <locus target="#1r">-1r</locus>بسملة٬ حمدلة \ أما بعد فاعلم إنّ سند القوم فى \ تلقين الأذكار والإجازة فى \ الطريقة ما رواه إمامنا أحمد \ بن حنبل والطبراني والبزار بسند \ صحيح ان رسول الله </incipit>
                     <explicit xml:lang="ar">
                        <locus target="#7r">-7r</locus>عن \ شيخه حبيب العجمي عن شيخه الحسن البصري عن أمير المؤمنين \ علي بن أبي طالب كرم الله وجهه عن رسول الله صلى الله عليه وسلم \ عن جبريل عليه السلام عن رب العزة سبحانه وتعالى إنتهى</explicit>
                     <note>f. 7v blank</note>
                     <note/>
                  </msItem>
                  <msItem xml:id="ms_i1">
                     <locus from="8r" to="16r">8r-16r</locus>
                     <textLang xml:lang="ar">Arabic</textLang>
                     <title ref="LIT2729IHA"/>
                     <incipit xml:lang="ar">
                        <locus target="#8r">-8r</locus>بسم الله الرحمان الرحيم \ بسم الله بسم الله يا رب يا كريم \ بسم الله بسم الله يا حيّ يا عظيم \ ملك يوم الدين قربنا بالنعيم
</incipit>
                     <explicit xml:lang="ar">
                        <locus target="#16r">-16r</locus>صلّ \ مولانا على النبي والصحب سلم \ عليه وأرضه الحمد لله \ تمم لي معطّرا</explicit>
                     <note/>
                     <note/>
                  </msItem>
                  <msItem xml:id="ms_i10">
                     <locus from="32r" to="35v">32r-35v</locus>
                     <textLang xml:lang="ar">Arabic</textLang>
                     <title ref="LIT2748IHA" type="apodous"/>
                     <incipit xml:lang="ar">
                        <locus target="#32r">-32r</locus>بسملة \ الحمد لله ذا العلاء والفضل \ والنعم العزيز \ إنى سأنظم معجزة الخاتم \ الأنبيا الأخير</incipit>
                     <explicit xml:lang="ar">
                        <locus target="#34v">-34v</locus>وخصه الله بالعروج إلى السموا \ ت بالمرور \ وسبحت فى يديه رمل وضمته \ غزال برّ \ وأباح له ما لا للكفار وبشره \ وبالشفاعة الكثير</explicit>
                     <note>f. 35r-v blank
</note>
                     <note/>
                  </msItem>
                  <msItem xml:id="ms_i11">
                     <locus from="36r" to="44v">36r-44v</locus>
                     <textLang xml:lang="ar">Arabic</textLang>
                     <title ref="LIT1665IHA" type="lacunous"/>
                     <incipit xml:lang="ar">
                        <locus target="#36v">-36v</locus>الجلجلتية الصغىري بسملة \ بدءت ببسم الله روحي به إهتدت \ إلى كشف أسرار بباطنه إنطوت \ وصليت فى الثانى على خير خلقه \ محمد</incipit>
                     <explicit xml:lang="ar">
                        <locus target="#44v">-44v</locus>وبالمسك والكافور والندّ ختّمت \ وصلّ وسلّم يا إلهي بكثرة \ كوبل غمام سائل قد تهطلت \ على المصطفى والأل والصحب كلهم \ بقدر نبا الأرض والريح إن سرت \ تمت </explicit>
                     <note/>
                     <note/>
                  </msItem>
                  <msItem xml:id="ms_i12">
                     <locus from="45r" to="46v">45r-46v</locus>
                     <textLang xml:lang="ar">Arabic</textLang>
                     <title ref="LIT2758IHA" type="apodous"/>
                     <incipit xml:lang="ar">
                        <locus target="#45r">-45r</locus>بسملة \ وإلى حضرة النبي محمد المختار \ صلى الله عليه وسلم أفضل الصلاة \ والتسليم وأزكا طاهر المطهر و \ جونب الأربة للؤلئة الأركا \ نية الإسلامية النفيسية الحضرى</incipit>
                     <explicit xml:lang="ar">
                        <locus target="#46r">-46r</locus>ثم إلى شيخه الفا \ ضل مظهر الدين الأسرار لومع \ الطيب لدني الأقدار والديه و \ سيخه [كذا] ورجائه سيد حمزه إبن \ كبير محمود رضى الله عنا وعنه \ نسبا ودينا ظاهرا وباطنا</explicit>
                     <note/>
                     <note/>
                  </msItem>
                  <msItem xml:id="ms_i13">
                     <locus from="47r" to="52v">47r-52v</locus>
                     <textLang xml:lang="ar">Arabic</textLang>
                     <title ref="LIT2759IHA"/>
                     <incipit xml:lang="ar">
                        <locus target="#47r">-47r</locus>وبه نستعين \ بسملة \ كلّ نفس ذائقة الموت وإنما تو \ فون أجوركم يوم القيامة فمن \ زحزح عن النار وأدخل الجنة \ فقد فاز وما لحياة الدنيا</incipit>
                     <explicit xml:lang="ar">
                        <locus target="#52v">-52v</locus>الحمد لله ربّ العالمين \ اللهم بحق محمد وأل محمد \ لا تعذب هذه الميت ثلاثا \ وصلى الله على سيدنا محمد وأله وصحبه وسلم \ تمت</explicit>
                     <note/>
                     <note/>
                  </msItem>
                  <msItem xml:id="ms_i14">
                     <locus from="53r" to="55r">53r-55r</locus>
                     <title ref="LIT2760IHA"/>
                     <incipit xml:lang="ar">
                        <locus target="#53r">-53r</locus>التصوف والأخلاق \ للإمام الشهيد حسن النبا معنى التصوف \ يراد بالتصوف الزهد في الدنيا والإتفات \ إلى الأخرة والإجتهاد فى طاعة الله تعالى</incipit>
                     <explicit xml:lang="ar">
                        <locus target="#54v-55r">-54v-55r</locus>وتتناوله الأحكام العامة ؛ فإن \ أظهر منه شيئا يوافق الأحكام الظاهر \ والعامة سلم له ؛ وإن كان مخالفا \ لها أقيمت عليه حدودها</explicit>
                     <note/>
                     <note/>
                  </msItem>
                  <msItem xml:id="ms_i15">
                     <locus from="59r" to="60v">59r-60v</locus>
                     <textLang xml:lang="ar">Arabic</textLang>
                     <title ref="LIT2761IHA"/>
                     <incipit xml:lang="ar">
                        <locus target="#59r">-59r</locus>فائدة \ وهذه ما يقال للمصاب بلمة من الجن وضع \ المصاب بين يديك وقرء عليه \ وعوذه بالفاتحة ومن أول البقرة \ إلى مفلحون ومنها وإلاهكم أله واحد</incipit>
                     <explicit xml:lang="ar">
                        <locus target="#60v">-60v</locus>وقل هو الله أحد والمعودتين وبعضهم \ من سورة إسراء قل أدعو الله وأدعو الرحمان \ أيا ما تدعو فله الأسماء الحسنى إلى أخرها وأيتان \ من سورة الرحمن يا معشر الجن والأنس إلى قوله فلا تنتصران</explicit>
                     <note/>
                     <note/>
                  </msItem>
                  <msItem xml:id="ms_i16">
                     <locus from="61r" to="61v">61r-61v</locus>
                     <title ref="LIT2778IHA"/>
                     <incipit xml:lang="ar">
                        <locus target="#61r">-61r</locus>أصحاب المذاهب المتبوعة \ أبو حنيفة النعمان بن ثابت مات \ ببغداد سنة خمسين ومائة هجرية</incipit>
                     <explicit xml:lang="ar">
                        <locus target="#61v">-61v</locus>أبو عبد \ الله أحمد بن حنبل مات ببغداد فى شهر \ ربيع الثاني سنة ۲۴۱ إحدا وأربعين ومائتين \ هجرة وولد سنة أربع وستين ومائة هجرية</explicit>
                     <note/>
                     <note/>
                  </msItem>
                  <msItem xml:id="ms_i17">
                     <locus from="62r" to="62v">62r-62v</locus>
                     <textLang xml:lang="ar">Arabic</textLang>
                     <title ref="LIT2779IHA"/>
                     <incipit xml:lang="ar">
                        <locus target="#62r">-62r</locus>تنبيه الكبد والمعدة أحوج الأ \ عضاء كلها إلى الأدوية القابضة \ العطرة لأجل شرفها وجلالة فعلها \ والحمى والنائبة كل يوم تحدث إلّا \ مع  علة فى معدة </incipit>
                     <explicit xml:lang="ar">
                        <locus target="#62r">-62r</locus>حتى يتقدمها ضعف فى المعدة ولا \ تكون أوجاع المفاصل حتى يتقدمها \ سوء مزاج الكلي</explicit>
                     <note>f. 62v blank
</note>
                     <note/>
                  </msItem>
                  <msItem xml:id="ms_i18">
                     <locus from="64r" to="65v">64r-65v</locus>
                     <textLang xml:lang="ar">Arabic</textLang>
                     <title ref="LIT0315IHA"/>
                     <incipit xml:lang="ar">
                        <locus target="#64r">-64r</locus>فائدة \ من قراء هذا الدعاء أربعين يوما كل يوم \ خمس مرة أعطاه الله العلم الله أعلم بالصواب \ بسملة \ يا من هو فى علوه كائن \ يا من هو فى علمه محيط </incipit>
                     <explicit xml:lang="ar">
                        <locus target="#65v">-65v</locus>ولكل طاعة ومعصية لا حول ولا \ قوة إلّا بالله العلي العظيم وصلّى \ الله على سيدنا محمد وعلى أله و\ صحبه وسلّم تسليما</explicit>
                     <note/>
                     <note/>
                  </msItem>
                  <msItem xml:id="ms_i19">
                     <locus from="66r" to="66v">66r-66v</locus>
                     <textLang xml:lang="ar">Arabic</textLang>
                     <title ref="LIT2751IHA"/>
                     <incipit xml:lang="ar">
                        <locus target="#66r">-66r</locus>مفتاح الكنز المحيط وهى هذ الصلاة (هذه الصلاة النارية) \ اللهمّ صلّ صلاة كاملة وسلّم سلاما تاما على سيّدنا محمد الذي تنحلّ به العقد وتنفرج به الكرب</incipit>
                     <explicit xml:lang="ar">
                        <locus target="#66v">-66v</locus>ومن داوم على قراءتها كل يوم بعد \ المرسلين عليهم السلام وهى ۳۱۳ مرة لكشف \ الأسرار فإنّه يرى كل شيئ يريده إنتهى</explicit>
                     <note/>
                     <note/>
                  </msItem>
                  <msItem xml:id="ms_i2">
                     <locus from="16r" to="20v">16r-20v</locus>
                     <textLang xml:lang="ar">Arabic</textLang>
                     <title ref="LIT0512IHA"/>
                     <incipit xml:lang="ar">
                        <locus target="#16v">-16v</locus>بسملة \ بسم الإله وبه بدينا \ ولوعبدنا غير شقينا \ يا حبّذا ربّا وحبّ دينا \ وحبّذا محمد هادينا \ لو لاه ما كنّأ ولا بقينا</incipit>
                     <explicit xml:lang="ar">
                        <locus target="#20v">-20v</locus>ألمستعان السامع المجيب \ إنّا دعوناك استجب أمينا \ الله [۹] كن حافظا لنا \ وكن معينا</explicit>
                     <note/>
                     <note/>
                  </msItem>
                  <msItem xml:id="ms_i20">
                     <locus from="67r" to="73r">67r-73r</locus>
                     <textLang xml:lang="ar">Arabic</textLang>
                     <title ref="LIT2758IHA"/>
                     <incipit xml:lang="ar">
                        <locus target="#67r">-67r</locus>بسملة \ وإلى حضرة النبي محمد المختار \ صلى الله عليه وسلّم أفضل الصلاة \ والتسليم وأزكا طاهر المطهر و\ جوانب الأربة اللؤلئة الأ \ ركانية الإسلامية النفيسية \ الحضرتية المشهورية</incipit>
                     <explicit xml:lang="ar">
                        <locus target="#73r">-73r</locus>وأنت راض عنّا بفضلك يا ذ الفضل \ العظيم سبحان ربك ربّ العزة \ عمّا يصفون وسلام على المرسلين \ والحمد لله ربّ العالمين  أمين \ وصلى الله على سيدنا محمد [...] أمين</explicit>
                     <note/>
                     <note/>
                  </msItem>
                  <msItem xml:id="ms_i21">
                     <locus from="73v" to="80r">73v-80r</locus>
                     <textLang xml:lang="ar">Arabic</textLang>
                     <title ref="LIT1707IHA"/>
                     <incipit xml:lang="ar">
                        <locus target="#73v-74r">-73v-74r</locus>ألهمّ صلّ على محمد واله \ أللهمّ سلم على محمد وصحبه \ أللهمّ بارك على محمد أمّته [...] \ بدأت نظمتى بذكر إله \ هو الذي قد عمنا بفضله \ ويكشف همنا لمن يدعوبه \\ بسم الله يا رحمان قرّبنا إليه</incipit>
                     <explicit xml:lang="ar">
                        <locus target="#79r">-79r</locus>أتي موحدا شاكر جميلا \ سجد ساجد للعلى الأعلا \ رفع رأسه أمّتى لى قال \ إلهي كن لنا حيث كنا به</explicit>
                     <note/>
                     <note/>
                  </msItem>
                  <msItem xml:id="ms_i22">
                     <locus from="80v" to="81v">80v-81v</locus>
                     <textLang xml:lang="ar">Arabic</textLang>
                     <title ref="LIT2786IHA" type="acephalous"/>
                     <incipit xml:lang="ar">
                        <locus target="#80v">-80v</locus>لي ذنوب شغلتني عن صيام وصلاتى \ تركت جسمى عليلا ٬ مات من قبل وفاتى \ ليتني تبت لربى ٬ من جميع السياتى \ أنا عبد يا إلهى ٬ هائم فى الفلواتى</incipit>
                     <explicit xml:lang="ar">
                        <locus target="#81r">-81r</locus>أنّ حيّا ليس يبقا ٬ غير ربّ العالمينا \ والّذى صحّ لدينا ٬ وعلمناه يقينا \ كلّ حيّ سوفا يفنا ٬ غير محي الميّتينا \ تمت</explicit>
                     <note/>
                     <note/>
                  </msItem>
                  <msItem xml:id="ms_i23">
                     <locus from="82r" to="98v">82r-98v</locus>
                     <textLang xml:lang="ar">Arabic</textLang>
                     <title ref="LIT2787IHA"/>
                     <incipit xml:lang="ar">
                        <locus target="#82r">-82r</locus>فائدة \ وفى صحيح مسلم عن أبى سعيد الحدري \ أنّ جبريل عليه السلام أتي النبي صلى الله عليه وسلم \ فقال يا محمد إشتكيت قال نعم فقال \ جبريل عليه السلام </incipit>
                     <explicit xml:lang="ar">
                        <locus target="#98v">-98v</locus>ولو كان مطرا فإنه مجرب فإنى سمـ[عه] \ يعنى حاج شريف حمزة من شيخى شيخ مختار وه[و] \ سمعه من شيخه شيخ حمز بن علي الغلمسيّ \ إنتهى</explicit>
                     <note>f. 83v blank</note>
                     <note/>
                  </msItem>
                  <msItem xml:id="ms_i3">
                     <locus from="21r" to="21r">21r-21r</locus>
                     <textLang xml:lang="ar">Arabic</textLang>
                     <title ref="LIT2730IHA"/>
                     <incipit xml:lang="ar">
                        <locus target="#21r">-21r</locus>فائدة \ مسهلات البطن ومن أخذ حنظلة كبيرة \ من شجرة ليس فيها غيره ووضع تحت \ سرّته</incipit>
                     <explicit xml:lang="ar">
                        <locus target="#21r">-21r</locus>إذا أكل يزيد فى \ الباءة وله فى ذالك قوة شديدة حتى يخرج \ الدمّ من رءس القضيب</explicit>
                     <note/>
                     <note/>
                  </msItem>
                  <msItem xml:id="ms_i4">
                     <locus from="21v" to="21v">21v-21v</locus>
                     <textLang xml:lang="ar">Arabic</textLang>
                     <title ref="LIT2738IHA"/>
                     <incipit xml:lang="ar">
                        <locus target="#21v">-21v</locus>ونقل أبو العباس الشرجي الزبيدي فى فوا \ ئد الإستغاثة الأتية وقال إن لها فضلا \ عظيما</incipit>
                     <explicit xml:lang="ar">
                        <locus target="#21v">-21v</locus>توسل بالنبي فكل عبد \ يغاث إذا توسل بالنبي \ إنتهى </explicit>
                     <note/>
                     <note/>
                  </msItem>
                  <msItem xml:id="ms_i5">
                     <locus from="22r" to="22v">22r-22v</locus>
                     <textLang xml:lang="ar">Arabic</textLang>
                     <title ref="LIT2739IHA"/>
                     <incipit xml:lang="ar">
                        <locus target="#22r">-22r</locus>فائدة (۱) أيات شفاء ست \ علاج لجميع الأمراض يكتب بسم الله الرحمان الرحيم \ ۱ ويشف صدور قوم مؤمنين ويذهب غيظ قلوبهم</incipit>
                     <explicit xml:lang="ar">
                        <locus target="#22v">-22v</locus>وأقل ما ينبغي أن يقرأ عند المهمات والملمات \ إتنتا عشرة  مرة إلى أربعين إنتهى</explicit>
                     <note/>
                     <note/>
                  </msItem>
                  <msItem xml:id="ms_i6">
                     <locus from="23r" to="25v">23r-25v</locus>
                     <textLang xml:lang="ar">Arabic</textLang>
                     <title ref="LIT2741IHA"/>
                     <incipit xml:lang="ar">
                        <locus target="#23r">-23r</locus>بسملة \ إلهي يا إلهي يا إلهي إلهى أسلك بنا سلك الكرام \ خذ واعنى بسلسلة الكرام \ فهم أبا أرواح الأنام</incipit>
                     <explicit xml:lang="ar">
                        <locus target="#25r">-25r</locus>وما صبّ صبا أهل الغرام \ بوافر بحرها انتسبت وتمت \ بحمد الله سلسلة الكرام</explicit>
                     <note/>
                     <note/>
                  </msItem>
                  <msItem xml:id="ms_i7">
                     <locus from="26r" to="27v">26r-27v</locus>
                     <textLang xml:lang="ar">Arabic</textLang>
                     <title ref="LIT2745IHA"/>
                     <incipit xml:lang="ar">
                        <locus target="#26r">-26r</locus>يا أرحم الرحيم (۴) فرج على المسلمين \ يا ربنا يا كريم يا ربنا يا رحيم \ أنت الجواد الحكيم وأنت نعم المعين</incipit>
                     <explicit xml:lang="ar">
                        <locus target="#27v">-27v</locus>واكشف لكل الكروب واكف أذى المؤذيب \ ثم الصلاة والسلام على شفيع الأنام \ والال نعم الكرام والصحب والتابعين تمت</explicit>
                     <note/>
                     <note/>
                  </msItem>
                  <msItem xml:id="ms_i8">
                     <locus from="28r" to="30r">28r-30r</locus>
                     <textLang xml:lang="ar">Arabic</textLang>
                     <title ref="LIT2746IHA"/>
                     <incipit xml:lang="ar">
