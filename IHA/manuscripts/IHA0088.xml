                     <title ref="LIT0030IHA#s50IHA"/>
                     <incipit xml:lang="ar">
                        <locus target="#1v">-1v</locus>كتاب الجراح جمع جراحة غلبت لانها الكثر طروق الذهوق واعم منها الجناية</incipit>
                     <explicit xml:lang="ar">
                        <locus target="#151v">-151v</locus>فلا يثبت لهما احكام الاضحية كما هو ظاهر كتاب بيان ما يحل وما يحرم من الاطعمة</explicit>
                     <note>Some of the words are divided into two different lines </note>
                     <note/>
                  </msItem>
                  <msItem xml:id="ms_i1">
                     <locus from="152v" to="154v">152v-154v</locus>
                     <textLang xml:lang="ar">Arabic</textLang>
                     <title ref="LIT0276IHA#s105IHA"/>
                     <incipit xml:lang="ar">
                        <locus target="#152v">-152v</locus>وهو ابن عبد الله عبد المطلب| ابوه وهو الشيبة الحمد نسب| ابوه عمرو هاشم والجد| عبد مناف ابن قصي زيد</incipit>
                     <explicit xml:lang="ar">
                        <locus target="#154v">-154v</locus>وهو ابن زهرة يلي كلاب| وفيه مع ابيه الانتساب</explicit>
                     <note/>
                     <note/>
                  </msItem>
