               <msContents>
                  <summary/>
                  <msItem xml:id="ms_i0">
                     <locus from="1r" to="10r">1r-10r</locus>
                     <textLang xml:lang="ar">Arabic</textLang>
                     <title ref="LIT1965IHA"/>
                     <incipit xml:lang="ar">
                        <locus target="#2v">-2v</locus>بسملة \ الحمد لله الذي أنعم علينا وهدانا بالإسلام وأكرمنا \ بأن جعلنا من أمة حبيبه محمد [...] أما بعد فيقول الفقير خادم طلبة العلم محمد \ سراج بن محمد سعيد الجبرتي كتب إليّ بعض</incipit>
                     <explicit xml:lang="ar">
                        <locus target="#10r">-10r</locus>قال هل كنتم تدعون أحدا منهم كافرا \ قال لا قال الحافظ الهيتمي بعد إيراده رجاله الصحيح \ وهذا القدر كفاية لمن عندهم إيمان وإنصاف \ تمت وبالخير عمت</explicit>
                     <note>ff. 1r-v blank</note>
                     <note/>
                  </msItem>
                  <msItem xml:id="ms_i1">
                     <locus from="10v" to="13v">10v-13v</locus>
                     <textLang xml:lang="ar">Arabic</textLang>
                     <title ref="LIT1983IHA"/>
                     <incipit xml:lang="ar">
                        <locus target="#10v">-10v</locus>فائدة إنما الأعمال بالنيات والمراد بالأعمال الأعمال الشرعية \ ومعناه : لا يعتد باالأعمال بدون النية</incipit>
                     <explicit xml:lang="ar">
                        <locus target="#13v">-13v</locus>هذا ما أفدناكم خرجة من كتاب الحاوى \ للفتاوي للحافظ جلال الدين السيوطي المتوفى سنة ۹۱۱هـ \ تمت</explicit>
                     <note/>
                     <note/>
                  </msItem>
                  <msItem xml:id="ms_i2">
                     <locus from="14r" to="18v">14r-18v</locus>
                     <textLang xml:lang="ar">Arabic</textLang>
                     <title ref="LIT1995IHA"/>
                     <incipit xml:lang="ar">
                        <locus target="#14r">-14r</locus>قال النووي \ ويستحب الأكثار من الزيارة والوقوف عند قبور \ أهل الخير قال السمهوري فإنّ لهم في برازخهم \ من تصرّفات والبركات ما لا يحصى</incipit>
                     <explicit xml:lang="ar">
                        <locus target="#18v">-18v</locus>ويمنحهم من الدنه توفيقا وسدادا فإنّه \ سميع قريب مجيب يا ربّ العالمين أمين \ إنتهى تمت وبخير عمت</explicit>
                     <note/>
                     <note/>
                  </msItem>
                  <msItem xml:id="ms_i3">
                     <locus from="19r" to="31v">19r-31v</locus>
                     <textLang xml:lang="ar">Arabic</textLang>
                     <title ref="LIT2016IHA"/>
                     <incipit xml:lang="ar">
                        <locus target="#19r">-19r</locus>بسملة \ ربط الولد باالمرشد \ مما لا يختلف فيه أثناه أنّ الولد إذا أرتبط بعالم \ مرشد مخلص صالح فاهم للإسلام على حقيقته</incipit>
                     <explicit xml:lang="ar">
                        <locus target="#29v">-29v</locus>ونصر \ المسلمين وإقامة دولة القرآن العقيدة وما ذلك \ على الله بعزيز \ وصلى الله عليه وسلم على سيدنا محمد وعلى أله وصحبه وسلم تسليما كثيرا \ تمت وبالخير عمت</explicit>
                     <note/>
                     <note/>
                  </msItem>
