               <msContents>
                  <summary/>
                  <msItem xml:id="ms_i0">
                     <locus from="1v" to="120r">1v-120r</locus>
                     <textLang xml:lang="ar">Arabic</textLang>
                     <title ref="LIT0102IHA"/>
                     <incipit xml:lang="ar">
                        <locus target="#1v">-1v</locus>الحمد لله رب العالمين وصلى الله على سيدنا محمد واله وصحبه اجمعين اما هذا مختصر على مذهب الامام الشافعي رحمة الله عليه اقتصرت فيه على الصحيح من المذهب عند الرافعي والنووي او احدهما </incipit>
                     <explicit xml:lang="ar">
                        <locus target="#120r">-120r</locus>ولا يقبل فى الزنا واللوط واتيان البهائم الا اربعة ذكور ويقبل في ما لا يطلع عليه الرجال كالولادة رجلان او رجل وامرءتان او اربع نسوة والله اعلم تمت </explicit>
                     <note>The text ‘Umdat al-sālik begins on fol. 1v and continues from fol. 4r. Fols 2r-3r contain detached notes and fol. 3v a text fragment. Words divided into two lines.</note>
                     <note/>
                  </msItem>
               </msContents>
