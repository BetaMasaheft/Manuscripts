                        <item xml:id="a0_4272">
                           <locus target="#p. 1">-p. 1</locus>
                           <q xml:lang="ar">حماة الأسلام 
تأليف مصطفى بك نجيب 
الجزء الثانى 
الطبعة الثالثة 
