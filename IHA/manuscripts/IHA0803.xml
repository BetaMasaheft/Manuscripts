               <msContents>
                  <summary/>
                  <msItem xml:id="ms_i0">
                     <locus from="1r" to="2v">1r-2v</locus>
                     <textLang xml:lang="ar">Arabic</textLang>
                     <title ref="LIT2088IHA" type="acephalous"/>
                     <incipit xml:lang="ar">
                        <locus target="#1r">-1r</locus>اول كل اول راح أبناء الأزل | كتاب عجيب منزل الصب به تململ | مدير تلك الكؤس ذات شعاء كاالشمس | وسر اسرار الفرش طيار عالم العرش رسول الله ذو البطش وروح أرباب الدهش</incipit>
                     <explicit xml:lang="ar">
                        <locus target="#2v">-2v</locus>سرنا في ميدان الصفا طالبا جيش المعرفه | صلاة الله الجلال الكرام على سيد الارسال | وعلى الال الكرام وعلى الصحب الصلهام | ما لاح في خيم قلبى بروق سادات الغيب</explicit>
                     <note/>
                     <note/>
                  </msItem>
                  <msItem xml:id="ms_i1">
                     <locus from="3r" to="5v">3r-5v</locus>
                     <textLang xml:lang="ar">Arabic</textLang>
                     <title ref="LIT0892IHA"/>
                     <incipit xml:lang="ar">
                        <locus target="#3r">-3r</locus>بدر كمال قد ظهر الكون به تنور | مسك النبوة انتشر الخون به تعطر</incipit>
                     <explicit xml:lang="ar">
                        <locus target="#5v">-5v</locus>ما طار السالك شوقا في واد القرب واللقا | ما طاف اهل الكمال حول كعبة الوصال</explicit>
                     <note/>
                     <note/>
                  </msItem>
                  <msItem xml:id="ms_i2">
                     <locus from="5v" to="9r">5v-9r</locus>
                     <title ref="LIT0618IHA"/>
                     <incipit xml:lang="ar">
                        <locus target="#5v">-5v</locus>صل اله على محمد مهبوب الأ...
قد لاح صباح الفتح انار قلب الرجالا | فحنو حنين الثكلا الى المحبوب الأولا | ما طاب لهم منام مشربا ولا مأكلا</incipit>
                     <explicit xml:lang="ar">
                        <locus target="#9r">-9r</locus>واصحابه الفضلا ارباب الفضل والولا | ما قال كل العشاق محمد زين الكمالا | ما دامت تخطف العقول برقات ذاك الجمالا | ما سبى ألباب الأحباب رونق ذاك الحمالا</explicit>
                     <note/>
                     <note/>
                  </msItem>
                  <msItem xml:id="ms_i3">
                     <locus from="9v" to="13v">9v-13v</locus>
                     <textLang xml:lang="ar">Arabic</textLang>
                     <title ref="LIT1279IHA"/>
                     <incipit xml:lang="ar">
                        <locus target="#9v">-9v</locus>بسم الله الرحمن الرحيم 
ولما طلع نور معظم معشر العشاق به ترمرم | قد باتو سكارا من خمر المحبة تراهم يا صاحى حيارا هيام | مدح فرد الوجود ألذّ المشارب مورد الحبائب سر مهيم</incipit>
                     <explicit xml:lang="ar">
                        <locus target="#13v">-13v</locus>...أرواح العشاق في ليل هجرهم شوقا اليهم | ما دامت تتية معشر العرفا في تية المعرفه عليهم سلام </explicit>
                     <note/>
                     <note/>
                  </msItem>
                  <msItem xml:id="ms_i4">
                     <locus from="13v" to="13v">13v-13v</locus>
                     <textLang xml:lang="ar">Arabic</textLang>
                     <title ref="LIT1282IHA" type="apodous"/>
                     <incipit xml:lang="ar">
                        <locus target="#13v">-13v</locus>...محمد سر أزلي نور ...
هو النور الأجلى والقلم الأعلى لوح الله الأعلى سر الرباني | به زال عنابه نجلى عنا ظلام الحسى كذا المعنوى</incipit>
                     <explicit xml:lang="ar"/>
                     <note/>
                     <note/>
                  </msItem>
