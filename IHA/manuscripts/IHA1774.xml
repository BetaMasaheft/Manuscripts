               <msContents>
                  <summary/>
                  <msItem xml:id="ms_i0">
                     <locus from="2r" to="2r">2r-2r</locus>
                     <textLang xml:lang="ar">Arabic</textLang>
                     <title ref="LIT0692IHA"/>
                     <incipit xml:lang="ar">
                        <locus target="#2r">-2r</locus>بسم الله الرحمن الرحيم \ [.؟.] لك الشكر اذ هديتنا للايمان [.؟.] القران اذ مننت علينا بما وهبتنا من علم [.؟.] وتاويله</incipit>
                     <explicit xml:lang="ar">
                        <locus target="#2r">-2r</locus>اللهم انا نقرء كتابك العزيز لنيل الدرجات العلي ولقضا الحاجات  ولاسقاط الذنوب ولنور القلوب ولطرد الشيطان الرجيم \ اعوذ بالله من الشيطان الرجيم

</explicit>
                     <note>Parts of the first three lines damaged by damp.</note>
                     <note/>
                  </msItem>
                  <msItem xml:id="ms_i1">
                     <locus from="2v" to="243v">2v-243v</locus>
                     <textLang xml:lang="ar">Arabic</textLang>
                     <title ref="LIT0049IHA"/>
                     <incipit xml:lang="ar">
                        <locus target="#2v">-2v</locus>بسم الله الرحمن الرحيم , الحمد لله رب العالمين , الرحمن الرحيم , ملك يوم الدين</incipit>
                     <explicit xml:lang="ar">
                        <locus target="#243v">-243v</locus>الذي يوسوس في صدور الناس , من الجنة والناس</explicit>
                     <note>Frontispieces. Deletions and additions in the margin. Catchwords. Penciled page numbers. Repaired in some places.</note>
                     <note/>
                  </msItem>
                  <msItem xml:id="ms_i2">
                     <locus from="243v" to="244v">243v-244v</locus>
                     <textLang xml:lang="ar">Arabic</textLang>
                     <title ref="LIT0690IHA"/>
                     <incipit xml:lang="ar">
                        <locus target="#244r">-244r</locus>بسم الله الرحمن الرحيم \ اللهم ارحمنا بالقران العظيم وانفعنا بالايات والذكر الحكيم وبارك لنا في السبع المثانى والقران العظيم

</incipit>
                     <explicit xml:lang="ar">
                        <locus target="#244v">-244v</locus>وفرج عنا من كل هم وغم برحمتك يا ارحم الراحمينوالحمد لله رب العلمين سبحان ربك رب العزة عما يصفون وسلام على المرسلين والحمد لله رب العلمين وصلى الله على سيدنا محمد واله وصحبه وسلم

</explicit>
                     <note/>
                     <note/>
                  </msItem>
                  <msItem xml:id="ms_i3">
                     <locus from="244v" to="245v">244v-245v</locus>
                     <textLang xml:lang="ar">Arabic</textLang>
                     <title ref="LIT0820IHA"/>
                     <incipit xml:lang="ar">
                        <locus target="#244v">-244v</locus>بسم الله الرحمن الرحيم \ اللهم اجعلنا للايمان كاملين وبالاسلام ثابتين \ ولفرايضك مؤدين وللصلوة حافظين</incipit>
                     <explicit xml:lang="ar">
                        <locus target="#245v">-245v</locus>وكفى بالله عليما دعواهم فيها سبحانك اللهم وتحيتهم فيها سلام واخر دعواهم عن الحمد لله رب العالمين سبحان ربك ربّ العزّة عمّا يصفون وسلام علي المرسلين والحمد لله ربّ العالمين 

</explicit>
                     <note/>
                     <note/>
                  </msItem>
                  <msItem xml:id="ms_i4">
                     <locus from="245v" to="246v">245v-246v</locus>
                     <textLang xml:lang="ar">Arabic</textLang>
                     <title ref="LIT4145IHA" type="apodous"/>
                     <incipit xml:lang="ar">
                        <locus target="#245v-246r">-245v-246r</locus>صدق الله العظيم وبلغ رسوله النبي الكريم [...] سبحانك ما عبدناك حق عبادتك سبحانك ما عرفناك حق معرفتك سبحانك اللهم وبحمدك لك الحمدعلي حلمك بعد علمك سبحانك اللهم وبحمدك لك الحمد علي عفوك بعد قدرتك

</incipit>
                     <explicit xml:lang="ar">
                        <locus target="#246v">-246v</locus>ذلك الفضل من الله وكفي بالله عليما دعواهم فيها سبحانك اللهم وتحيتهم فيها سلام واخر دعواهم ان الحمد لله رب العالمين , سبحان ربك رب العزة عما يصفون وسلام علي المرسلين والحمد لله رب العالمين وصلى الله علي سيدنا \ محمد 
<note>The last word is the catchword.</note>
                     </explicit>
                     <note/>
                     <note/>
                  </msItem>
