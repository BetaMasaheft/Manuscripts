                  <additions>
                     <t:list xmlns:t="http://www.tei-c.org/ns/1.0">
                        <item xml:id="a0_6579">
                           <locus target="#243v">-243v</locus>
                           <q xml:lang="ar">وتمت كلمات ربك صدقا وعدلا لا مبدل لكلماته وهو السميع العليم \ صدق الله العظيم وبلغ رسوله النبي الكريم نحن علي ذلك من الشاهدين والحمد لله رب العالمين امين امين امين</q>
                           <note/>
                        </item>
                        <item xml:id="a0_7438">
                           <locus target="#245v">-245v</locus>
                           <q xml:lang="ar">اللهم اغفر لقارئه ولكاتبه ولسامعه وارحمه واجعله من المحشورين وفي زمرة النبيين [والعبد] يقين يوم القيمة بفضلك يا رحمن يا رحيم \ وصلى الله على سيدنا محمد وعلى اله وصحبه وسلم تسليما</q>
                           <note>
                              <term key="Devotional"/>
                           </note>
                        </item>
                        <item xml:id="a0_7437">
                           <locus target="#243v">-243v</locus>
                           <q xml:lang="ar">دعا ختم القران العظيم</q>
                           <desc>Title</desc>
                           <note/>
                        </item>
