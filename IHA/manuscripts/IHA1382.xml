               <msContents>
                  <summary/>
                  <msItem xml:id="ms_i0">
                     <locus from="1r" to="2r">1r-2r</locus>
                     <textLang xml:lang="ar">Arabic</textLang>
                     <title ref="LIT1023IHA"/>
                     <incipit xml:lang="ar">
                        <locus target="#1v">-1v</locus>الله يا الله يا الله نجنا من البلاء \ ابدء بسم الله الرحمان , وبالرحيم دائم الاحسان \ اشهد ان لا اله الا الله , واشهد ان محمد الرسول الله \ واقام الصلاة الخمس , وزكات المال والنفس \ وصوم شهر رمضان , وحج البيت كما فى القراان [...] االوجود واجب لله والعدم مستحيل عليه \ والقدم واجب لله والحدوث مستحيل عليه</incipit>
                     <explicit xml:lang="ar">
                        <locus target="#2r">-2r</locus>والامانة واجب للرسل والخيانة مستحيل عليهم \ والفطانة واجب للرسل والبلادة مستحيل عليهم \ وجائزهم حال الناس , كالاكل واللباس \ ربنا حسن ختامنا , استجب دعانا \ صل وسلم يا رب القديم , على النور العظيم \ واله وصحبه وارزقنا بقربه</explicit>
                     <note>The present version contains a beginning and and end that do not have the refrain mustaḥīl ʻalayhi/him.</note>
                     <note/>
                  </msItem>
