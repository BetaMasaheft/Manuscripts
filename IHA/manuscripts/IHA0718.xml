               <msContents>
                  <summary/>
                  <msItem xml:id="ms_i0">
                     <locus from="1r" to="1v">1r-1v</locus>
                     <textLang xml:lang="ar">Arabic</textLang>
                     <title ref="LIT1577IHA"/>
                     <incipit xml:lang="ar">
                        <locus target="#1v">-1v</locus>بسم الله الرحمن الرحيم الحمد لله الذى جعل السادات العارفين قبلة لوائج المريدين وجعل بروزهم رحمة للمؤمنين والمذاكرة فى سيرهم سببا لتنزيل رحمة من رب العالمين لقوله صلى الله عليه وسلم تنزل الرحمة عند ذلك الصالحين وذكرهم غذاء الارواح المحبين وشفاء لصدور الموقنين</incipit>
                     <explicit xml:lang="ar">
                        <locus target="#1v">-1v</locus>اما بعد فهذه عجلة لطيفة ونبذة يسيرة بل هي قطرة من الوابل الكثير وغرفة من البحار الكبير</explicit>
                     <note/>
                     <note/>
                  </msItem>
                  <msItem xml:id="ms_i1">
                     <locus from="2r" to="2v">2r-2v</locus>
                     <textLang xml:lang="ar">Arabic</textLang>
                     <title ref="LIT0090IHA"/>
                     <incipit xml:lang="ar">
                        <locus target="#2r">-2r</locus>كل عدو مفتر وجانى| واجعل لنا من لطفك لخافي| حجاب ستر شامل سنى| يا حي يا قيوم يا تهار| باعلي يا عظيم يا جبار واختم لنا يا رب بالايمان</incipit>
                     <explicit xml:lang="ar">وشامت معنف معاند| واجعلنا من كل ضيق فرجا| وكلهم وبلا مخرجا| وأكمد بنار الغيظ والخسران</explicit>
                     <note/>
                     <note/>
                  </msItem>
