                  <msItem xml:id="ms_i0">
                     <locus from="1r" to="154r">1r-154r</locus>
                     <textLang xml:lang="ar">Arabic</textLang>
                     <title ref="LIT0012IHA#s86IHA"/>
                     <incipit xml:lang="ar">
                        <locus target="#1v">-1v</locus>بسم الله الرحمن الرحيم الحمد لله حمدا موافيا لنعمه مكافيا لمزيده والصلاة والسلام على محمد واله وصحبه وجنوده هذا ما اشتدت إليه حاجة الراغبين في تكملة تفسير القرءان الكريم الذي ألفه الامام العلامة المحقق جلال الدين محمد بن احمد [المحلي الشافعي] رحمه الله</incipit>
                     <explicit xml:lang="ar">
                        <locus target="#153v">-153v</locus>ولم يكن له شريك في الملك الى اخر السورة والله اعلم هذا ءاخر ما كملت به تفسير القران الكريم الذي الفه الامام العلامة المحقق جلال الدين المحلي الشافعي رضع [...] وجعلنا به مع الذي انعم الله عليهم من النبيين والصديقين والشهداء والصالحين وحسن اولئك رفيقا</explicit>
                     <note>Commented text vocalized. Words divided into two lines.</note>
                     <note/>
                  </msItem>
