                  <msItem xml:id="ms_i0">
                     <locus from="1r" to="3r">1r-3r</locus>
                     <textLang xml:lang="ar">Arabic</textLang>
                     <title ref="LIT2238IHA" type="acephalous"/>
                     <incipit xml:lang="ar">
                        <locus target="#1r">-1r</locus>...ينا محضرون يا عباد الله يا ابن امة الله يرحمك الله ذهب عنك الدنيا وزينتها وصرت الآن في برزخ من برازخ الاخرة </incipit>
                     <explicit xml:lang="ar">
                        <locus target="#3r">-3r</locus>ثم بعد ذلك يقرء الفاتحة ويهدى الثواب للميت ولاهل القبور ولجميع المسلمين والمسلمات ثبك [؟] الله بالقول الثابت ثلاثا الخ ام </explicit>
                     <note/>
                     <note/>
                  </msItem>
                  <msItem xml:id="ms_i1">
                     <locus from="3v" to="9v">3v-9v</locus>
                     <textLang xml:lang="ar">Arabic</textLang>
                     <title ref="LIT2197IHA"/>
                     <incipit xml:lang="ar">
                        <locus target="#3v">-3v</locus>هذه خطبة عيد الفطر الالى يكبر تسع...
الله اكبر كبيرا والحمد لله كثيرا وسبحان الله بكرة واصيلا الله اكبر الحمد لله ما اختلف الملوان وتعاقب العصران </incipit>
                     <explicit xml:lang="ar">
                        <locus target="#9v">-9v</locus>لعلكم تذكرون اذكروا الله العظيم يذكركم واشكروه على نعمه يزدكم ولذكر الله اكبر والله يعلم بما تصنعون اه تمت</explicit>
                     <note/>
                     <note/>
                  </msItem>
                  <msItem xml:id="ms_i2">
                     <locus from="9v" to="9v">9v-9v</locus>
