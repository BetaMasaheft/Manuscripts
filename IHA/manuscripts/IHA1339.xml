               <msContents>
                  <summary/>
                  <msItem xml:id="ms_i0">
                     <locus from="1r" to="4v">1r-4v</locus>
                     <textLang xml:lang="ar">Arabic</textLang>
                     <title ref="LIT0450IHA"/>
                     <incipit xml:lang="ar">
                        <locus target="#1r">-1r</locus>بسم الله الرحمن الرحيم 
الحمد لله الذى قد اخرجا له نتائج الفكر لارباب الحجا |وحط عنهم من سماء العقل| كل حجاب من سحاب الجهل| حتى بدت لهم شموش المعرفة</incipit>
                     <explicit xml:lang="ar">
                        <locus target="#4v">-4v</locus>واله وصحبه الثقَات| السالكين سبل النجاة| ما قطعت شمس النهار ابرجا |وطلع البدر المنير فى الدجي|تمت
</explicit>
                     <note/>
                     <note/>
                  </msItem>
                  <msItem xml:id="ms_i1">
                     <locus from="5r" to="14v">5r-14v</locus>
                     <textLang xml:lang="ar">Arabic</textLang>
                     <title ref="LIT3107IHA"/>
                     <incipit xml:lang="ar">
                        <locus target="#5r">-5r</locus>بسم الله الرحمن الرحيم
قال الشيخ الامام العالم العلامة علم الدين سليمان الجري الحمد الله رب العلمين والصلاة والسلام على سيدنا محمد واله وصحبه وسلم 
اما بعد فهذه تقييدات على متن ايساغوجى </incipit>
                     <explicit xml:lang="ar">
                        <locus target="#14v">-14v</locus>ولكن هذا اخر رسالة فى المنطق ضمها الله العقايد الحقة وزوال العقد الباطلة بمحمد واله امين ه والحمد لله وحده والصلاة والسلام على سيدنا خاتم النبين ولمرسلين وعلى اله والصحب اجمعين والحمد لله رب العالمين ا م ي ن وصلى الله على سيدنا محمد وعلى اله وصحبه وسلم ا م امين</explicit>
                     <note/>
                     <note/>
                  </msItem>
                  <msItem xml:id="ms_i2">
                     <locus from="15r" to="49v">15r-49v</locus>
                     <textLang xml:lang="ar">Arabic</textLang>
                     <title ref="LIT0113IHA"/>
                     <incipit xml:lang="ar">
                        <locus target="#15r">-15r</locus>بسم الله الرحمن الرحيم
الحمد لله القديم الاحد| الدائم الفرد العظيم الصمد| مقدر الاقداد والاقسام| مدبر الامور والاحكام</incipit>
                     <explicit xml:lang="ar">
                        <locus target="#49v">-49v</locus>ابياتها سبع مائة سبعة |ثم ثمانون ومنها تممة

</explicit>
                     <note/>
                     <note/>
                  </msItem>
                  <msItem xml:id="ms_i3">
                     <locus from="49v" to="52v">49v-52v</locus>
                     <textLang xml:lang="ar">Arabic</textLang>
                     <title ref="LIT3108IHA"/>
                     <incipit xml:lang="ar">
                        <locus target="#49v">-49v</locus>بسم الله الرحمن الرحيم الحمد لله القديم البار رب الانام مقدر الاعمار| بان السما من الدخان يضعه ومبدل الظلما بالانوار| متوحد فى ذاته وصفاته متقدس عن كل وصف</incipit>
                     <explicit xml:lang="ar">
                        <locus target="#52v">-52v</locus>يا رب ادخله الجنان ونجه من لفح نيران مع الابرار| ثم الصلوة على النبي محمد وعلى جميع اصحاب الاخيار</explicit>
                     <note/>
                     <note/>
                  </msItem>
