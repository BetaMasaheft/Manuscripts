               <msContents>
                  <summary>Photocopy of a manuscript</summary>
                  <msItem xml:id="ms_i0">
                     <locus from="1r" to="27r">1r-27r</locus>
                     <textLang xml:lang="ar">Arabic</textLang>
                     <title ref="LIT0950IHA"/>
                     <incipit xml:lang="ar">
                        <locus target="#2r">-2r</locus>بسملة, به الاعانة بدأ وختما وصلى الله على سيدنا محمد ذات ووصفا وسما الحمد لله الذى اطلع فى السماء السيادة شمس الذات المحمدية ساطعة الانوار واينع فى رياض السعادة</incipit>
                     <explicit xml:lang="ar">
                        <locus target="#27r">-27r</locus>وسائر المسلمين بفضل سبحان ربك رب العزة عما يصفون وسلام على المرسلين والحمد لله رب العالمين الفاتحة لروح النبي صلى الله عليه وسلم سوده الفقير جعفر ابن محمد عثمان الميرغني كان لهما الغني امين</explicit>
                     <note>Photocopy of the original ms; folios ordered from left to right with modern foliotation on the photocopies ff. 1-27</note>
                     <note/>
                  </msItem>
                  <msItem xml:id="ms_i1">
                     <locus from="57r" to="28r">57r-28r</locus>
                     <textLang xml:lang="ar">Arabic</textLang>
                     <title ref="LIT0951IHA"/>
                     <incipit xml:lang="ar">
                        <locus target="#56r">-56r</locus>بسملة, وصلى الله علي سيدنا محمد ذاتا ووصفا واسما. الحمد لله الذي جعل الاولياء صفوة خلقه ورفع لهم منزلة وقدرا وفوا بالعهود فنشر لهم في الوجود ثناء وذكر زين بهم الزمان</incipit>
                     <explicit xml:lang="ar">
                        <locus target="#28r">-28r</locus>والسلم علي نبيك الفاتح الخاتم سيدنا محمد وعلي اله وصحبه صلاة وسلاماً دائمين يوم الدين سبحان ربك رب العزة عما يصفون وسلام علي المرسلين والحمد لله رب العلمين الفاتحة امين</explicit>
                     <note>Photocopy of the original ms; folios ordered from right to left with modern foliotation on the photocopies ff. 58-28, following the left to right order; ff. 44 not reproduced in the digital images</note>
                     <note/>
                  </msItem>
                  <msItem xml:id="ms_i2">
                     <locus from="58r" to="168r">58r-168r</locus>
                     <textLang xml:lang="ar">Arabic</textLang>
                     <title ref="LIT1126IHA"/>
                     <incipit xml:lang="ar">
                        <locus target="#58r">-58r</locus> حمدلة, وبعد فاقول مجيبا عن هذا السؤال علي غاية الايجاز والاحتصار مراعاة الحال الوقت وقلة الفهم وضعف العزم وسغل الجنان وكلل اللسان وما توفيقى الا باللهومنه استمد العون والتوفيق</incipit>
                     <explicit xml:lang="ar">
                        <locus target="#168r">-168r</locus>
                        <note>Unreadable</note>
                     </explicit>
                     <note>Photocopy of the original ms; folios ordered from left to right; modern foliotation on the photocopies ff. 59-170; f. 68b not numbered on the photocopy; ff. 66, 112 not reproduced in the digital images</note>
                     <note/>
                  </msItem>
