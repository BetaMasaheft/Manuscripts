                  <msItem xml:id="ms_i0">
                     <locus from="1r" to="1r">1r-1r</locus>
                     <textLang xml:lang="ar">Arabic</textLang>
                     <title ref="LIT0503IHA"/>
                     <incipit xml:lang="ar">
                        <locus target="#1r">-1r</locus>بسم الله الرحمن الرحيم اللهم انى اسئلك ايمانا دائما واسئلك قلبا خاشيا واسئلك علما نافعا واسئلك يقينا صادقا واسئلك دينا قيما واسئلك العافية من كل بلية واسشلك تمام العافية واسئلك دوام العافية واسئلك الشكر على العافية واسئلك الغنا عن الناس بفضل رحمتك يا ارحم الراحمين</incipit>
                     <explicit xml:lang="ar"/>
                     <note>The whole duʻā' is given in Incipit.</note>
                     <note/>
                  </msItem>
                  <msItem xml:id="ms_i1">
                     <locus from="1v" to="167r">1v-167r</locus>
                     <textLang xml:lang="ar">Arabic</textLang>
                     <title ref="LIT0049IHA#s38IHA"/>
                     <incipit xml:lang="ar">
                        <locus target="#1v">-1v</locus>بسم الله الرحمن الرحيم الحمد لله رب العالمين الرحمن الرحيم مالك يوم الدين</incipit>
                     <explicit xml:lang="ar">
                        <locus target="#167r">-167r</locus>ولولا اذ دخلت جنتك قلت ما شاء الله لا قوة الا بالله ان ترن انا اقل منك مالا وولدا</explicit>
                     <note>The text ends with verse 18:39 on fol. 167r. Fol 167v is blank. On fols 1v-2r decorative frames. Vocalized. Words divided into two lines.</note>
                     <note/>
                  </msItem>
