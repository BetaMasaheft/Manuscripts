               <msContents>
                  <summary/>
                  <msItem xml:id="ms_i0">
                     <locus from="1r" to="2r">1r-2r</locus>
                     <textLang xml:lang="ar">Arabic</textLang>
                     <title ref="LIT1512IHA" type="acephalous"/>
                     <incipit xml:lang="ar">
                        <locus target="#1r">-1r</locus>اولهم أدم وأخرهم محمد صلى الله عليه وسلم والرسل منهم ثلاث مائة وثلاثة عشر والوا العزم منهم خمسة</incipit>
                     <explicit xml:lang="ar">
                        <locus target="#2r">-2r</locus>والترتيب على ما ذكرناه وصلى الله على سيدنا محمد وأله وصحبه وسلم </explicit>
                     <note/>
                     <note/>
                  </msItem>
                  <msItem xml:id="ms_i1">
                     <locus from="2r" to="4r">2r-4r</locus>
                     <textLang xml:lang="ar">Arabic</textLang>
                     <title ref="LIT1513IHA"/>
                     <incipit xml:lang="ar">
                        <locus target="#2r">-2r</locus>بسم الله الرحمن الرحيم
ببسم الله بدأت كلامى لأبلغ المقصود من رمامى</incipit>
                     <explicit xml:lang="ar">
                        <locus target="#4r">-4r</locus>الحمد لله الذى وفقنا بما يرضاه وبه انطقنا</explicit>
                     <note/>
                     <note/>
                  </msItem>
                  <msItem xml:id="ms_i2">
                     <locus from="4r" to="5v">4r-5v</locus>
                     <textLang xml:lang="ar">Arabic</textLang>
                     <title ref="LIT0425IHA"/>
                     <incipit xml:lang="ar">
                        <locus target="#4r">-4r</locus>بسم الله الرحمن الرحيم
ابدأ ببسم الله والرحمن وبالرحيم دائم الاحسان </incipit>
                     <explicit xml:lang="ar">
                        <locus target="#5v">-5v</locus>ابياتها ميز بعد الجمل تاريخها حي غر جمل
سميتها عقيدة العوام من واجب في الدين بالتمام</explicit>
                     <note/>
                     <note/>
                  </msItem>
                  <msItem xml:id="ms_i3">
                     <locus from="6r" to="7r">6r-7r</locus>
                     <textLang xml:lang="ar">Arabic</textLang>
                     <title ref="LIT1034IHA"/>
                     <incipit xml:lang="ar">
                        <locus target="#6r">-6r</locus>بسم الله الرحمن الرحيم
الحمد لله الذى خلقنا فلم يلد ولم يولد الهنا
ليس له سبحانه بداية ولا له حد ولا نهاية</incipit>
                     <explicit xml:lang="ar">
                        <locus target="#7r">-7r</locus>وأله وصحبه الأخيار من المهاجرين والأنصار</explicit>
                     <note/>
                     <note/>
                  </msItem>
                  <msItem xml:id="ms_i4">
                     <locus from="7r" to="9v">7r-9v</locus>
                     <textLang xml:lang="ar">Arabic</textLang>
                     <title ref="LIT1514IHA"/>
                     <incipit xml:lang="ar">
                        <locus target="#7r">-7r</locus>بسم الله الرحمن الرحيم 
الحمد لله على ما الهما ومن من تعليمه وفهما
ثم صلاة الله ذي الجلال على النبي المصطفى والأل</incipit>
                     <explicit xml:lang="ar">
                        <locus target="#9v">-9v</locus>نظمته في عدد المختار وزادة الخمسية أي أنوار
تمت وبالخير عمت</explicit>
                     <note/>
                     <note/>
                  </msItem>
