               <msContents>
                  <summary>First and last pages are missing in the microfilm; some pages are reproduced more times.</summary>
                  <msItem xml:id="ms_i0">
                     <locus from="1v" to="3r">1v-3r</locus>
                     <textLang xml:lang="ar">Arabic</textLang>
                     <title ref="LIT4400IHA"/>
                     <incipit xml:lang="ar">
                        <locus target="#1v">-1v</locus>ووديعتي أجلست عليك يا رسول الله عليك اليك أمر الأخرة في دار الأوفى</incipit>
                     <explicit xml:lang="ar">
                        <locus target="#3r">-3r</locus>جعلنا غريق قى دين الءسلام في دار السلام ومن تغسن؟ | ومن يموت متهللا</explicit>
                     <note>First pages containing the text are missing in the microfilm.</note>
                     <note/>
                  </msItem>
                  <msItem xml:id="ms_i1">
                     <locus from="3v" to="8r">3v-8r</locus>
                     <textLang xml:lang="ar">Arabic</textLang>
                     <title ref="LIT4401IHA"/>
                     <incipit xml:lang="ar">
                        <locus target="#3v">-3v</locus>نحمد الله البارى القدوس الغفار لنعمة لا نخص وجليل ... لنعرمة | وصل صلاتك من حين حضرتك ما حن مشتاقنا لساكن الروضة</incipit>
                     <explicit xml:lang="ar">
                        <locus target="#8r">-8r</locus>سلم عليه بأله ما امطر غيشنا من جهة الحدانى بدوام لسعة | نسأل الله الكريم باسمائه العظيم بلوغ مقصدنا من جميع النعمة </explicit>
                     <note/>
                     <note/>
                  </msItem>
                  <msItem xml:id="ms_i2">
                     <locus from="8v" to="14v">8v-14v</locus>
                     <textLang xml:lang="ar">Arabic</textLang>
                     <title ref="LIT4402IHA"/>
                     <incipit xml:lang="ar">
                        <locus target="#8v">-8v</locus>شمس طلع من بين الكرام انار الوجود وكل الظلام | يا اهل الوجد حرس الفؤاد لجوالك من بين الكرام</incipit>
                     <explicit xml:lang="ar">
                        <locus target="#14v">-14v</locus>نسأل الله البرا الرحيم وقت الأجل في حسن الختام</explicit>
                     <note/>
                     <note/>
                  </msItem>
                  <msItem xml:id="ms_i3">
                     <locus from="14v" to="20r">14v-20r</locus>
                     <textLang xml:lang="ar">Arabic</textLang>
                     <title ref="LIT4403IHA"/>
                     <incipit xml:lang="ar">
                        <locus target="#15r">-15r</locus>الحمد لله على نعمائه بخير المرسلين سيف القتلاء | كؤس المرسلين راحة المحبين احمد نور المبين اسم الفضلاء</incipit>
                     <explicit xml:lang="ar">
                        <locus target="#20r">-20r</locus>نسأل مولانا البر المنعم الكريم الوهاب نعمة البقاء | الرؤف الرحيم العفو الحليم نسأله الا احسان بفضل اللقاء </explicit>
                     <note/>
                     <note/>
                  </msItem>
                  <msItem xml:id="ms_i4">
                     <locus from="21r" to="36v">21r-36v</locus>
                     <textLang xml:lang="am">Amharic</textLang>
                     <textLang xml:lang="ar">Arabic</textLang>
                     <title ref="LIT4405IHA"/>
                     <incipit xml:lang="ar">
                        <locus target="#21r">-21r</locus>الله اندنو هلت يلبت | اباتم يلوم يلوم انات</incipit>
                     <explicit xml:lang="ar">
                        <locus target="#36v">-36v</locus>احسن ختامنا وقت يوم الأمد | بحرمة النبى وبنور احمد اللهم صل على محمد </explicit>
                     <note/>
                     <note/>
                  </msItem>
                  <msItem xml:id="ms_i5">
                     <locus from="37r" to="37r">37r-37r</locus>
                     <textLang xml:lang="ar">Arabic</textLang>
                     <title ref="LIT4406IHA"/>
                     <incipit xml:lang="ar">
                        <locus target="#37r">-37r</locus>باسمك البر العفو الوالى والرءوف المتعالى وبالغني ثم معطنا | بالمنتقم القسط المانع وبالمالك والضال المنافع </incipit>
                     <explicit xml:lang="ar"/>
                     <note>Ending lacking in the microfilm.</note>
                     <note/>
                  </msItem>
