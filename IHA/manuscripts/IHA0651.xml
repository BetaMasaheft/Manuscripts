                  <msItem xml:id="ms_i0">
                     <locus from="1v" to="2r">1v-2r</locus>
                     <textLang xml:lang="ar">Arabic</textLang>
                     <title ref="LIT1455IHA"/>
                     <incipit xml:lang="ar">
                        <locus target="#1v">-1v</locus>فائدة عن رسول الله صلى الله عليه وسلم انه قال من فاته صلاة فى عمره ولم يحصل فليقم فى اخر جمعة من رمضان ويصلى اربع ركعات بفاتحة الكتاب وسورة القدر خمسة عشر مرة</incipit>
                     <explicit xml:lang="ar">
                        <locus target="#2r">-2r</locus>اللهم اغفر للمؤمنين والمؤمنات والمسلمين والمسلمات وتابع بيننا وبينهم بالخيرات رب اغفر وارحم [وانت] خير الراحمين وصلى الله على سيدنا محمد وعلى ءاله وصحبه وسلم تسليما كثيرا امين اه</explicit>
                     <note>An extract.</note>
                     <note/>
                  </msItem>
               </msContents>
