               <msContents>
                  <summary/>
                  <msItem xml:id="ms_i0">
                     <locus from="1r" to="6r">1r-6r</locus>
                     <textLang xml:lang="ar">Arabic</textLang>
                     <textLang xml:lang="x-oh">Old Harari</textLang>
                     <title ref="LIT0001IHA" type="acephalous"/>
                     <incipit xml:lang="ar">
                        <locus target="#1r">-1r</locus>مهدن بانثت يقمس صبر مهدنّ بمسكين يقمس عدل زليلا \ نجاشاخ من يوش اساخ جردان ماخ زيز لمن يوش ورع \ زليلا عالماخ من يوش اساخ </incipit>
                     <explicit xml:lang="ar">
                        <locus target="#5v-6r">-5v-6r</locus>قد \ رإيب أطممتن الله اي باي أحدت نكد بخكرادوشا \\ ابوش من ناش تلم تتحيركاخوا جمع مخلوق امل حرك ارزقبا \ ذاخ قد رإيب اكممتن الله إي باي</explicit>
                     <note/>
                     <note/>
                  </msItem>
                  <msItem xml:id="ms_i1">
                     <locus from="6r" to="10r">6r-10r</locus>
                     <textLang xml:lang="ar">Arabic</textLang>
                     <textLang xml:lang="x-oh">Old Harari</textLang>
                     <title ref="LIT0669IHA"/>
                     <incipit xml:lang="ar">
                        <locus target="#6r">-6r</locus>الهم صلى وسلم على سيدنا محمد \ وعلى ال محمد جنة ما يرخبوا ام اساتخ  يسلطبوا الله \ خاذوا اكدرتم ذا الله لال اناخ بالوت برخسن بإ \ نستين بجافان بولبان</incipit>
                     <explicit xml:lang="ar">
                        <locus target="#10v">-10v</locus>اللهم صلى على محمد اتبزحوت زكزء هدية \ هرعة سق سن بالوت ورش بي تختر بالوت في سبيل الله جهاد \ اونوت جمع مخلوق ل خير خشوت</explicit>
                     <note/>
                     <note/>
                  </msItem>
                  <msItem xml:id="ms_i2">
                     <locus from="10r" to="15r">10r-15r</locus>
                     <textLang xml:lang="ar">Arabic</textLang>
                     <textLang xml:lang="x-oh">Old Harari</textLang>
                     <title ref="LIT0670IHA" type="acephalous"/>
                     <incipit xml:lang="ar">
                        <locus target="#10r-v">-10r-v</locus>الهم صلى وسلم على سيدنا \ محمد وعلى ال محمد اول كر اسلام ب زادوا فرض اخ مستٍ \\ حمست اول كرشهادة صلوة زكوة صومن
</incipit>
                     <explicit xml:lang="ar">
                        <locus target="#15r">-15r</locus>هرعة \ اسلام خنوت عاقل خنوت بالع خنوت زنية ارتات \ ب نية اوش زنية حكم شئشت سن ارتاي فرض ارتاي \ ب صفة ذوا اشوت زئنة ارتاي كعت ميااخ كف كالـ \ كللتدابل ب نية اشوت والله اعلم تمت الفرائض \ بكلام الحبش</explicit>
                     <note/>
                     <note/>
                  </msItem>
                  <msItem xml:id="ms_i3">
                     <locus from="15v" to="18v">15v-18v</locus>
                     <textLang xml:lang="ar">Arabic</textLang>
                     <textLang xml:lang="x-oh">Old Harari</textLang>
                     <title ref="LIT0839IHA" type="apodous"/>
                     <incipit xml:lang="ar">
                        <locus target="#15v">-15v</locus>بسملة, وَلَا حَوْلَ وَلَا قُوَةَ اِلَّا بِاللَّهِ الْعَلِيّ العَظِيمِ بِسْمِ اللَّه العزِيز الحَكِيمَِ بِسْمِ اللَّه الفَتَّاحِ العَلِيم</incipit>
                     <explicit xml:lang="ar">
                        <locus target="#18v">-18v</locus>واحترم واعف عمن زلّ وهفا يا رحيما تجاوز وعفا اللهم صل وسلم وبارك على نبيك وصفيّك وحافظ </explicit>
                     <note/>
                     <note/>
                  </msItem>
