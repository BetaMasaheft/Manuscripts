                        <msItem xml:id="ms_i1">
                            <title ref="LIT7832PPrayer"/>
                            <textLang mainLang="gez"/>
                            <incipit xml:lang="gez">በስመ<supplied reason="omitted"
                                    resp="bm:GrebTiss1935Codices">፡</supplied> አብ<supplied
                                    reason="omitted" resp="bm:GrebTiss1935Codices">፡</supplied>
                                <gap reason="ellipsis" resp="bm:GrebTiss1935Codices"/> ጸሎት፡ በእንተ፡
                                ሕማመ፡ ዓይነ፡ ጽላ፡ ወዓይነ፡ ወርቅ፡ ለሚርጀጀን፡ ወአላጅን፡ ወሉጅን፡</incipit>
                            <explicit xml:lang="gez">በዝ<supplied reason="omitted"
                                    resp="bm:GrebTiss1935Codices">፡</supplied> ቃል<choice>
                                    <sic>በ፡</sic>
                                    <corr>ከ፡</corr>
                                </choice> አድኅኖ፡ እምዓይነ፡ ጽላ፡ ወዓይነ፡ ወርቅ፡ ሊተ፡ ለገብርከ፡ ብሩ፡</explicit>
                        </msItem>
                        <msItem xml:id="ms_i2">
                            <title ref="LIT7833PPrayer"/>
                            <textLang mainLang="gez" otherLangs="ar"/>
                            <incipit xml:lang="gez">በስመ<supplied reason="omitted"
                                    resp="bm:GrebTiss1935Codices">፡</supplied> አብ<supplied
                                    reason="omitted" resp="bm:GrebTiss1935Codices">፡</supplied>
                                <gap reason="ellipsis" resp="bm:GrebTiss1935Codices"/> አኑዜ<supplied
                                    reason="omitted" resp="ESh">፡</supplied>በላሂ፡ ራኅመን፡ ረኂም፡ ኢያቁለ፡
                                አአዚሁን፡ ራኅመን፡ ኢያቁለ፡ አአዚሁን፡</incipit>
                            <explicit xml:lang="gez">ወርኒዑል፡ መለኪዑን፡ መመዓቱን፡ <gap reason="ellipsis"
                                    resp="bm:GrebTiss1935Codices"/> በቃለ፡ አረቢ፡ አድኅኖ፡ እምዓይነ፡ ጽላ፡ ወዓይነ፡
                                ወርቅ፡ ሊተ፡ ለገብርከ፡ ብሩ፡ </explicit>
                        </msItem>
