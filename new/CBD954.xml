                        <handDesc>
                            <handNote xml:id="h1" script="Ethiopic">
                                <seg type="script">Early twentieth-century script.</seg>
                                <seg type="ink">Black, red.</seg>
                                <seg type="rubrication">Divine names, incipits, the words <foreign
                                        xml:lang="gez">አንቲ፡</foreign> and <foreign xml:lang="gez"
                                        >ተፈሥሒ፡፡</foreign> as well as elements of punctuation marks
                                    and Ethiopic numerals.</seg>
                                <desc>Careful; small round letters.</desc>
                            </handNote>
                        </handDesc>
                        <decoDesc>
                            <decoNote xml:id="d1" type="Headband">
                                <locus target="#1r #8v #16r #24r #34v #42v #49r #58v #70r #78v #84v 
                                    #97v #110v #113v #120r #127r #140v #148r"/>
                                <desc>Elaborate yellow, red, green, blue and violet horizontal
                                    ornamental bands (ḥarags), featuring interlaces, crosses, wings
                                    and floral motifs.</desc>
                            </decoNote>
                        </decoDesc>
                        <additions>
                            <list>
                                <item xml:id="a1">
                                    <locus target="#164v"/>
                                    <desc type="ScribalNoteCommissioning">A scribal note on the
                                        commissioning of the manuscript made by <persName role="donor"
                                            ref="PRS15528GabraSellase"><roleName type="title"
                                                >ʾalaqā</roleName> Gabra Śǝllāse</persName> in <date
                                            calendar="ethiopian" notBefore-custom="1906" notAfter-custom="1907"
                                            when="1889" evidence="internal">፲ወ፰፻፺ወ፱ ዓመት፡
                                            ምሕረት፡</date>.</desc>
                                    <q xml:lang="gez"><hi rend="rubric">ለዝንቱ፡ መጽሐፍ፡ ዘአጽሐፎ፡ አለቃ፡ ገብረ፡
                                            ሥላሴ፡</hi> ዘውእቱ፡ ጸሐፌ፡ ትእዛዝ። በ፲ወ፰፻፺ወ፱ ዓመተ፡ መሕረት ፡ ስብሐት፡
                                        ለእግዚአብሔር፡ ለዘአብጽሐነ፡ እስከ፡ ዛቲ፡ ሰዓት። ወለወላዲቱ፡ <hi rend="rubric"
                                            >ማርያም፡</hi> ድንግል፡ ቅድስት። ወላዕሌነ፡ ይኩን፡ ሣህል፡ ወምሕረት። ለዓለመ፡
                                        ዓለም፡ አሜን።</q>
                                </item>

