                  <summary/>
            
                  <msItem xml:id="ms_i1">
                   <title></title>
                     <note>According to the catalogue description in <bibl><ptr
                        target="bm:GrebTiss1935Codices"/>
                        <citedRange unit="page">697</citedRange></bibl>, this prayer ends as in  <ref type="mss" corresp="BAVet220#ms_i4"/>.</note>
                     <incipit xml:lang="gez">በስመ፡ አብ፡ <gap reason="ellipsis"
                        resp="bm:GrebTiss1935Codices"/>
                        ጸሎት<supplied reason="omitted">፡</supplied>
                        በእንተ፡ ሕማመ፡ ዓይነ፡ ጥላ፡ ወዓይነ፡ <choice
                           resp="bm:GrebTiss1935Codices">
                           <sic>ት</sic>
                           <corr>ተ</corr>
                        </choice>ጻራፊ፡ ወዓይነ፡ አገርጋር፡ ወዓይነ፡ ቡዳ፡ ወዓይነ፡ <surplus>ወ</surplus>ጠቢብ<supplied reason="omitted">፡</supplied>
                        ወዐይነ፡ <choice
                           resp="bm:GrebTiss1935Codices">
                           <sic>ቁ</sic>
                           <corr>ቍ</corr>
                        </choice>ረኛ፡ ወዓይነ፡ አ<choice
                           resp="bm:GrebTiss1935Codices">
                           <sic>ጋ</sic>
                           <corr>ገ</corr>
                        </choice>ርጋር፡ ወዓይነ፡ ባለ<supplied reason="omitted">፡</supplied> 
                        ጋራ፡ ወዓይነ፡ ነሃቢ፡ <gap reason="ellipsis"
                           resp="bm:GrebTiss1935Codices"/>
                        ቃለ፡ እግዚአብሔር፡ ይመትር፡ ነደ፡ እሳት፡ 
                     </incipit>
                     </msItem>
              
                  <msItem xml:id="ms_i2">
                     <title ref="LIT5888AsmatPrayer">Magic prayer against an eye disease, Zār, pleurisy, and other evil spirits and illnesses</title>
                     
                     <incipit xml:lang="gez">በስመ፡ አብ፡ <gap reason="ellipsis"
                        resp="bm:GrebTiss1935Codices"/> ጸሎት፡ በእንተ። ሕማመ፡ ለፌራ<supplied reason="omitted">፡</supplied>
                        ወለንዳድ፡ ሕማመ፡ ዓይነ፡ ወርቅ፡ <gap reason="ellipsis"
                           resp="bm:GrebTiss1935Codices"/>
                     በሎፍሃም፡ ሰምከ፡</incipit>
                     <explicit xml:lang="gez">ዛር፡ ውላጅ፡ እሰር፡ ለአይነት፡ ወለፍልፀት፡ ወከንትር፡</explicit>
                  </msItem>
                  
